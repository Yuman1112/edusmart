@page
@model SecureSmartTuitionSystem.Areas.Identity.Pages.Account.ResetPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reset Password";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/reset-password.css"
          asp-append-version="true" />
}

<div class="login-page forgot-page reset-page">
    <div class="login-card forgot-card reset-card">

        <a class="login-logo-link"
           asp-area=""
           asp-controller="Home"
           asp-action="Index"
           aria-label="Return to home page">
            <img src="~/images/logo.png"
                 asp-append-version="true"
                 alt="EduSmart Logo"
                 class="login-logo" />
        </a>

        <div class="login-heading">
            <h1>Reset Your Password</h1>
            <p>
                Create a new password to secure your EduSmart account.
            </p>
        </div>

        @if (!Model.LinkValid)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-circle me-2"
                   aria-hidden="true"></i>
                This password reset link is invalid or has expired.
                Please request a new link.
            </div>

            <a asp-page="./ForgotPassword"
               class="login-button text-decoration-none">
                Request New Reset Link
            </a>
        }
        else
        {
            <form method="post"
                  class="login-form"
                  asp-antiforgery="true">

                <input type="hidden" asp-for="Account" />
                <input type="hidden" asp-for="Code" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger login-errors">
                </div>

                <!-- New Password -->
                <div class="login-field">

                    <label asp-for="Password" class="form-label">
                        New Password
                    </label>

                    <div class="login-input-wrapper login-password-wrapper">

                        <i class="bi bi-lock" aria-hidden="true"></i>

                        <input asp-for="Password"
                               id="newPassword"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Enter new password"
                               aria-describedby="passwordChecklist" />

                        <button type="button"
                                class="password-toggle"
                                data-target="newPassword"
                                aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger"></span>

                    <!-- Real-time Password Requirements -->
                    <div id="passwordChecklist"
                         class="reset-password-rules"
                         aria-label="Password requirements">

                        <div id="ruleLength" class="reset-password-rule text-muted">
                            ☐ At least 8 characters
                        </div>

                        <div id="ruleUppercase" class="reset-password-rule text-muted">
                            ☐ At least one uppercase letter
                        </div>

                        <div id="ruleLowercase" class="reset-password-rule text-muted">
                            ☐ At least one lowercase letter
                        </div>

                        <div id="ruleNumber" class="reset-password-rule text-muted">
                            ☐ At least one number
                        </div>

                        <div id="ruleSpecial" class="reset-password-rule text-muted">
                            ☐ At least one special character
                        </div>

                    </div>
                </div>

                <!-- Confirm New Password -->
                <div class="login-field">

                    <label asp-for="ConfirmPassword" class="form-label">
                        Confirm New Password
                    </label>

                    <div class="login-input-wrapper login-password-wrapper">

                        <i class="bi bi-lock-fill" aria-hidden="true"></i>

                        <input asp-for="ConfirmPassword"
                               id="confirmPassword"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Confirm new password"
                               aria-describedby="passwordMatchMessage" />

                        <button type="button"
                                class="password-toggle"
                                data-target="confirmPassword"
                                aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
      class="text-danger reset-confirm-server-error"></span>

<div id="passwordMatchMessage"
     class="reset-password-match"
     role="status"
     aria-live="polite">
</div>

                </div>

                <button type="submit" class="login-button">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    Reset Password
                </button>

            </form>
        }

        <a asp-page="./Login" class="forgot-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back to Sign In
        </a>

        <div class="forgot-footer">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            Secure account recovery
        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script nonce="@HttpContext.Items["CspNonce"]">

        (function () {
            "use strict";

            const passwordInput =
                document.getElementById("newPassword");

            const confirmPasswordInput =
                document.getElementById("confirmPassword");

            const passwordMatchMessage =
                document.getElementById("passwordMatchMessage");

            if (!passwordInput || !confirmPasswordInput) {
                return;
            }

            const rules = [
                {
                    id: "ruleLength",
                    label: "At least 8 characters",
                    test: value => value.length >= 8
                },
                {
                    id: "ruleUppercase",
                    label: "At least one uppercase letter",
                    test: value => /[A-Z]/.test(value)
                },
                {
                    id: "ruleLowercase",
                    label: "At least one lowercase letter",
                    test: value => /[a-z]/.test(value)
                },
                {
                    id: "ruleNumber",
                    label: "At least one number",
                    test: value => /[0-9]/.test(value)
                },
                {
                    id: "ruleSpecial",
                    label: "At least one special character",
                    test: value => /[^A-Za-z0-9]/.test(value)
                }
            ];

            function validatePassword() {

                const password = passwordInput.value;

                rules.forEach(rule => {

                    const element =
                        document.getElementById(rule.id);

                    if (!element) return;

                    const valid = rule.test(password);

                    element.textContent =
                        (valid ? "✓ " : "☐ ") + rule.label;

                    element.classList.toggle("text-success", valid);
                    element.classList.toggle("text-muted", !valid);
                });
            }

            function validatePasswordMatch() {

                const password = passwordInput.value;
                const confirmation = confirmPasswordInput.value;

                if (!passwordMatchMessage) return;

                passwordMatchMessage.classList.remove(
                    "text-success",
                    "text-danger"
                );

                if (confirmation.length === 0) {
                    passwordMatchMessage.textContent = "";
                    return;
                }

                if (password === confirmation) {
                    passwordMatchMessage.textContent =
                        "✓ Passwords match";

                    passwordMatchMessage.classList.add(
                        "text-success"
                    );
                } else {
                    passwordMatchMessage.textContent =
                        "✕ Passwords do not match";

                    passwordMatchMessage.classList.add(
                        "text-danger"
                    );
                }
            }

            passwordInput.addEventListener("input", () => {
                validatePassword();
                validatePasswordMatch();
            });

            confirmPasswordInput.addEventListener(
                "input", () => {
                    validatePasswordMatch();
                }
            );

            validatePassword();
            validatePasswordMatch();

            // Show / Hide Password
            document.querySelectorAll(".password-toggle")
                .forEach(button => {

                    button.addEventListener("click", () => {

                        const input = document.getElementById(
                            button.getAttribute("data-target")
                        );

                        if (!input) return;

                        const icon = button.querySelector("i");

                        const show = input.type === "password";

                        input.type = show ? "text" : "password";

                        if (icon) {
                            icon.classList.toggle("bi-eye", !show);
                            icon.classList.toggle("bi-eye-slash", show);
                        }

                        button.setAttribute(
                            "aria-label",
                            show ? "Hide password" : "Show password"
                        );
                    });
                });

        })();

    </script>
}
