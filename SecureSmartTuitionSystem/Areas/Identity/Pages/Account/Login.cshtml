@page "/Identity/Account/Login"
@model SecureSmartTuitionSystem.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
}

<div class="login-page">
    <div class="login-card">

        <a class="login-logo-link"
           asp-controller="Home"
           asp-action="Index"
           aria-label="Return to home page">

            <img src="~/images/logo.png"
                 asp-append-version="true"
                 alt="EduSmart Logo"
                 class="login-logo" />
        </a>

        <div class="login-heading">
            <h1>Welcome Back</h1>

            <p>
                Log in to continue to your EduSmart dashboard.
            </p>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success"
                 role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @successMessage
            </div>
        }

        <form method="post"
              class="login-form">

            <input type="hidden"
                   asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger login-errors">
            </div>

            <div class="login-field">
                <label asp-for="Input.UserId"
                       class="form-label">
                    User ID or Email
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-person"></i>

                    <input asp-for="Input.UserId"
                           class="form-control"
                           autocomplete="username"
                           placeholder="Enter your User ID or email" />
                </div>

                <span asp-validation-for="Input.UserId"
                      class="text-danger">
                </span>
            </div>


            <div class="login-field">
                <label asp-for="Input.Password"
                       class="form-label">
                    Password
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-lock"></i>

                    <input asp-for="Input.Password"
                           id="loginPassword"
                           class="form-control pe-5"
                           autocomplete="current-password"
                           placeholder="Enter your password" />

                    <button type="button"
                            class="btn password-toggle"
                            data-target="loginPassword"
                            aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="login-button">

                <i class="bi bi-box-arrow-in-right"></i>
                Login
            </button>
        </form>

        <div class="login-register-link">
            <span>Do not have an account?</span>

            <a asp-area="Identity"
               asp-page="/Account/Register">
                Register here
            </a>
        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordToggleButtons =
            document.querySelectorAll(".password-toggle");

        passwordToggleButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const targetId =
                            button.getAttribute("data-target");

                        const input =
                            document.getElementById(targetId);

                        if (!input) {
                            return;
                        }

                        const icon =
                            button.querySelector("i");

                        if (input.type === "password") {

                            input.type = "text";

                            icon.classList.remove("bi-eye");
                            icon.classList.add("bi-eye-slash");

                            button.setAttribute(
                                "aria-label",
                                "Hide password");
                        }
                        else {

                            input.type = "password";

                            icon.classList.remove("bi-eye-slash");
                            icon.classList.add("bi-eye");

                            button.setAttribute(
                                "aria-label",
                                "Show password");
                        }
                    });
            });
    </script>
}