@page "/Identity/Account/Login"
@model SecureSmartTuitionSystem.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
}

<div class="login-page">
    <div class="login-card">

        <a class="login-logo-link"
           asp-controller="Home"
           asp-action="Index"
           aria-label="Return to home page">

            <img src="~/images/logo.png"
                 asp-append-version="true"
                 alt="EduSmart Logo"
                 class="login-logo" />
        </a>

        <div class="login-heading">
            <h1>Welcome Back</h1>

            <p>
                Log in to continue to your EduSmart dashboard.
            </p>
        </div>

        <form method="post"
              class="login-form">

            <input type="hidden"
                   asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger login-errors">
            </div>

            <div class="login-field">
                <label asp-for="Input.UserId"
                       class="form-label">
                    User ID or Email
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-person"></i>

                    <input asp-for="Input.UserId"
                           class="form-control"
                           autocomplete="username"
                           placeholder="Enter your User ID or email" />
                </div>

                <span asp-validation-for="Input.UserId"
                      class="text-danger">
                </span>
            </div>

            <div class="login-field">
                <label asp-for="Input.Password"
                       class="form-label">
                    Password
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-lock"></i>

                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Enter your password" />
                </div>

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="login-button">

                <i class="bi bi-box-arrow-in-right"></i>
                Login
            </button>
        </form>

        <div class="login-register-link">
            <span>Do not have an account?</span>

            <a asp-area="Identity"
               asp-page="/Account/Register">
                Register here
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}