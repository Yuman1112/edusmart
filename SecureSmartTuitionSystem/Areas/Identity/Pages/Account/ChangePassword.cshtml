@page
@model SecureSmartTuitionSystem.Areas.Identity.Pages.Account.ChangePasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Change Password";
    Layout = "/Views/Shared/_Layout.cshtml";
    var rules = Model.PasswordRules;
    var lengthMessage = $"The new password must be between {rules.RequiredLength} and 100 characters.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-setup.css" asp-append-version="true" />
}

<div class="row justify-content-center py-5 account-setup-page">
    <div class="col-md-6 col-lg-5">
        <div class="enrollment-card">
            <h1 class="mb-3">Change Password</h1>
            <p class="text-muted mb-4">Update the password for your EduSmart account.</p>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-success" role="status">@Model.StatusMessage</div>
            }

            <form id="change-password-form" method="post" asp-antiforgery="true">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 validation-summary-no-bullets" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.OldPassword" class="form-label">Current Password</label>
                    <div class="position-relative">
                        <input asp-for="Input.OldPassword" class="form-control password-toggle-input"
                               autocomplete="current-password" aria-describedby="current-password-error" />
                        <button type="button" class="btn password-toggle" hidden
                                aria-controls="Input_OldPassword" aria-label="Show current password"
                                data-password-label="current password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.OldPassword" id="current-password-error"
                          class="text-danger small" aria-live="polite"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label">New Password</label>
                    <div class="position-relative">
                        <input asp-for="Input.NewPassword" class="form-control password-toggle-input"
                               autocomplete="new-password" aria-describedby="new-password-error password-checklist"
                               data-val-length="@lengthMessage" data-val-length-min="@rules.RequiredLength"
                               data-val-differentpassword="@SecureSmartTuitionSystem.Areas.Identity.Pages.Account.ChangePasswordModel.DifferentPasswordMessage" />
                        <button type="button" class="btn password-toggle" hidden
                                aria-controls="Input_NewPassword" aria-label="Show new password"
                                data-password-label="new password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" id="new-password-error"
                          class="text-danger small" aria-live="polite"></span>

                    <ul id="password-checklist" class="list-unstyled mt-2 mb-0 small text-muted">
                        <li data-password-rule="length" data-minimum="@rules.RequiredLength">☐ At least @rules.RequiredLength characters</li>
                        @if (rules.RequireUppercase)
                        {
                            <li data-password-rule="uppercase">☐ At least one uppercase letter</li>
                        }
                        @if (rules.RequireLowercase)
                        {
                            <li data-password-rule="lowercase">☐ At least one lowercase letter</li>
                        }
                        @if (rules.RequireDigit)
                        {
                            <li data-password-rule="digit">☐ At least one number</li>
                        }
                        @if (rules.RequireNonAlphanumeric)
                        {
                            <li data-password-rule="special">☐ At least one special character</li>
                        }
                        @if (rules.RequiredUniqueChars > 1)
                        {
                            <li data-password-rule="unique" data-minimum="@rules.RequiredUniqueChars">☐ At least @rules.RequiredUniqueChars distinct characters</li>
                        }
                    </ul>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm New Password</label>
                    <div class="position-relative">
                        <input asp-for="Input.ConfirmPassword" class="form-control password-toggle-input"
                               autocomplete="new-password"
                               aria-describedby="confirm-password-error password-match-message" />
                        <button type="button" class="btn password-toggle" hidden
                                aria-controls="Input_ConfirmPassword" aria-label="Show password confirmation"
                                data-password-label="password confirmation">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" id="confirm-password-error"
                          class="text-danger small" aria-live="polite"></span>
                    <div id="password-match-message" class="small mt-2" aria-live="polite" hidden></div>
                </div>

                <button type="submit" class="primary-button w-100">Update Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@HttpContext.Items["CspNonce"]">
        (() => {
            const form = document.getElementById("change-password-form");
            const current = form.elements.namedItem("Input.OldPassword");
            const password = form.elements.namedItem("Input.NewPassword");
            const confirm = form.elements.namedItem("Input.ConfirmPassword");
            const matchMessage = document.getElementById("password-match-message");
            const checklist = Array.from(form.querySelectorAll("[data-password-rule]"), item => ({
                item,
                label: item.textContent.trim().slice(2)
            }));
            const checks = {
                length: (value, minimum) => value.length >= minimum,
                uppercase: value => /[A-Z]/.test(value),
                lowercase: value => /[a-z]/.test(value),
                digit: value => /[0-9]/.test(value),
                special: value => /[^A-Za-z0-9]/.test(value),
                unique: (value, minimum) => new Set(value.split("")).size >= minimum
            };

            const validation = window.jQuery?.validator;
            if (validation?.unobtrusive) {
                validation.addMethod("differentpassword", function (value, element) {
                    return this.optional(element) || value !== current.value;
                });
                validation.unobtrusive.adapters.addBool("differentpassword");
            }

            function updateChecklist() {
                checklist.forEach(({ item, label }) => {
                    const valid = checks[item.dataset.passwordRule](password.value, Number(item.dataset.minimum));
                    item.textContent = (valid ? "✓ " : "☐ ") + label;
                    item.classList.toggle("text-success", valid);
                });
            }

            function updateMatch() {
                const matches = confirm.value.length > 0 && confirm.value === password.value;
                const hasValidator = Boolean(window.jQuery?.(form).data("validator"));
                if (hasValidator && confirm.value.length > 0) {
                    window.jQuery(confirm).valid();
                }

                const showMismatch = !hasValidator && confirm.value.length > 0 && !matches;
                matchMessage.hidden = !matches && !showMismatch;
                matchMessage.textContent = matches ? "✓ Passwords match" :
                    showMismatch ? "The passwords do not match." : "";
                matchMessage.classList.toggle("text-success", matches);
                matchMessage.classList.toggle("text-danger", showMismatch);
            }

            function revalidateNewPassword() {
                if (window.jQuery?.(form).data("validator") &&
                    password.value.length > 0 &&
                    (password.value === current.value || password.classList.contains("input-validation-error"))) {
                    window.jQuery(password).valid();
                }
            }

            current.addEventListener("input", revalidateNewPassword);
            password.addEventListener("input", () => {
                updateChecklist();
                revalidateNewPassword();
                updateMatch();
            });
            confirm.addEventListener("input", updateMatch);
            window.addEventListener("pageshow", updateChecklist);

            form.querySelectorAll(".password-toggle").forEach(button => {
                const input = document.getElementById(button.getAttribute("aria-controls"));
                const icon = button.querySelector("i");
                button.hidden = false;
                button.addEventListener("click", () => {
                    const show = input.type === "password";
                    input.type = show ? "text" : "password";
                    icon.classList.toggle("bi-eye", !show);
                    icon.classList.toggle("bi-eye-slash", show);
                    button.setAttribute("aria-label", (show ? "Hide " : "Show ") + button.dataset.passwordLabel);
                });
            });
        })();
    </script>
}
