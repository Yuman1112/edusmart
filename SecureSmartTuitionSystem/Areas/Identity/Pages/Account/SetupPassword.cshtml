@page
@model SecureSmartTuitionSystem.Areas.Identity.Pages.Account.SetupPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Set Up Account";
    Layout = "/Views/Shared/_Layout.cshtml";
}


<style>
    /* Hide browser's built-in password reveal icon */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }

    /* Show / Hide Password button */
    .password-toggle {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #60758f;
        padding: 6px 8px;
        z-index: 5;
    }

    .password-toggle:hover {
        color: #008c99;
    }

    .password-toggle:focus {
        box-shadow: none;
    }

    /* Password fields:
           Keep red validation border but hide warning icon */
    .password-toggle-input.is-invalid,
    .password-toggle-input.input-validation-error,
    .password-toggle-input:invalid {
        background-image: none !important;
        padding-right: 3rem !important;
    }
</style>

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">

        <div class="enrollment-card">

            <h1 class="mb-3">
                Set Up Your Account
            </h1>

            <p class="text-muted mb-4">
                Create a password for your EduSmart account.
            </p>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 validation-summary-no-bullets">
                </div>

                <input asp-for="Input.UserId"
                       type="hidden" />

                <input asp-for="Input.Token"
                       type="hidden" />

                <div class="mb-3">

                    <label asp-for="Input.Password"
                           class="form-label">
                        New Password
                    </label>

                    <div class="position-relative">

                        <input asp-for="Input.Password"
                               class="form-control pe-5 password-toggle-input"
                               autocomplete="new-password"
                               id="newPassword" />

                        <button type="button"
                                class="btn password-toggle"
                                data-target="newPassword"
                                aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                    <div id="passwordChecklist"
                         class="mt-2 small text-muted">

                        <div id="ruleLength">
                            ☐ At least 8 characters
                        </div>

                        <div id="ruleUppercase">
                            ☐ At least one uppercase letter
                        </div>

                        <div id="ruleLowercase">
                            ☐ At least one lowercase letter
                        </div>

                        <div id="ruleNumber">
                            ☐ At least one number
                        </div>

                        <div id="ruleSpecial">
                            ☐ At least one special character
                        </div>

                    </div>

                </div>

                <div class="mb-4">

                    <label asp-for="Input.ConfirmPassword"
                           class="form-label">
                        Confirm Password
                    </label>

                    <div class="position-relative">

                        <input asp-for="Input.ConfirmPassword"
                               id="confirmPassword"
                               class="form-control pe-5 password-toggle-input"
                               autocomplete="new-password" />

                        <button type="button"
                                class="btn password-toggle"
                                data-target="confirmPassword"
                                aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <div id="passwordMatchMessage"
                         class="small mt-2">
                    </div>

                </div>

                <button type="submit"
                        class="primary-button w-100">
                    Create Password
                </button>

            </form>

        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script nonce="@HttpContext.Items["CspNonce"]">
        // =====================================================
        // PASSWORD ELEMENTS
        // =====================================================
        const passwordInput =
            document.getElementById("newPassword");

        const confirmPasswordInput =
            document.getElementById("confirmPassword");

        const passwordMatchMessage =
            document.getElementById("passwordMatchMessage");

        const ruleLength =
            document.getElementById("ruleLength");

        const ruleUppercase =
            document.getElementById("ruleUppercase");

        const ruleLowercase =
            document.getElementById("ruleLowercase");

        const ruleNumber =
            document.getElementById("ruleNumber");

        const ruleSpecial =
            document.getElementById("ruleSpecial");

        // =====================================================
        // PASSWORD CHECKLIST
        // =====================================================
        function updateRule(
            element,
            isValid,
            text) {

            if (isValid) {

                element.textContent =
                    "✓ " + text;

                element.classList.remove(
                    "text-muted",
                    "text-danger");

                element.classList.add(
                    "text-success");
            }
            else {

                element.textContent =
                    "☐ " + text;

                element.classList.remove(
                    "text-success",
                    "text-danger");

                element.classList.add(
                    "text-muted");
            }
        }

        function validatePassword() {

            if (!passwordInput) {
                return;
            }

            const password =
                passwordInput.value;

            updateRule(
                ruleLength,
                password.length >= 8,
                "At least 8 characters");

            updateRule(
                ruleUppercase,
                /[A-Z]/.test(password),
                "At least one uppercase letter");

            updateRule(
                ruleLowercase,
                /[a-z]/.test(password),
                "At least one lowercase letter");

            updateRule(
                ruleNumber,
                /[0-9]/.test(password),
                "At least one number");

            updateRule(
                ruleSpecial,
                /[^A-Za-z0-9]/.test(password),
                "At least one special character");
        }

        // =====================================================
        // CONFIRM PASSWORD LIVE VALIDATION
        // =====================================================
        function validatePasswordMatch() {

            if (!passwordInput ||
                !confirmPasswordInput ||
                !passwordMatchMessage) {
                return;
            }

            const password =
                passwordInput.value;

            const confirmPassword =
                confirmPasswordInput.value;

            // User has not entered confirm password yet
            if (confirmPassword.length === 0) {

                passwordMatchMessage.textContent = "";

                passwordMatchMessage.classList.remove(
                    "text-success",
                    "text-danger");

                return;
            }

            // Passwords match
            if (password === confirmPassword) {

                passwordMatchMessage.textContent =
                    "✓ Passwords match";

                passwordMatchMessage.classList.remove(
                    "text-danger");

                passwordMatchMessage.classList.add(
                    "text-success");
            }

            // Passwords do not match
            else {

                passwordMatchMessage.textContent =
                    "✕ Passwords do not match";

                passwordMatchMessage.classList.remove(
                    "text-success");

                passwordMatchMessage.classList.add(
                    "text-danger");
            }
        }

        // =====================================================
        // EVENT LISTENERS
        // =====================================================
        if (passwordInput) {

            passwordInput.addEventListener(
                "input",
                function () {

                    validatePassword();

                    validatePasswordMatch();

                    if (window.jQuery &&
                        confirmPasswordInput &&
                        $(confirmPasswordInput).valid) {

                        $(confirmPasswordInput).valid();
                    }
                });

            validatePassword();
        }

        if (confirmPasswordInput) {

            confirmPasswordInput.addEventListener(
                "input",
                function () {

                    validatePasswordMatch();

                    if (window.jQuery &&
                        $(confirmPasswordInput).valid) {

                        $(confirmPasswordInput).valid();
                    }
                });
        }

        // =====================================================
        // SHOW / HIDE PASSWORD
        // =====================================================

        const passwordToggleButtons =
            document.querySelectorAll(".password-toggle");

        passwordToggleButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const targetId =
                            button.getAttribute("data-target");

                        const input =
                            document.getElementById(targetId);

                        if (!input) {
                            return;
                        }

                        const icon =
                            button.querySelector("i");

                        if (input.type === "password") {

                            input.type = "text";

                            icon.classList.remove("bi-eye");
                            icon.classList.add("bi-eye-slash");

                            button.setAttribute(
                                "aria-label",
                                "Hide password");
                        }
                        else {

                            input.type = "password";

                            icon.classList.remove("bi-eye-slash");
                            icon.classList.add("bi-eye");

                            button.setAttribute(
                                "aria-label",
                                "Show password");
                        }
                    });
            });
    </script>
}
