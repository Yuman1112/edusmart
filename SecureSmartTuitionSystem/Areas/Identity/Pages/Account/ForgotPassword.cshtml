@page
@model SecureSmartTuitionSystem.Areas.Identity.Pages.Account.ForgotPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot Password";
    ViewData["HideNavbar"] = true;
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />
}

<div class="login-page forgot-page reset-password-page">
    <div class="login-card forgot-card reset-password-card">

        <a class="login-logo-link"
           asp-controller="Home"
           asp-action="Index"
           aria-label="Return to home page">

            <img src="~/images/logo.png"
                 asp-append-version="true"
                 alt="EduSmart Logo"
                 class="login-logo" />
        </a>

        <div class="login-heading">
            <h1>Forgot Password?</h1>

            <p>
                Enter your registered email address. If you are a student without a personal email, enter your verified primary guardian's email and your own Student ID below.
            </p>
        </div>

        @if (Model.RequestReceived)
        {
            <div class="alert alert-info forgot-message forgot-request-message"
                 role="status">
                <i class="bi bi-info-circle"
                   aria-hidden="true"></i>

                <span>
                    Request received. If the details match an eligible account, we'll send a password reset link.
                    If no email arrives, check your details and spam folder, or contact the centre.
                </span>
            </div>
        }

        <form method="post"
              asp-antiforgery="true"
              class="login-form">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger login-errors"
                 role="alert"></div>

            <div class="login-field">
                <label asp-for="Email"
                       class="form-label">
                    Registered / Primary Guardian Email
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-envelope"
                       aria-hidden="true"></i>

                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           autocomplete="email"
                           placeholder="Enter your registered or primary guardian email"
                           required />
                </div>

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="login-field">
                <label asp-for="UserId"
                       class="form-label">
                    User ID
                    <span class="forgot-optional">(Required when using a guardian's email)</span>
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-person"
                       aria-hidden="true"></i>

                    <input asp-for="UserId"
                           class="form-control"
                           autocomplete="off"
                           placeholder="For student recovery, enter your Student ID"
                           aria-describedby="recovery-user-id-help" />
                </div>

                <span asp-validation-for="UserId"
                      class="text-danger"></span>

                <p class="forgot-hint" id="recovery-user-id-help">
                    Using your guardian's email? Enter your own Student ID, not your parent's ID.
                    If accounts share an email, enter the User ID of the account you want to reset.
                </p>
            </div>

            <button type="submit" class="login-button">
                <i class="bi bi-send" aria-hidden="true"></i>
                Send Reset Link
            </button>

            <a asp-page="./Login"
               class="forgot-back">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Back to sign in
            </a>
        </form>

        <div class="forgot-footer">
            <i class="bi bi-shield-lock"
               aria-hidden="true"></i>
            Secure account recovery
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
