@page
@model SecureSmartTuitionSystem.Areas.Identity.Pages.Account.ForgotPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot Password";
    ViewData["HideNavbar"] = true;
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />
}

<div class="login-page forgot-page reset-password-page">
    <div class="login-card forgot-card reset-password-card">

        <a class="login-logo-link"
           asp-controller="Home"
           asp-action="Index"
           aria-label="Return to home page">

            <img src="~/images/logo.png"
                 asp-append-version="true"
                 alt="EduSmart Logo"
                 class="login-logo" />
        </a>

        <div class="login-heading">
            <h1>Forgot Password?</h1>

            <p>
                Enter your registered email address and
                we'll send you a link to reset your password.
            </p>
        </div>

        @if (Model.RequestReceived)
        {
            <div class="alert alert-success forgot-message"
                 role="status">
                <i class="bi bi-envelope-check"
                   aria-hidden="true"></i>

                <span>
                    If an eligible account matches your details,
                    a password reset link will be sent to your email.
                    Please check your inbox and spam folder.
                </span>
            </div>
        }

        <form method="post"
              asp-antiforgery="true"
              class="login-form">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger login-errors"
                 role="alert"></div>

            <div class="login-field">
                <label asp-for="Email"
                       class="form-label">
                    Registered Email
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-envelope"
                       aria-hidden="true"></i>

                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           autocomplete="email"
                           placeholder="Enter your registered email"
                           required />
                </div>

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="login-field">
                <label asp-for="UserId"
                       class="form-label">
                    User ID
                    <span class="forgot-optional">(Optional)</span>
                </label>

                <div class="login-input-wrapper">
                    <i class="bi bi-person"
                       aria-hidden="true"></i>

                    <input asp-for="UserId"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Enter your User ID if needed" />
                </div>

                <span asp-validation-for="UserId"
                      class="text-danger"></span>

                <p class="forgot-hint">
                    Only required if multiple accounts share
                    the same email address.
                </p>
            </div>

            <button type="submit" class="login-button">
                <i class="bi bi-send" aria-hidden="true"></i>
                Send Reset Link
            </button>

            <a asp-page="./Login"
               class="forgot-back">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Back to sign in
            </a>
        </form>

        <div class="forgot-footer">
            <i class="bi bi-shield-lock"
               aria-hidden="true"></i>
            Secure account recovery
        </div>

    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
