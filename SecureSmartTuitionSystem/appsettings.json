{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\\SecureSmartTuitionSystemDb.mdf;Integrated Security=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Security": {
    "AesKeyBase64": "REPLACE_WITH_A_32_BYTE_KEY_GENERATED_VIA_USER_SECRETS_OR_KEY_VAULT",
    "AesIvBase64": "REPLACE_WITH_A_16_BYTE_IV_GENERATED_VIA_USER_SECRETS_OR_KEY_VAULT",
    "SessionTimeoutMinutes": 20
  },
  "Billing": {
    "GracePeriodWarningStartDay": 4,
    "GracePeriodFinalDay": 7,
    "LastTwoWeeksDoubleConfirmDay": 15
  },
  "Notifications": {
    "AssignmentReminderDaysBefore": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
