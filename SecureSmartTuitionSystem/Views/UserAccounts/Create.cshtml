@model SecureSmartTuitionSystem.ViewModels.Admin.CreateAdminViewModel

@{
    ViewData["Title"] = "Create Administrator";
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-accounts.css" asp-append-version="true" />
}
<div class="user-accounts-page account-form-page">
    <div class="page-header">
        <div><h1>Create Administrator</h1><p>Create a new administrator account for EduSmart.</p></div>
        <a asp-controller="UserAccounts" asp-action="Index" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Accounts</a>
    </div>
    <section class="class-form-card">
        <h2 class="account-section-title">Administrator Details</h2>
        <p class="account-form-note">An Admin ID is generated automatically. An account setup email lets the new administrator create their password.</p>
                    <form asp-controller="UserAccounts"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName"
                                   class="form-label fw-semibold">
                                Full Name <span class="text-danger">*</span>
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter full name"
                                   maxlength="100"
                                   autocomplete="name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter email address"
                                   maxlength="254"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber"
                                   class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter phone number (optional)"
                                   maxlength="30"
                                   autocomplete="tel" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Position"
                                   class="form-label fw-semibold">
                                Position
                            </label>

                            <input asp-for="Position"
                                   class="form-control"
                                   placeholder="e.g. System Administrator"
                                   maxlength="100" />

                            <span asp-validation-for="Position"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                If left blank, the position will be
                                set to Administrator.
                            </div>
                        </div>

                        <div class="class-form-actions">
                            <a asp-controller="UserAccounts"
                               asp-action="Index"
                               class="outline-button">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="primary-button">
                                Create Admin
                            </button>
                        </div>

                    </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
