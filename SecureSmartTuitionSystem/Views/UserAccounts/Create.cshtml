@model SecureSmartTuitionSystem.ViewModels.Admin.CreateAdminViewModel

@{
    ViewData["Title"] = "Create Administrator";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Create Administrator</h2>
                    <p class="text-muted mb-0">
                        Create a new administrator account for EduSmart.
                    </p>
                </div>

                <a asp-controller="UserAccounts"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <div class="alert alert-info mb-4">
                        <strong>Account Setup</strong>
                        <p class="mb-0 mt-2">
                            A unique Admin ID will be generated automatically.
                            The new administrator will receive an email
                            to set up their own password.
                        </p>
                    </div>

                    <form asp-controller="UserAccounts"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName"
                                   class="form-label fw-semibold">
                                Full Name <span class="text-danger">*</span>
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter full name"
                                   maxlength="100"
                                   autocomplete="name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter email address"
                                   maxlength="254"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber"
                                   class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter phone number (optional)"
                                   maxlength="30"
                                   autocomplete="tel" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Position"
                                   class="form-label fw-semibold">
                                Position
                            </label>

                            <input asp-for="Position"
                                   class="form-control"
                                   placeholder="e.g. System Administrator"
                                   maxlength="100" />

                            <span asp-validation-for="Position"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                If left blank, the position will be
                                set to Administrator.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="UserAccounts"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Create Admin
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
