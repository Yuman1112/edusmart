@using System.Security.Claims
@model List<SecureSmartTuitionSystem.Models.Enrollment.EnrollmentExitRequest>
@using SecureSmartTuitionSystem.Models.Enrollment
@using SecureSmartTuitionSystem.Services.Enrollment
@{ ViewData["Title"] = User.IsInRole("Admin") ? "Withdrawal History" : "Withdrawals & Refunds"; var enrollments = (List<StudentEnrollment>)ViewBag.Enrollments; bool admin = User.IsInRole("Admin"); }
<div class="page-header"><div><h1>@ViewData["Title"]</h1><p>@(admin ? "Review withdrawals and manage eligible tuition refunds." : "Stop regular classes without deleting enrollment and payment history.")</p></div></div>
@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (!admin)
{
<div class="exit-policy"><strong>Withdrawal and refund policy</strong><p class="mb-0">Withdrawal takes effect on the first day of next month. This month's tuition is retained. Future unused prepaid tuition is reviewed by Admin, using the original discounted fee. Hardcopy and delivery fees are excluded from the automatic quote. A refund decision does not cancel the withdrawal. Existing replacement entitlement is retained.</p></div>
}
@if (!admin && enrollments.Any()) {
<section class="class-details-card mb-4"><h2>Withdraw from a class</h2><form asp-action="Stop" method="post" id="withdrawalForm">
@if (User.IsInRole("Parent") || admin) {
<label for="withdrawalChild" class="form-label">@(admin ? "Student" : "Child")</label>
<select id="withdrawalChild" class="form-select mb-3" required><option value="">@(admin ? "Choose a student" : "Choose your child")</option>
@foreach (var child in enrollments.GroupBy(e => e.StudentProfileId).Select(g => g.First().StudentProfile)) {
<option value="@child.StudentProfileId">@child.FullName (@child.StudentNumber)</option>
}
</select>
}
<label for="exitEnrollment" class="form-label">Enrollment</label><select id="exitEnrollment" name="enrollmentId" class="form-select mb-3" required><option value="">Choose an enrollment</option>
@foreach (var e in enrollments) { <option value="@e.StudentEnrollmentId" data-student-id="@e.StudentProfileId">@e.ClassSession.ClassName</option> }
</select><label for="exitReason" class="form-label">Reason</label><textarea id="exitReason" name="reason" class="form-control mb-3" required maxlength="500"></textarea>
<label class="d-block mb-3"><input type="checkbox" name="confirmed" value="true" required /> I understand withdrawal takes effect next month and this month's tuition is not automatically refunded.</label>
<button class="btn btn-outline-danger">Confirm withdrawal</button></form></section>
}
@if (admin)
{
    <form method="get" asp-action="Index" data-live-filter id="withdrawalHistoryFilters" class="d-flex flex-wrap align-items-end gap-3 mb-4">
        @if (ViewBag.StudentProfileId != null) { <input type="hidden" name="studentProfileId" value="@ViewBag.StudentProfileId" /> }
        <div><label for="exitStage" class="form-label">Academic Stage</label>
            <select id="exitStage" name="stage" class="form-select">
                <option value="">All stages</option>
                @foreach (var option in new[] { "Primary", "Secondary" }) { <option value="@option" selected="@(ViewBag.Stage == option)">@option</option> }
            </select>
        </div>
        <div><label for="exitLevel" class="form-label">Academic Level</label>
            <select id="exitLevel" name="level" class="form-select"><option value="">All levels</option>
                @foreach (string option in ViewBag.LevelOptions) { <option value="@option" selected="@(ViewBag.Level == option)">@option</option> }
            </select>
        </div>
        <div><label for="exitSubject" class="form-label">Subject</label>
            <select id="exitSubject" name="subject" class="form-select"><option value="">All subjects</option>
                @foreach (string option in ViewBag.SubjectOptions) { <option value="@option" selected="@(ViewBag.SubjectFilter == option)">@option</option> }
            </select>
        </div>
        <div><label for="exitRefundStatus" class="form-label">Refund Status</label>
            <select id="exitRefundStatus" name="refundStatus" class="form-select"><option value="">All statuses</option>
                @foreach (var option in Enum.GetValues<ExitRefundStatus>()) { <option value="@option" selected="@(ViewBag.RefundStatusFilter == option.ToString())">@ExitRefundStatusText.Label(option)</option> }
            </select>
        </div>
        <a asp-action="Index" asp-route-studentProfileId="@ViewBag.StudentProfileId" class="btn btn-outline-secondary">Reset filters</a>
    </form>
}
<section class="dashboard-card">
    <header class="dashboard-card-header">
        <h2>Withdrawal history</h2>
    </header>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>No</th><th>Student</th><th>Class</th><th>Reason</th><th>Review</th><th>Stops from</th><th>Estimated refund</th><th>Refund status</th><th>Action</th></tr></thead><tbody>
@{ int no = 0; }
@foreach (var x in Model) { no++; <tr><td>@no</td><td>@x.StudentEnrollment.StudentProfile.FullName</td><td>@x.StudentEnrollment.ClassSession.ClassName</td><td>@x.Reason</td><td>@(x.ReviewedByUserId == null ? "Not reviewed" : "Reviewed")</td><td>@(x.CancelledAtUtc.HasValue ? "Cancelled" : x.EffectiveDate.ToString("dd MMM yyyy"))</td><td>RM @x.EstimatedRefund.ToString("F2")</td><td>@ExitRefundStatusText.Label(x.RefundStatus)</td><td><div class="d-flex flex-wrap gap-2"><a class="outline-button table-view-button" asp-action="Details" asp-route-id="@x.EnrollmentExitRequestId"><i class="bi bi-eye" aria-hidden="true"></i> View</a>
@if (x.RefundStatus == ExitRefundStatus.Completed && x.RefundCompletedAtUtc.HasValue && x.ApprovedRefund > 0m && !string.IsNullOrWhiteSpace(x.ProviderRefundId)) {
<a class="outline-button table-view-button" asp-action="Receipt" asp-route-id="@x.EnrollmentExitRequestId"><i class="bi bi-receipt" aria-hidden="true"></i> Refund receipt</a>
}
@if ((admin || x.RequestedByUserId == User.FindFirstValue(ClaimTypes.NameIdentifier)) && EnrollmentExitService.CanCancelWithdrawal(x, ClassScheduleService.Today)) {
<a class="outline-button table-view-button" asp-action="Details" asp-route-id="@x.EnrollmentExitRequestId" asp-fragment="cancelWithdrawal"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Cancel withdrawal</a>
}
</div></td></tr> }
@if (!Model.Any()) { <tr><td colspan="9">No withdrawal requests match the current view.</td></tr> }
</tbody></table></div></section>

@section Scripts {
    <script src="~/js/withdrawal-history-filters.js" asp-append-version="true"></script>
    <script src="~/js/withdrawal-form.js" asp-append-version="true"></script>
}
