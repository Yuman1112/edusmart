@using System.Globalization
@model SecureSmartTuitionSystem.ViewModels.Enrollment.EnrollmentSelectionViewModel

@{
    ViewData["Title"] = "Enrollment Options";
    string minimumDate = SecureSmartTuitionSystem.Services.Enrollment.ClassScheduleService.Today.ToString("yyyy-MM-dd");
    string maximumDate = SecureSmartTuitionSystem.Services.Enrollment.ClassScheduleService.Today.AddYears(1).ToString("yyyy-MM-dd");
    var selectedClasses = Model.AvailableClasses
        .Where(item => Model.SelectedClassSessionIds.Contains(item.ClassSessionId))
        .ToList();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/enrollment-submission.css"
          asp-append-version="true" />
}

<div class="public-content enrollment-page">
    <partial name="_EnrollmentSteps" model="4" />

    <form asp-controller="EnrollmentSubmission" asp-action="Submit"
          method="post" id="enrollmentOptionsForm">
        @Html.AntiForgeryToken()

        @foreach (int classId in Model.SelectedClassSessionIds)
        {
            <input type="hidden" name="SelectedClassSessionIds" value="@classId" />
        }

        <div class="enrollment-card">
            <div class="enrollment-card-header">
                <div>
                    <span class="enrollment-eyebrow">@(Context.Session.GetInt32("Enrollment.AddSubjectStudentId").HasValue ? "Step 2 of 3" : "Step 4 of 5")</span>
                    <h1>Enrollment Options</h1>
                    <p>Choose the enrollment plan, learning materials and delivery preferences.</p>
                </div>
                <div class="enrollment-step-icon"><i class="bi bi-sliders"></i></div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <span asp-validation-for="SelectedClassSessionIds" class="text-danger"></span>

            <section class="enrollment-section">
                <div class="enrollment-section-title">
                    <i class="bi bi-check2-square"></i>
                    <div><h2>Selected Classes</h2><p>Confirm the classes selected in the previous step.</p></div>
                </div>
                <div class="selected-classes-list">
                    @foreach (var item in selectedClasses)
                    {
                        <div class="selected-class-summary-item option-class-item"
                             data-fee="@item.MonthlyFee.ToString(
                                 "0.00",
                                 CultureInfo.InvariantCulture)"
                             data-subject-key="@($"{item.EducationStage}|{item.AcademicLevel}|{item.SubjectName}")">
                            <div>
                                <strong>@item.ClassName</strong>
                                <span>@item.SubjectName · @item.EducationStage · @item.AcademicLevel</span>
                                <small>@item.Day · @item.StartTime – @item.EndTime · @item.TutorName</small>
                            </div>
                            <strong>@(item.MonthlyFee == 0 ? "Free" : $"RM {item.MonthlyFee:F2}/month")</strong>
                        </div>
                    }
                </div>
            </section>

            <section class="enrollment-section">
                <div class="enrollment-section-title">
                    <i class="bi bi-calendar-check"></i>
                    <div><h2>Enrollment Information</h2><p>Select the starting date and enrollment duration.</p></div>
                </div>
                <div class="enrollment-form-grid">
                    <div class="form-group">
                        <label asp-for="RequestedStartDate" class="form-label">
                            Requested Start Date <span class="required-mark">*</span>
                        </label>
                        <input asp-for="RequestedStartDate" type="date" class="form-control"
                               id="requestedStartDate" min="@minimumDate" max="@maximumDate" />
                        <span asp-validation-for="RequestedStartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="EnrollmentDurationMonths" class="form-label">
                            Enrollment Plan <span class="required-mark">*</span>
                        </label>
                        <select asp-for="EnrollmentDurationMonths" class="form-select"
                                id="enrollmentDurationMonths">
                            <option value="1">1 Month — Original price</option>
                            <option value="2">2 Months — Year-end balance, no discount</option>
                            <option value="3">3 Months — 3% tuition discount</option>
                            <option value="6">6 Months — 5% tuition discount</option>
                            <option value="9">9 Months — 8% tuition discount</option>
                            <option value="12">12 Months — 10% tuition discount</option>
                        </select>
                        <span asp-validation-for="EnrollmentDurationMonths" class="text-danger"></span>
                    </div>
                    <div class="enrollment-plan-guidance full-width">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <div>
                            <p id="academicPlanStatus" class="enrollment-plan-summary" role="status" aria-live="polite" data-term-end="@Model.SelectedTermEndDate?.ToString("yyyy-MM-dd")"></p>
                            <p>Discounts apply to tuition fees only. Plans must end by 31 December or the class term end date, whichever comes first.</p>
                            <p>Tuition includes the selected start month. A partial first month is charged at the full monthly rate.</p>
                        </div>
                    </div>
                    <div class="form-group full-width" id="finalTwoWeeksSection" hidden>
                        <div class="enrollment-warning-card">
                            <div class="warning-card-heading">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>Final two weeks confirmation</strong>
                            </div>
                            <p>The selected start date falls within the final two weeks of the month.</p>
                            <label class="enrollment-option-label">
                                <input asp-for="FinalTwoWeeksConfirmed" class="form-check-input"
                                       id="finalTwoWeeksConfirmed" />
                                <span><strong>I understand and want to continue.</strong></span>
                            </label>
                            <span asp-validation-for="FinalTwoWeeksConfirmed" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group full-width">
                        <label asp-for="ApplicantNotes" class="form-label">
                            Applicant Notes <span class="optional-label">Optional</span>
                        </label>
                        <textarea asp-for="ApplicantNotes" class="form-control" rows="4"
                                  maxlength="500"
                                  placeholder="Enter any additional information for the administrator."></textarea>
                        <span asp-validation-for="ApplicantNotes" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="enrollment-section">
                <div class="enrollment-section-title">
                    <i class="bi bi-box-seam"></i>
                    <div>
                        <h2>Learning Materials</h2>

                        <p>Hardcopy materials cost RM10.00 per unique subject per month.
                        </p>
                    </div>
                </div>
                <div class="enrollment-option-card">
                    <label class="enrollment-option-label">
                        <input asp-for="HardcopyMaterialsRequested" class="form-check-input"
                               id="hardcopyRequested" />
                        <span>
                            <strong>
                                Request hardcopy learning materials
                            </strong>

                            <small>
                                RM10.00 per unique subject per month.
                                Delivery is charged once per application.
                            </small>
                        </span>
                    </label>
                </div>

                <div class="hardcopy-delivery-panel" id="hardcopyDeliveryPanel" hidden>
                    <div class="delivery-panel-heading">
                        <i class="bi bi-truck"></i>
                        <div><strong>Delivery Address</strong><p>Enter the complete Malaysian delivery address.</p></div>
                    </div>
                    <div class="delivery-address-grid">
                        <div class="form-group full-width">
                            <label asp-for="DeliveryRecipientName" class="form-label"></label>
                            <input asp-for="DeliveryRecipientName" class="form-control delivery-required"
                                   autocomplete="name" placeholder="Recipient's full name" />
                            <span asp-validation-for="DeliveryRecipientName" class="text-danger"></span>
                        </div>
                        <div class="form-group full-width">
                            <label asp-for="DeliveryAddressLine1" class="form-label"></label>
                            <input asp-for="DeliveryAddressLine1" class="form-control delivery-required"
                                   autocomplete="address-line1"
                                   placeholder="House/unit number, building and street" />
                            <span asp-validation-for="DeliveryAddressLine1" class="text-danger"></span>
                        </div>
                        <div class="form-group full-width">
                            <label asp-for="DeliveryAddressLine2" class="form-label">
                                Address Line 2 <span class="optional-label">Optional</span>
                            </label>
                            <input asp-for="DeliveryAddressLine2" class="form-control"
                                   autocomplete="address-line2"
                                   placeholder="Area or additional address information" />
                            <span asp-validation-for="DeliveryAddressLine2" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DeliveryPostcode" class="form-label"></label>
                            <input asp-for="DeliveryPostcode" class="form-control delivery-required"
                                   inputmode="numeric" maxlength="5" autocomplete="postal-code"
                                   placeholder="e.g. 43000" />
                            <span asp-validation-for="DeliveryPostcode" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DeliveryCity" class="form-label"></label>
                            <input asp-for="DeliveryCity" class="form-control delivery-required"
                                   autocomplete="address-level2" placeholder="City" />
                            <span asp-validation-for="DeliveryCity" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DeliveryState"
                                   class="form-label">
                            </label>

                            <select asp-for="DeliveryState"
                                    class="form-select delivery-required"
                                    id="deliveryState">
                                <option value="">Select state</option>
                                <option>Johor</option>
                                <option>Kedah</option>
                                <option>Kelantan</option>
                                <option>Melaka</option>
                                <option>Negeri Sembilan</option>
                                <option>Pahang</option>
                                <option>Penang</option>
                                <option>Perak</option>
                                <option>Perlis</option>
                                <option>Sabah</option>
                                <option>Sarawak</option>
                                <option>Selangor</option>
                                <option>Terengganu</option>
                                <option>Kuala Lumpur</option>
                                <option>Labuan</option>
                                <option>Putrajaya</option>
                            </select>

                            <span asp-validation-for="DeliveryState"
                                  class="text-danger">
                            </span>

                            <input asp-for="DeliveryRegion"
                                   type="hidden"
                                   id="deliveryRegion" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="selection-summary-card billing-summary-card">
                <div class="billing-summary-heading">
                    <div><span>Billing Information</span><strong>Estimated Fee Summary</strong></div>
                    <span>@selectedClasses.Count class(es)</span>
                </div>
                <div class="billing-breakdown">
                    <div><span>Monthly Tuition Fee</span><strong id="monthlyTuition">RM 0.00</strong></div>
                    <div><span id="subtotalLabel">1-Month Tuition</span><strong id="tuitionSubtotal">RM 0.00</strong></div>
                    <div class="discount-row"><span id="discountLabel">Tuition Discount (0%)</span><strong id="discountAmount">− RM 0.00</strong></div>
                    <div><span id="hardcopyLabel">Hardcopy Materials (0 subjects × 1 month)</span><strong id="hardcopyFee">RM 0.00</strong>
                    </div>                    <div><span>Delivery Fee</span><strong id="shippingFee">RM 0.00</strong></div>
                </div>
                <div class="billing-grand-total">
                    <span>Estimated Total</span><strong id="estimatedTotal">RM 0.00</strong>
                </div>
                <p class="billing-summary-note">
                    Final billing is generated only after administrator approval.
                    Discounts apply to tuition fees only.
                </p>
            </section>

            <div class="enrollment-form-actions">
                <button type="submit"
                        formaction="@Url.Action("BackToSelectClasses", "EnrollmentSubmission")"
                        formmethod="post" class="outline-button" formnovalidate>
                    <i class="bi bi-arrow-left"></i> Back: Select Classes
                </button>
                <button type="submit" class="primary-button">
                    Review & Submit <i class="bi bi-send-check"></i>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script nonce="@Context.Items["CspNonce"]">
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const hardcopyCheckbox =
                    document.getElementById(
                        "hardcopyRequested"
                    );

                const deliveryPanel =
                    document.getElementById(
                        "hardcopyDeliveryPanel"
                    );

                const deliveryRequiredFields =
                    Array.from(
                        document.querySelectorAll(
                            ".delivery-required"
                        )
                    );

                const deliveryRegion =
                    document.getElementById(
                        "deliveryRegion"
                    );

                const deliveryState =
                    document.getElementById(
                        "deliveryState"
                    );

                const durationSelect =
                    document.getElementById(
                        "enrollmentDurationMonths"
                    );

                const requestedStartDate =
                    document.getElementById(
                        "requestedStartDate"
                    );

                const finalTwoWeeksSection =
                    document.getElementById(
                        "finalTwoWeeksSection"
                    );

                const finalTwoWeeksConfirmed =
                    document.getElementById(
                        "finalTwoWeeksConfirmed"
                    );

                const selectedClassItems =
                    Array.from(
                        document.querySelectorAll(
                            ".option-class-item"
                        )
                    );

                const discounts = {
                    1: 0,
                    3: 3,
                    6: 5,
                    9: 8,
                    12: 10
                };

                /*
                 * Calculate total monthly tuition
                 * from all selected class cards.
                 */
                const monthlyTuitionFee =
                    selectedClassItems.reduce(
                        function (total, item) {
                            const fee =
                                Number.parseFloat(
                                    item.dataset.fee ??
                                    "0"
                                );

                            return total +
                                (
                                    Number.isFinite(fee)
                                        ? fee
                                        : 0
                                );
                        },
                        0
                    );

                /*
                 * Count unique subjects.
                 *
                 * Multiple classes for the same subject
                 * are counted as one hardcopy subject.
                 */
                const uniqueSubjectKeys =
                    selectedClassItems
                        .map(function (item) {
                            return (
                                item.dataset.subjectKey ??
                                ""
                            ).trim();
                        })
                        .filter(function (subjectKey) {
                            return subjectKey.length > 0;
                        });

                const uniqueSubjectCount =
                    new Set(
                        uniqueSubjectKeys
                    ).size;

                function formatMoney(value) {
                    return "RM " +
                        value.toFixed(2);
                }

                function getSelectedMonths() {
                    const months =
                        Number.parseInt(
                            durationSelect.value ??
                            "1",
                            10
                        );

                    return [1, 2, 3, 6, 9, 12]
                        .includes(months)
                            ? months
                            : 1;
                }

                function updateAcademicPlans() {
                    const status = document.getElementById("academicPlanStatus");
                    const date = requestedStartDate.value;
                    if (!date) return;
                    const start = new Date(date + "T00:00:00");
                    let limit = new Date(start.getFullYear(), 11, 31);
                    if (status.dataset.termEnd) { const term = new Date(status.dataset.termEnd + "T00:00:00"); if (term < limit) limit = term; }
                    let maximum = limit < start ? 0 : (limit.getFullYear() - start.getFullYear()) * 12 + limit.getMonth() - start.getMonth() + 1;
                    if (limit.getDate() < new Date(limit.getFullYear(), limit.getMonth() + 1, 0).getDate()) maximum--;
                    maximum = Math.max(0, Math.min(12, maximum));
                    const allowed = [1, 3, 6, 9, 12].filter(x => x <= maximum); if (maximum === 2) allowed.push(2);
                    Array.from(durationSelect.options).forEach(option => { const available = allowed.includes(Number(option.value)); option.disabled = !available; option.hidden = !available; });
                    if (!allowed.includes(Number(durationSelect.value))) durationSelect.value = allowed.length ? String(Math.min(...allowed)) : "";
                    durationSelect.setCustomValidity(allowed.length ? "" : "No complete prepaid month remains within this class term.");
                    status.textContent = `Academic year ${start.getFullYear()} (January–December) · Up to ${maximum} prepaid ${maximum === 1 ? "month" : "months"}.`;
                    updateFees();
                }
                function updateFees() {
                    const months =
                        getSelectedMonths();

                    const discountRate =
                        discounts[months] ?? 0;

                    /*
                     * Tuition calculation
                     */
                    const tuitionSubtotal =
                        monthlyTuitionFee *
                        months;

                    const tuitionDiscount =
                        Math.round(
                            tuitionSubtotal *
                            discountRate
                        ) / 100;

                    const discountedTuition =
                        tuitionSubtotal -
                        tuitionDiscount;

                    /*
                     * Hardcopy calculation:
                     *
                     * RM10 × unique subjects × months
                     */
                    const hardcopyFee =
                        hardcopyCheckbox.checked
                            ? uniqueSubjectCount *
                              months *
                              10
                            : 0;

                    /*
                     * Shipping is charged only once
                     * per enrollment application.
                     */
                    let shippingFee = 0;

                    if (hardcopyCheckbox.checked) {
                        if (
                            deliveryRegion.value ===
                            "West Malaysia"
                        ) {
                            shippingFee = 10;
                        }
                        else if (
                            deliveryRegion.value ===
                            "East Malaysia"
                        ) {
                            shippingFee = 18;
                        }
                    }

                    const estimatedTotal =
                        discountedTuition +
                        hardcopyFee +
                        shippingFee;

                    document.getElementById(
                        "monthlyTuition"
                    ).textContent =
                        formatMoney(
                            monthlyTuitionFee
                        );

                    document.getElementById(
                        "subtotalLabel"
                    ).textContent =
                        months +
                        (
                            months === 1
                                ? "-Month Tuition"
                                : "-Month Tuition"
                        );

                    document.getElementById(
                        "tuitionSubtotal"
                    ).textContent =
                        formatMoney(
                            tuitionSubtotal
                        );

                    document.getElementById(
                        "discountLabel"
                    ).textContent =
                        "Tuition Discount (" +
                        discountRate +
                        "%)";

                    document.getElementById(
                        "discountAmount"
                    ).textContent =
                        "− " +
                        formatMoney(
                            tuitionDiscount
                        );

                    const displayedSubjectCount =
                        hardcopyCheckbox.checked
                            ? uniqueSubjectCount
                            : 0;

                    const subjectWord =
                        displayedSubjectCount === 1
                            ? "subject"
                            : "subjects";

                    const monthWord =
                        months === 1
                            ? "month"
                            : "months";

                    document.getElementById(
                        "hardcopyLabel"
                    ).textContent =
                        "Hardcopy Materials (" +
                        displayedSubjectCount +
                        " " +
                        subjectWord +
                        " × " +
                        months +
                        " " +
                        monthWord +
                        " × RM10.00)";

                    document.getElementById(
                        "hardcopyFee"
                    ).textContent =
                        formatMoney(
                            hardcopyFee
                        );

                    document.getElementById(
                        "shippingFee"
                    ).textContent =
                        formatMoney(
                            shippingFee
                        );

                    document.getElementById(
                        "estimatedTotal"
                    ).textContent =
                        formatMoney(
                            estimatedTotal
                        );
                }

                function updateHardcopySection() {
                    const isRequested =
                        hardcopyCheckbox.checked;

                    deliveryPanel.hidden =
                        !isRequested;

                    deliveryRequiredFields.forEach(
                        function (field) {
                            field.required =
                                isRequested;
                        }
                    );

                    if (!isRequested) {
                        deliveryRegion.value = "";
                    }

                    updateFees();
                }

                function updateDeliveryRegion() {
                    const selectedState =
                        deliveryState.value;

                    if (!selectedState) {
                        deliveryRegion.value = "";
                    }
                    else if (
                        [
                            "Sabah",
                            "Sarawak",
                            "Labuan"
                        ].includes(selectedState)
                    ) {
                        deliveryRegion.value =
                            "East Malaysia";
                    }
                    else {
                        deliveryRegion.value =
                            "West Malaysia";
                    }

                    updateFees();
                }
                function updateFinalTwoWeeks() {
                    if (!requestedStartDate.value) {
                        finalTwoWeeksSection.hidden =
                            true;

                        finalTwoWeeksConfirmed.required =
                            false;

                        return;
                    }

                    const selectedDate =
                        new Date(
                            requestedStartDate.value +
                            "T00:00:00"
                        );

                    const lastDayOfMonth =
                        new Date(
                            selectedDate.getFullYear(),
                            selectedDate.getMonth() + 1,
                            0
                        );

                    const finalTwoWeeksStart =
                        new Date(lastDayOfMonth);

                    finalTwoWeeksStart.setDate(
                        lastDayOfMonth.getDate() -
                        13
                    );

                    const isFinalTwoWeeks =
                        selectedDate >=
                        finalTwoWeeksStart;

                    finalTwoWeeksSection.hidden =
                        !isFinalTwoWeeks;

                    finalTwoWeeksConfirmed.required =
                        isFinalTwoWeeks;

                    if (!isFinalTwoWeeks) {
                        finalTwoWeeksConfirmed.checked =
                            false;
                    }
                }

                hardcopyCheckbox.addEventListener(
                    "change",
                    updateHardcopySection
                );

                deliveryState.addEventListener(
                    "change",
                    updateDeliveryRegion
                );

                durationSelect.addEventListener(
                    "change",
                    updateFees
                );

                requestedStartDate.addEventListener(
                    "change",
                    updateFinalTwoWeeks
                );

                updateHardcopySection();
                updateDeliveryRegion();
                updateFinalTwoWeeks();
                requestedStartDate.addEventListener("change", updateAcademicPlans);
                updateAcademicPlans();
                updateFees();
            }
        );
    </script>
}