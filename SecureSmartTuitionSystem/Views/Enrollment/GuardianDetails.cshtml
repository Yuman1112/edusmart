@model SecureSmartTuitionSystem.ViewModels.Enrollment.GuardianDetailsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Parent / Guardian Details";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-4">
    <div class="col-md-10 col-lg-8">

        <partial name="_EnrollmentSteps" model="@(2)" />

        <div class="enrollment-card">

            <h1 class="mb-3">Parent / Guardian Details</h1>

            <p class="text-muted mb-4">
                Provide the details of the student's parent or guardian.
            </p>

            @if (TempData["EnrollmentMessage"] is string enrollmentMessage)
            {
                <div class="alert alert-warning" role="alert">
                    @enrollmentMessage
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <form asp-controller="Enrollment"
                  asp-action="GuardianDetails"
                  method="post"
                  id="guardianForm">

                <!-- ==========================================
                     EXISTING PARENT CHECKBOX
                     ========================================== -->
                <div class="form-check mb-4">

                    <input asp-for="UseExistingParentAccount"
                           class="form-check-input"
                           aria-controls="existing-parent-fields new-parent-fields" />

                    <label asp-for="UseExistingParentAccount"
                           class="form-check-label">
                        I already have an EduSmart parent / guardian account
                    </label>

                </div>

                <!-- ==========================================
                     EXISTING PARENT VERIFICATION
                     ========================================== -->
                <div id="existing-parent-fields"
                     class="mb-4"
                     hidden>

                    <div class="alert alert-info">

                        <strong>
                            Verify your existing account
                        </strong>

                        <div class="mt-1">
                            Sign in to your parent / guardian account first. Then enter the email and last 4 digits of the
                            identification number registered with your
                            EduSmart account.
                        </div>

                    </div>

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <p>After signing in, start the enrollment form again to protect your session.</p>
                        <p><a asp-area="Identity" asp-page="/Account/Login"
                              asp-route-returnUrl="/Enrollment/Start"
                              class="outline-button">Sign in to your existing account</a></p>
                    }

                    @if (Model.ExistingParentVerified)
                    {
                        <!-- ==================================
                             VERIFIED SUCCESS
                             ================================== -->
                        <div class="alert alert-success">

                            <div class="fw-bold mb-2">
                                ✓ Account verified
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                                Model.VerifiedParentName))
                            {
                                <div>
                                    <strong>Parent / Guardian:</strong>
                                    @Model.VerifiedParentName
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(
                                                Model.VerifiedParentEmail))
                            {
                                <div>
                                    <strong>Email:</strong>
                                    @Model.VerifiedParentEmail
                                </div>
                            }

                            <div class="mt-2">
                                This student will be linked to your existing
                                parent / guardian account after the
                                enrollment is completed.
                            </div>

                        </div>

                        <!-- Keep these values when Continue is clicked -->
                        <input asp-for="ExistingParentEmail"
                               type="hidden" />

                        <input asp-for="ExistingParentIdentificationLast4"
                               type="hidden" />
                    }
                    else
                    {
                        <div class="row">

                            <!-- Registered Email -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="ExistingParentEmail"
                                       class="form-label">
                                    Registered Email
                                </label>

                                <input asp-for="ExistingParentEmail"
                                       class="form-control"
                                       type="email"
                                       maxlength="256"
                                       autocomplete="email"
                                       placeholder="Enter registered email" />

                                <span asp-validation-for="ExistingParentEmail"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- Last 4 Digits -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="ExistingParentIdentificationLast4"
                                       class="form-label">
                                    Last 4 Digits of Identification Number
                                </label>

                                <input asp-for="ExistingParentIdentificationLast4"
                                       class="form-control"
                                       inputmode="numeric"
                                       maxlength="4"
                                       autocomplete="off"
                                       placeholder="Last 4 digits"
                                       oninput="this.value = this.value.replace(/\D/g, '').slice(0, 4)" />

                                <span asp-validation-for="ExistingParentIdentificationLast4"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <button type="submit"
                                asp-controller="Enrollment"
                                asp-action="VerifyExistingParent"
                                class="outline-button">

                            Verify Account

                        </button>

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mt-2 mb-3 validation-summary-no-bullets"
                             role="alert">
                        </div>
                    }

                </div>

                <!-- ==========================================
                     NEW PARENT / GUARDIAN
                     ========================================== -->
                <fieldset id="new-parent-fields">

                    <legend class="visually-hidden">
                        New parent or guardian details
                    </legend>

                    <!-- Full Name -->
                    <div class="mb-3">

                        <label asp-for="GuardianName"
                               class="form-label">
                        </label>

                        <input asp-for="GuardianName"
                               class="form-control"
                               maxlength="100"
                               autocomplete="name"
                               placeholder="Full name as per IC" />

                        <span asp-validation-for="GuardianName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Email -->
                    <div class="mb-3">

                        <label asp-for="GuardianEmail"
                               class="form-label">
                        </label>

                        <input asp-for="GuardianEmail"
                               class="form-control"
                               type="email"
                               maxlength="256"
                               autocomplete="email"
                               placeholder="you@example.com" />

                        <span asp-validation-for="GuardianEmail"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Phone -->
                    <div class="mb-3">

                        <label asp-for="GuardianPhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="GuardianPhoneNumber"
                               class="form-control"
                               type="tel"
                               id="guardianPhone"
                               inputmode="numeric"
                               maxlength="13"
                               autocomplete="tel"
                               placeholder="012-3456789" />

                        <span asp-validation-for="GuardianPhoneNumber"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Identification Number -->
                    <div class="mb-4">

                        <label asp-for="GuardianIdentificationNumber"
                               class="form-label">
                        </label>

                        <input asp-for="GuardianIdentificationNumber"
                               class="form-control"
                               id="guardianIc"
                               inputmode="numeric"
                               maxlength="14"
                               autocomplete="off"
                               placeholder="000000-00-0000" />

                        <span asp-validation-for="GuardianIdentificationNumber"
                              class="text-danger"
                              id="guardianIcValidation">
                        </span>
                    </div>

                </fieldset>

                <!-- ==========================================
                     NAVIGATION
                     ========================================== -->
                <div class="enrollment-form-actions justify-content-between">

                    <button type="submit"
                            asp-controller="Enrollment"
                            asp-action="BackToStudentDetails"
                            formnovalidate
                            class="outline-button">

                        <i class="bi bi-arrow-left"></i>
                        Back
                    </button>

                    <button type="submit"
                            asp-controller="Enrollment"
                            asp-action="GuardianDetails"
                            class="primary-button">

                        Continue
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/enrollment-ic.js" asp-append-version="true"></script>
    <script nonce="@Context.Items["CspNonce"]">
        (() => {
            const checkbox = document.getElementById("UseExistingParentAccount");
            const existingFields = document.getElementById("existing-parent-fields");
            const newFields = document.getElementById("new-parent-fields");
            const phone = document.getElementById("guardianPhone");
            function updateFields() {
                existingFields.hidden = !checkbox.checked;
                newFields.hidden = checkbox.checked;
                newFields.disabled = checkbox.checked;
            }
            phone?.addEventListener("input", () => {
                let digits = phone.value.replace(/\D/g, "");
                if (digits.startsWith("60")) digits = "0" + digits.slice(2);
                digits = digits.slice(0,11);
                phone.value = digits.length > 3 ? digits.slice(0,3) + "-" + digits.slice(3) : digits;
            });
            checkbox.addEventListener("change",updateFields);
            updateFields();
        })();
    </script>
}
