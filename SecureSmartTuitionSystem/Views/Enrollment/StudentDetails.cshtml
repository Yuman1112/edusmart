@model SecureSmartTuitionSystem.ViewModels.Enrollment.StudentDetailsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Student Details";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-4">
    <div class="col-md-10 col-lg-8">

        <partial name="_EnrollmentSteps" model="@(1)" />

        <div class="enrollment-card">

            <h1 class="mb-3">Student Details</h1>

            <p class="text-muted mb-4">
                Tell us about the student who will be attending classes.
            </p>

            @if (TempData["EnrollmentMessage"] is string enrollmentMessage)
            {
                <div class="alert alert-warning" role="alert">
                    @enrollmentMessage
                </div>
            }

            <form asp-controller="Enrollment"
                  asp-action="StudentDetails"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert">
                </div>

                <!-- ==========================================
                     STUDENT FULL NAME
                     ========================================== -->
                <div class="mb-3">

                    <label asp-for="StudentName"
                           class="form-label">
                    </label>

                    <input asp-for="StudentName"
                           class="form-control"
                           maxlength="100"
                           placeholder="Full name as per IC"
                           autocomplete="off" />

                    <span asp-validation-for="StudentName"
                          class="text-danger">
                    </span>

                </div>

                <!-- ==========================================
                     IDENTIFICATION NUMBER
                     ========================================== -->
                <div class="mb-3">

                    <label asp-for="StudentIdentificationNumber"
                           class="form-label">
                        IC Number
                    </label>

                    <input asp-for="StudentIdentificationNumber"
                           class="form-control"
                           maxlength="14"
                           placeholder="000000-00-0000"
                           autocomplete="off"
                           inputmode="numeric"
                           id="studentIdentificationNumber" />

                    <span asp-validation-for="StudentIdentificationNumber"
                          class="text-danger"
                          id="studentIdentificationNumberValidation">
                    </span>

                    <div id="studentIcValidation"
                         class="text-danger"
                         style="display: none;">
                    </div>

                </div>

                <!-- ==========================================
                     DATE OF BIRTH + GENDER
                     ========================================== -->
                <div class="form-text mb-2">
                    Date of birth and gender will be filled automatically from the IC number.
                </div>

                <div class="row">

                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="StudentDateOfBirth"
                               class="form-label">
                        </label>

                        <input asp-for="StudentDateOfBirth"
                               class="form-control"
                               type="date"
                               id="studentDateOfBirth"
                               readonly
                               max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="StudentDateOfBirth"
                              class="text-danger"
                              id="studentDateOfBirthValidation">
                        </span>

                        <div id="studentAgeValidation"
                             class="text-warning"
                             style="display: none;">
                        </div>

                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="StudentGender"
                               class="form-label">
                        </label>

                        <select asp-for="StudentGender"
                                class="form-select"
                                id="studentGender">

                            <option value="">
                                Select gender
                            </option>

                            <option value="Male">
                                Male
                            </option>

                            <option value="Female">
                                Female
                            </option>

                        </select>

                        <span asp-validation-for="StudentGender"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <!-- ==========================================
                     CURRENT SCHOOL
                     ========================================== -->
                <div class="mb-4">

                    <label asp-for="StudentSchool"
                           class="form-label">
                    </label>

                    <input asp-for="StudentSchool"
                           class="form-control"
                           maxlength="150"
                           placeholder="School name"
                           autocomplete="off" />

                    <span asp-validation-for="StudentSchool"
                          class="text-danger">
                    </span>

                </div>

                <!-- ==========================================
                     NAVIGATION
                     ========================================== -->
                <div class="enrollment-form-actions justify-content-end">

                    <button type="submit"
                            class="primary-button"
                            id="nextButton">

                        Next: Parent / Guardian Details

                        <i class="bi bi-arrow-right"></i>
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const numberInput =
                    document.getElementById(
                        "studentIdentificationNumber");

                const dateOfBirthInput =
                    document.getElementById(
                        "studentDateOfBirth");

                const genderSelect =
                    document.getElementById(
                        "studentGender");

                const ageValidation =
                    document.getElementById(
                        "studentAgeValidation");

                const dateOfBirthValidation =
                    document.getElementById(
                        "studentDateOfBirthValidation");

                const identificationValidation =
                    document.getElementById(
                        "studentIdentificationNumberValidation");

                const icValidation =
                    document.getElementById(
                        "studentIcValidation");

                const nextButton =
                    document.getElementById(
                        "nextButton");

                function calculateAge(dateOfBirth) {

                    const today =
                        new Date();

                    let age =
                        today.getFullYear() -
                        dateOfBirth.getFullYear();

                    const monthDifference =
                        today.getMonth() -
                        dateOfBirth.getMonth();

                    if (
                        monthDifference < 0 ||
                        (
                            monthDifference === 0 &&
                            today.getDate() <
                            dateOfBirth.getDate()
                        )
                    ) {
                        age--;
                    }

                    return age;
                }

                function validateStudentAge() {

                    if (!dateOfBirthInput.value) {

                        ageValidation.textContent = "";
                        ageValidation.style.display = "none";

                        return true;
                    }

                    const dateOfBirth =
                        new Date(
                            dateOfBirthInput.value + "T00:00:00");

                    const age =
                        calculateAge(dateOfBirth);

                    if (age < 5 || age > 19) {

                        if (
                            dateOfBirthValidation &&
                            dateOfBirthValidation.textContent.trim() !== ""
                        ) {
                            ageValidation.textContent = "";
                            ageValidation.style.display = "none";
                        }
                        else {
                            ageValidation.textContent =
                                "The student's age is not within the supported range for Year 1 to Form 5.";

                            ageValidation.style.display =
                                "block";
                        }

                        return false;
                    }

                    ageValidation.textContent = "";
                    ageValidation.style.display = "none";

                    return true;
                }

                function formatIcNumber(value) {

                    let digits =
                        value.replace(/\D/g, "");

                    digits =
                        digits.substring(0, 12);

                    if (digits.length > 8) {

                        return (
                            digits.substring(0, 6) +
                            "-" +
                            digits.substring(6, 8) +
                            "-" +
                            digits.substring(8)
                        );
                    }

                    if (digits.length > 6) {

                        return (
                            digits.substring(0, 6) +
                            "-" +
                            digits.substring(6)
                        );
                    }

                    return digits;
                }

                function populateDetailsFromIc() {

                    const digits =
                        numberInput.value.replace(/\D/g, "");

                    if (digits.length !== 12) {

                        dateOfBirthInput.value = "";
                        genderSelect.value = "";

                        // Clear IC validation
                        icValidation.textContent = "";
                        icValidation.style.display = "none";

                        // Clear age validation
                        ageValidation.textContent = "";
                        ageValidation.style.display = "none";

                        return false;
                    }

                    const yy =
                        parseInt(digits.substring(0, 2));

                    const mm =
                        parseInt(digits.substring(2, 4));

                    const dd =
                        parseInt(digits.substring(4, 6));

                    const currentYear =
                        new Date().getFullYear();

                    const currentTwoDigitYear =
                        currentYear % 100;

                    const fullYear =
                        yy <= currentTwoDigitYear
                            ? 2000 + yy
                            : 1900 + yy;

                    const date =
                        new Date(
                            fullYear,
                            mm - 1,
                            dd);

                    const validDate =
                        date.getFullYear() === fullYear &&
                        date.getMonth() === mm - 1 &&
                        date.getDate() === dd;

                    if (!validDate) {

                        dateOfBirthInput.value = "";
                        genderSelect.value = "";

                        ageValidation.textContent = "";
                        ageValidation.style.display = "none";

                        if (
                            identificationValidation &&
                            identificationValidation.textContent.trim() !== ""
                        ) {
                            icValidation.textContent = "";
                            icValidation.style.display = "none";
                        }
                        else {
                            icValidation.textContent =
                                "The IC number contains an invalid date of birth.";

                            icValidation.style.display =
                                "block";
                        }

                        return false;
                    }

                    icValidation.textContent = "";
                    icValidation.style.display = "none";

                    const month =
                        String(mm).padStart(2, "0");

                    const day =
                        String(dd).padStart(2, "0");

                    dateOfBirthInput.value =
                        `${fullYear}-${month}-${day}`;

                    const validAge =
                        validateStudentAge();

                    const lastDigit =
                        parseInt(
                            digits.charAt(11));

                    genderSelect.value =
                        lastDigit % 2 === 0
                            ? "Female"
                            : "Male";

                    return validAge;
                }

                async function checkExistingIc() {

                    const currentIc =
                        numberInput.value;

                    const digits =
                        currentIc.replace(/\D/g, "");

                    if (digits.length !== 12) {
                        return;
                    }

                    /*
                     * Temporarily prevent submission while
                     * the live duplicate check is running.
                     */
                    nextButton.disabled =
                        true;

                    try {

                        const response =
                            await fetch(
                                `/Enrollment/CheckStudentIc?icNumber=${encodeURIComponent(
                                    currentIc
                                )}`
                            );

                        /*
                         * Ignore an old response if the user
                         * has already changed the IC number.
                         */
                        if (numberInput.value !== currentIc) {
                            return;
                        }

                        if (!response.ok) {

                            nextButton.disabled =
                                false;

                            return;
                        }

                        const result =
                            await response.json();

                        /*
                         * Check again after reading the response
                         * in case the IC changed meanwhile.
                         */
                        if (numberInput.value !== currentIc) {
                            return;
                        }

                        if (result.exists) {

                            /*
                             * Avoid showing the same duplicate message twice
                             * when server-side validation already displayed it.
                             */
                            if (
                                identificationValidation &&
                                identificationValidation.textContent.trim() !== ""
                            ) {
                                icValidation.textContent =
                                    "";

                                icValidation.style.display =
                                    "none";
                            }
                            else {
                                icValidation.textContent =
                                    "A student with this IC number already exists. Please sign in to EduSmart to enroll in additional subjects.";

                                icValidation.style.display =
                                    "block";
                            }

                            nextButton.disabled =
                                true;
                        }
                        else {

                            if (
                                icValidation.textContent.includes(
                                    "already exists")
                            ) {
                                icValidation.textContent =
                                    "";

                                icValidation.style.display =
                                    "none";
                            }

                            nextButton.disabled =
                                false;
                        }
                    }
                    catch {

                        /*
                         * Live duplicate checking is only for UX.
                         * Server-side validation still protects submission.
                         */
                        if (numberInput.value === currentIc) {

                            nextButton.disabled =
                                false;
                        }
                    }
                }

                // ==========================================
                // AUTO FORMAT WHILE USER TYPES
                // ==========================================
                numberInput.addEventListener(
                    "input",
                    function () {
                        /*
                         * Clear any previous server-side IC error
                         * when the user edits the IC number.
                         */
                        if (identificationValidation) {
                            identificationValidation.textContent =
                                "";
                        }

                        this.value =
                            formatIcNumber(
                                this.value);

                        const validIc =
                            populateDetailsFromIc();

                        if (validIc) {

                            checkExistingIc();
                        }
                        else {

                            nextButton.disabled =
                                true;
                        }
                    });

                // ==========================================
                // PREVENT MANUAL GENDER EDIT
                // ==========================================
                genderSelect.style.pointerEvents =
                    "none";

                genderSelect.tabIndex =
                    -1;

                genderSelect.setAttribute(
                    "aria-disabled",
                    "true");

                // ==========================================
                // INITIAL PAGE LOAD
                // ==========================================
                const validIc =
                    populateDetailsFromIc();

                if (validIc) {

                    checkExistingIc();
                }
                else {

                    nextButton.disabled =
                        false;
                }
            });
    </script>
}