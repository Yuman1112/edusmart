@model SecureSmartTuitionSystem.ViewModels.Enrollment.StudentDetailsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Student Details";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-4">
    <div class="col-md-10 col-lg-8">

        <partial name="_EnrollmentSteps" model="@(1)" />

        <div class="enrollment-card">

            <h1 class="mb-3">Student Details</h1>

            <p class="text-muted mb-4">
                Tell us about the student who will be attending classes.
            </p>

            @if (TempData["EnrollmentMessage"] is string enrollmentMessage)
            {
                <div class="alert alert-warning" role="alert">
                    @enrollmentMessage
                </div>
            }

            <form asp-controller="Enrollment"
                  asp-action="StudentDetails"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert">
                </div>

                <!-- ==========================================
                     STUDENT FULL NAME
                     ========================================== -->
                <div class="mb-3">

                    <label asp-for="StudentName"
                           class="form-label">
                    </label>

                    <input asp-for="StudentName"
                           class="form-control"
                           maxlength="100"
                           placeholder="As per birth certificate / IC"
                           autocomplete="off" />

                    <span asp-validation-for="StudentName"
                          class="text-danger">
                    </span>

                </div>

                <!-- ==========================================
                     IDENTIFICATION
                     ========================================== -->
                <!-- Identification Type -->
                <div class="mb-3">

                    <label asp-for="StudentIdentificationType"
                           class="form-label">
                    </label>

                    <select asp-for="StudentIdentificationType"
                            class="form-select"
                            id="studentIdentificationType">

                        <option value="IC">
                            IC Number
                        </option>

                        <option value="BirthCertificate">
                            Birth Certificate Number
                        </option>

                    </select>

                    <span asp-validation-for="StudentIdentificationType"
                          class="text-danger">
                    </span>

                </div>

                <!-- Identification Number -->
                <div class="mb-3">

                    <label asp-for="StudentIdentificationNumber"
                           class="form-label"
                           id="studentIdentificationNumberLabel">
                        IC Number
                    </label>

                    <input asp-for="StudentIdentificationNumber"
                           class="form-control"
                           maxlength="30"
                           placeholder="000000-00-0000"
                           autocomplete="off"
                           inputmode="numeric"
                           id="studentIdentificationNumber" />

                    <span asp-validation-for="StudentIdentificationNumber"
                          class="text-danger"
                          id="studentIdentificationNumberValidation">
                    </span>

                    <div id="studentIcValidation"
                         class="text-danger"
                         style="display: none;">
                    </div>

                    <div class="form-text"
                         id="studentIdentificationHelp">
                    </div>

                </div>

                <!-- ==========================================
                     DATE OF BIRTH + GENDER
                     ========================================== -->
                <div id="icAutoFillHelp"
                     class="form-text mb-2">
                    Date of birth and gender will be filled automatically from the IC number.
                </div>

                <div class="row">

                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="StudentDateOfBirth"
                               class="form-label">
                        </label>

                        <input asp-for="StudentDateOfBirth"
                               class="form-control"
                               type="date"
                               id="studentDateOfBirth"
                               max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="StudentDateOfBirth"
                              class="text-danger"
                              id="studentDateOfBirthValidation">
                        </span>

                        <div id="studentAgeValidation"
                             class="text-warning"
                             style="display: none;">
                        </div>

                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="StudentGender"
                               class="form-label">
                        </label>

                        <select asp-for="StudentGender"
                                class="form-select"
                                id="studentGender">

                            <option value="">
                                Select gender
                            </option>

                            <option value="Male">
                                Male
                            </option>

                            <option value="Female">
                                Female
                            </option>

                        </select>

                        <span asp-validation-for="StudentGender"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <!-- ==========================================
                     CURRENT SCHOOL
                     ========================================== -->
                <div class="mb-4">

                    <label asp-for="StudentSchool"
                           class="form-label">
                    </label>

                    <input asp-for="StudentSchool"
                           class="form-control"
                           maxlength="150"
                           placeholder="School name"
                           autocomplete="off" />

                    <span asp-validation-for="StudentSchool"
                          class="text-danger">
                    </span>

                </div>

                <!-- ==========================================
                     NAVIGATION
                     ========================================== -->
                <div class="enrollment-form-actions justify-content-end">

                    <button type="submit"
                            class="primary-button">

                        Next: Parent / Guardian Details

                        <i class="bi bi-arrow-right"></i>
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const typeSelect =
                    document.getElementById(
                        "studentIdentificationType");

                const numberInput =
                    document.getElementById(
                        "studentIdentificationNumber");

                const numberLabel =
                    document.getElementById(
                        "studentIdentificationNumberLabel");

                const helpText =
                    document.getElementById(
                        "studentIdentificationHelp");

                const dateOfBirthInput =
                    document.getElementById(
                        "studentDateOfBirth");

                const genderSelect =
                    document.getElementById(
                        "studentGender");

                const icAutoFillHelp =
                    document.getElementById(
                        "icAutoFillHelp");

                const ageValidation =
                    document.getElementById(
                        "studentAgeValidation");

                const dateOfBirthValidation =
                    document.getElementById(
                        "studentDateOfBirthValidation");

                const identificationValidation =
                    document.getElementById(
                        "studentIdentificationNumberValidation");

                const icValidation =
                    document.getElementById(
                        "studentIcValidation");

                function calculateAge(dateOfBirth) {

                    const today =
                        new Date();

                    let age =
                        today.getFullYear() -
                        dateOfBirth.getFullYear();

                    const monthDifference =
                        today.getMonth() -
                        dateOfBirth.getMonth();

                    if (
                        monthDifference < 0 ||
                        (
                            monthDifference === 0 &&
                            today.getDate() <
                            dateOfBirth.getDate()
                        )
                    ) {
                        age--;
                    }

                    return age;
                }

                function validateStudentAge() {

                    if (!dateOfBirthInput.value) {

                        ageValidation.textContent = "";
                        ageValidation.style.display = "none";

                        return true;
                    }

                    const dateOfBirth =
                        new Date(
                            dateOfBirthInput.value + "T00:00:00");

                    const age =
                        calculateAge(dateOfBirth);

                    if (age < 5 || age > 19) {

                        if (
                            dateOfBirthValidation &&
                            dateOfBirthValidation.textContent.trim() !== ""
                        ) {
                            ageValidation.textContent = "";
                            ageValidation.style.display = "none";
                        }
                        else {
                            ageValidation.textContent =
                                "The student's age is not within the supported range for Year 1 to Form 5.";

                            ageValidation.style.display =
                                "block";
                        }

                        return false;
                    }

                    ageValidation.textContent = "";
                    ageValidation.style.display = "none";

                    return true;
                }

                function formatIcNumber(value) {

                    let digits =
                        value.replace(/\D/g, "");

                    digits =
                        digits.substring(0, 12);

                    if (digits.length > 8) {

                        return (
                            digits.substring(0, 6) +
                            "-" +
                            digits.substring(6, 8) +
                            "-" +
                            digits.substring(8)
                        );
                    }

                    if (digits.length > 6) {

                        return (
                            digits.substring(0, 6) +
                            "-" +
                            digits.substring(6)
                        );
                    }

                    return digits;
                }

                function populateDetailsFromIc() {

                    if (typeSelect.value !== "IC") {
                        return;
                    }

                    const digits =
                        numberInput.value.replace(/\D/g, "");

                    if (digits.length !== 12) {

                        dateOfBirthInput.value = "";
                        genderSelect.value = "";

                        // Clear IC validation
                        icValidation.textContent = "";
                        icValidation.style.display = "none";

                        // Clear age validation
                        ageValidation.textContent = "";
                        ageValidation.style.display = "none";

                        return;
                    }

                    const yy =
                        parseInt(digits.substring(0, 2));

                    const mm =
                        parseInt(digits.substring(2, 4));

                    const dd =
                        parseInt(digits.substring(4, 6));

                    const currentYear =
                        new Date().getFullYear();

                    const currentTwoDigitYear =
                        currentYear % 100;

                    const fullYear =
                        yy <= currentTwoDigitYear
                            ? 2000 + yy
                            : 1900 + yy;

                    const date =
                        new Date(
                            fullYear,
                            mm - 1,
                            dd);

                    const validDate =
                        date.getFullYear() === fullYear &&
                        date.getMonth() === mm - 1 &&
                        date.getDate() === dd;

                        if (!validDate) {

                            dateOfBirthInput.value = "";
                            genderSelect.value = "";

                            // Clear any previous age warning
                            ageValidation.textContent = "";
                            ageValidation.style.display = "none";

                            if (
                                identificationValidation &&
                                identificationValidation.textContent.trim() !== ""
                            ) {
                                icValidation.textContent = "";
                                icValidation.style.display = "none";
                            }
                            else {
                                icValidation.textContent =
                                    "The IC number contains an invalid date of birth.";

                                icValidation.style.display =
                                    "block";
                            }

                            return;
                        }

                        icValidation.textContent = "";
                        icValidation.style.display = "none";

                    const month =
                        String(mm).padStart(2, "0");

                    const day =
                        String(dd).padStart(2, "0");

                    dateOfBirthInput.value =
                        `${fullYear}-${month}-${day}`;

                    validateStudentAge();

                    const lastDigit =
                        parseInt(
                            digits.charAt(11));

                    genderSelect.value =
                        lastDigit % 2 === 0
                            ? "Female"
                            : "Male";
                }

                // ==========================================
                // UPDATE IDENTIFICATION FIELD
                // ==========================================
                function updateIdentificationField() {

                    if (typeSelect.value === "IC") {

                        numberLabel.textContent =
                            "IC Number";

                        numberInput.placeholder =
                            "000000-00-0000";

                        numberInput.maxLength =
                            14;

                        numberInput.inputMode =
                            "numeric";

                        helpText.textContent =
                            "";

                        numberInput.value =
                            formatIcNumber(
                                numberInput.value);

                        dateOfBirthInput.readOnly =
                            true;

                        genderSelect.style.pointerEvents =
                            "none";

                        genderSelect.tabIndex =
                            -1;

                        icAutoFillHelp.hidden = 
                            false;

                        populateDetailsFromIc();
                    }
                    else {

                        numberLabel.textContent =
                            "Birth Certificate Number";

                        numberInput.placeholder =
                            "Enter birth certificate number";

                        numberInput.maxLength =
                            30;

                        numberInput.inputMode =
                            "text";

                        helpText.textContent =
                            "Enter the number exactly as shown on the birth certificate.";

                        dateOfBirthInput.readOnly =
                            false;

                        genderSelect.style.pointerEvents =
                            "";

                        genderSelect.tabIndex =
                            0;

                        icAutoFillHelp.hidden =
                            true;
                    }
                }

                // ==========================================
                // AUTO FORMAT WHILE USER TYPES
                // ==========================================
                numberInput.addEventListener(
                    "input",
                    function () {

                        if (typeSelect.value === "IC") {

                            this.value =
                                formatIcNumber(
                                    this.value);

                            populateDetailsFromIc();
                        }
                    });

                // ==========================================
                // IDENTIFICATION TYPE CHANGED
                // ==========================================
                typeSelect.addEventListener(
                    "change",
                    function () {

                        // Clear the old value
                        numberInput.value = "";
                        dateOfBirthInput.value = "";
                        genderSelect.value = "";

                        // Clear age validation message
                        ageValidation.textContent = "";
                        ageValidation.style.display = "none";

                        // Clear IC validation message
                        icValidation.textContent = "";
                        icValidation.style.display = "none";

                        updateIdentificationField();
                    });

                // ==========================================
                // BIRTH CERTIFICATE DOB AGE VALIDATION
                // ==========================================
                dateOfBirthInput.addEventListener(
                    "change",
                    function () {

                        if (typeSelect.value === "BirthCertificate") {

                            validateStudentAge();
                        }
                    });

                // ==========================================
                // INITIAL PAGE LOAD
                // ==========================================
                updateIdentificationField();

            });
    </script>
}