@model SecureSmartTuitionSystem.ViewModels.Enrollment.StudentDetailsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Student Details";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-4">
    <div class="col-md-10 col-lg-8">

        <partial name="_EnrollmentSteps" model="@(1)" />

        <div class="enrollment-card">

            <h1 class="mb-3">Student Details</h1>

            <p class="text-muted mb-4">
                Tell us about the student who will be attending classes.
            </p>

            @if (TempData["EnrollmentMessage"] is string enrollmentMessage)
            {
                <div class="alert alert-warning" role="alert">
                    @enrollmentMessage
                </div>
            }

            <form asp-controller="Enrollment"
                  asp-action="StudentDetails"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert">
                </div>

                <!-- ==========================================
                     STUDENT FULL NAME
                     ========================================== -->
                <div class="mb-3">

                    <label asp-for="StudentName"
                           class="form-label">
                    </label>

                    <input asp-for="StudentName"
                           class="form-control"
                           maxlength="100"
                           placeholder="Full name as per IC"
                           autocomplete="off" />

                    <span asp-validation-for="StudentName"
                          class="text-danger">
                    </span>

                </div>

                <!-- ==========================================
                     IDENTIFICATION NUMBER
                     ========================================== -->
                <div class="mb-3">

                    <label asp-for="StudentIdentificationNumber"
                           class="form-label">
                        IC Number
                    </label>

                    <input asp-for="StudentIdentificationNumber"
                           class="form-control"
                           maxlength="14"
                           placeholder="000000-00-0000"
                           autocomplete="off"
                           inputmode="numeric"
                           id="studentIdentificationNumber"
                           data-check-url="@Url.Action("CheckStudentIc", "Enrollment")" />

                    <span asp-validation-for="StudentIdentificationNumber"
                          class="text-danger"
                          id="studentIdentificationNumberValidation">
                    </span>

                </div>

                <!-- ==========================================
                     DATE OF BIRTH + GENDER
                     ========================================== -->
                <div class="form-text mb-2">
                    Date of birth and gender will be filled automatically from the IC number.
                </div>

                <div class="row">

                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="StudentDateOfBirth"
                               class="form-label">
                        </label>

                        <input asp-for="StudentDateOfBirth"
                               class="form-control"
                               type="date"
                               id="studentDateOfBirth"
                               readonly
                               max="@DateTime.UtcNow.AddHours(8).Date.AddDays(-1).ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="StudentDateOfBirth"
                              class="text-danger"
                              id="studentDateOfBirthValidation">
                        </span>

                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="StudentGender"
                               class="form-label">
                        </label>

                        <select asp-for="StudentGender"
                                class="form-select"
                                id="studentGender">

                            <option value="">
                                Select gender
                            </option>

                            <option value="Male">
                                Male
                            </option>

                            <option value="Female">
                                Female
                            </option>

                        </select>

                        <span asp-validation-for="StudentGender"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <!-- ==========================================
                     CURRENT SCHOOL
                     ========================================== -->
                <div class="mb-4">

                    <label asp-for="StudentSchool"
                           class="form-label">
                    </label>

                    <input asp-for="StudentSchool"
                           class="form-control"
                           maxlength="150"
                           placeholder="School name"
                           autocomplete="off" />

                    <span asp-validation-for="StudentSchool"
                          class="text-danger">
                    </span>

                </div>

                <!-- ==========================================
                    STUDENT EMAIL
                    ========================================== -->
                <!-- Student Email -->
                <div class="mb-3">

                    <label asp-for="StudentEmail"
                           class="form-label">
                        Student Email Address
                    </label>

                    <input asp-for="StudentEmail"
                           class="form-control"
                           type="email"
                           id="studentEmail"
                           maxlength="256"
                           autocomplete="email"
                           placeholder="student@example.com" />

                    <span asp-validation-for="StudentEmail"
                          class="text-danger">
                    </span>

                </div>

                <!-- No Student Email -->
                <div class="form-check mb-2 student-email-option">

                    <input asp-for="StudentHasNoEmail"
                           class="form-check-input"
                           id="studentHasNoEmail" />

                    <label asp-for="StudentHasNoEmail"
                           class="form-check-label">
                        Student does not have an email address
                    </label>

                </div>

                <div id="studentEmailHelp"
                     class="form-text mb-4"
                     hidden>
                    The student account setup link will be sent to the
                    primary parent / guardian's email address.
                </div>

                <!-- ==========================================
                     NAVIGATION
                     ========================================== -->
                <div class="enrollment-form-actions justify-content-end">

                    <button type="submit"
                            class="primary-button"
                            id="nextButton">

                        Next: Parent / Guardian Details

                        <i class="bi bi-arrow-right"></i>
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/enrollment-ic.js" asp-append-version="true"></script>
}