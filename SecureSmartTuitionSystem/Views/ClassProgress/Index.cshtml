@model SecureSmartTuitionSystem.ViewModels.Progress.ProgressIndex
@using System.Globalization
@{ViewData["Title"]=User.IsInRole("Admin")?"Class Progress Overview":"My Class Progress";}
@section Styles { <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/class-progress.css" asp-append-version="true"/> }
<div class="page-header"><div><h1>@ViewData["Title"]</h1><p>Track chapter coverage and teaching updates after each lesson.</p></div></div>
<section class="reports-card">
<div class="reports-filter-header">
    <h2><i class="bi bi-funnel" aria-hidden="true"></i> Filter Report</h2>
    <a class="reports-clear-filter" hidden="@(!Model.Filter.HasActiveFilters)" asp-action="Index"><i class="bi bi-x-circle" aria-hidden="true"></i> Clear Filters</a>
</div>
<form method="get" asp-action="Index" data-live-filter class="reports-filter-grid reports-filter-grid-three">
    <partial name="_ReportPeriodFields" model="Model.Filter" />
    <partial name="_ReportClassFilters" model="Model.ClassOptions" />
    <noscript><button class="primary-button" type="submit">Update Report</button></noscript>
</form>
<div class="reports-export-actions">
@foreach (var format in new[] { "pdf", "excel" })
{
    <a class="outline-button" asp-action="Export" download asp-route-format="@format"
       asp-route-Year="@Model.Filter.Year" asp-route-Month="@Model.Filter.Month" asp-route-EndMonth="@Model.Filter.EndMonth"
       asp-route-EducationStage="@Model.Filter.EducationStage" asp-route-AcademicLevel="@Model.Filter.AcademicLevel"
       asp-route-SubjectId="@Model.Filter.SubjectId" asp-route-TutorId="@Model.Filter.TutorId"
       asp-route-TutorSearch="@Model.Filter.TutorSearch" asp-route-Day="@Model.Filter.Day"
       asp-route-ClassId="@Model.Filter.ClassId">@(format == "pdf" ? "Export PDF" : "Export Excel")</a>
}
</div>
<p class="reports-note">Counts cover ended, non-cancelled lessons in the selected period. Missing means no progress was recorded by the two-hour deadline.</p></section>
<section class="reports-card"><div class="reports-table-wrap"><table class="table reports-table"><thead><tr><th>No.</th><th>Class Name</th><th>Subject &amp; Level</th><th>Tutor</th><th>Ended lessons</th><th>Recorded</th><th>Missing</th><th>Action</th></tr></thead><tbody>
@{int n=0;}@foreach(var r in Model.Rows){<tr><td>@(++n)</td><td><strong>@r.Name<br />@r.Schedule</strong></td><td><strong>@r.Subject</strong><div class="small text-muted">@r.Level</div></td><td>@r.Tutor</td><td>@r.Expected</td><td>@r.Submitted</td><td>@r.Missing</td><td><a class="outline-button" asp-action="Details" asp-all-route-data="@Model.Filter.RouteValues("overview.")" asp-route-id="@r.Id" asp-route-month="@Model.Filter.Start.Month" asp-route-endMonth="@Model.Filter.End.Month">View progress</a></td></tr>}
</tbody></table></div>@if(Model.Rows.Count==0){<p>No classes match these filters.</p>}</section>

@section Scripts { <script src="~/js/report-tutor-filter.js" asp-append-version="true" defer></script> }
