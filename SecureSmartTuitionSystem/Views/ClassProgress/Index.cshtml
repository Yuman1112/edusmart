@model SecureSmartTuitionSystem.ViewModels.Progress.ProgressIndex
@using System.Globalization
@{ViewData["Title"]=User.IsInRole("Admin")?"Class Progress Overview":"My Class Progress";}
@section Styles { <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/class-progress.css" asp-append-version="true"/> }
<div class="page-header"><div><h1>@ViewData["Title"]</h1><p>Track chapter coverage and teaching updates after each lesson.</p></div></div>
<section class="reports-card"><form method="get" asp-action="Index" data-live-filter class="reports-toolbar">
<div><label for="Year" class="form-label">Academic year</label><input id="Year" name="Year" type="number" min="2000" max="2100" value="@Model.Filter.Year" class="form-control"/></div>
<div><label for="Month" class="form-label">Lesson month</label><select id="Month" name="Month" class="form-select">@for(int m=1;m<=12;m++){<option value="@m" selected="@(m==Model.Filter.Month)">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>}</select></div>
<div><label for="SubjectId" class="form-label">Subject</label><select id="SubjectId" name="SubjectId" class="form-select"><option value="">All subjects</option>@foreach(var x in Model.Subjects){<option value="@x.Value" selected="@(x.Value==Model.Filter.SubjectId?.ToString())">@x.Text</option>}</select></div>
<div><label for="ClassId" class="form-label">Class</label><select id="ClassId" name="ClassId" class="form-select"><option value="">All classes</option>@foreach(var x in Model.Classes){<option value="@x.Value" selected="@(x.Value==Model.Filter.ClassId?.ToString())">@x.Text</option>}</select></div><button class="primary-button" type="submit">Apply</button></form>
<p class="reports-note">Coverage averages all configured subchapters equally, including 0% items. Lesson counts cover ended, non-cancelled lessons in the selected month from the outline's tracking start. Missing means no matching record after the two-hour deadline. Coverage is the current cumulative value, not a historical month-end snapshot.</p></section>
<section class="reports-card"><div class="reports-table-wrap"><table class="table reports-table"><thead><tr><th>No.</th><th>Class</th><th>Subject</th><th>Tutor</th><th>Coverage</th><th>Done</th><th>Ended lessons</th><th>Recorded</th><th>Missing</th><th>First submitted late</th><th>Action</th></tr></thead><tbody>
@{int n=0;}@foreach(var r in Model.Rows){<tr><td>@(++n)</td><td>@r.Code<br/>@r.Name</td><td>@r.Subject</td><td>@r.Tutor</td><td>@(r.Average.HasValue?r.Average.Value.ToString("0.0",CultureInfo.InvariantCulture)+"%":"Outline not configured")</td><td>@r.Done / @r.Topics</td><td>@r.Expected</td><td>@r.Submitted</td><td>@r.Missing</td><td>@r.Late</td><td><a class="outline-button" asp-action="Details" asp-route-id="@r.Id" asp-route-month="@Model.Filter.Month">View progress</a></td></tr>}
</tbody></table></div>@if(Model.Rows.Count==0){<p>No classes match these filters.</p>}</section>
