@model SecureSmartTuitionSystem.ViewModels.Progress.ProgressDetails
@using SecureSmartTuitionSystem.Services.Progress
@using SecureSmartTuitionSystem.Services.Enrollment
@using System.Globalization
@{ViewData["Title"]="Class Teaching Progress";var topics=Model.Syllabus?.Topics.OrderBy(t=>t.Chapter).ThenBy(t=>t.Subchapter).ToList()??[];var now=ClassScheduleService.Now;var version=Model.State==null?"":Convert.ToBase64String(Model.State.RowVersion);}
@{
    var overviewRoute = Model.OverviewFilter?.RouteValues() ?? new Dictionary<string, string>
    {
        ["Year"] = ClassScheduleService.FirstDate(Model.Class).Year.ToString(),
        ["Month"] = Model.Month.ToString(),
        ["EndMonth"] = Model.EndMonth.ToString()
    };
    var periodName = CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(Model.Month);
    if (Model.EndMonth != Model.Month)
        periodName += " – " + CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(Model.EndMonth);
}
@section Styles { <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/class-progress.css" asp-append-version="true"/> }
@section Scripts { <script src="~/js/class-progress.js" asp-append-version="true"></script> }
<div class="page-header"><div><h1>Class Teaching Progress</h1><p>@Model.Class.ClassCode · @Model.Class.ClassName</p><p>@Model.Class.Subject.SubjectName · @Model.Class.Subject.AcademicLevel · @Model.Class.TutorUser.FullName</p></div></div>
@if(TempData["ProgressError"] is string e){<div class="progress-alert" role="alert">@e</div>}
@if(TempData["ProgressSuccess"] is string ok){<div class="alert alert-success" role="status">@ok</div>}
<p><a class="outline-button" asp-action="Index" asp-all-route-data="@overviewRoute">← Back to overview</a>
@if(User.IsInRole("Admin")){<a class="outline-button" asp-action="Syllabus" asp-route-id="@Model.Class.ClassSessionId">Subject outline</a>}</p>
@if(Model.Syllabus==null){<section class="reports-card"><h2>Outline not configured</h2><p>Admin needs to configure the subject chapters and subchapters before teaching progress can be recorded.</p></section>}
else {
<section class="reports-card"><h2>Lesson records · @periodName @ClassScheduleService.FirstDate(Model.Class).Year</h2><form method="get" asp-action="Details" class="reports-toolbar"><input name="id" value="@Model.Class.ClassSessionId" type="hidden"/>@foreach (var item in Model.OverviewRoute) { <input type="hidden" name="@item.Key" value="@item.Value" /> }<label for="month">Month</label><select id="month" name="month" class="form-select">@for(int m=1;m<=12;m++){<option value="@m" selected="@(m==Model.Month)">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>}</select><button class="outline-button" type="submit">View month</button></form>
@if (Model.OverviewFilter is { } original && (original.Start.Month != Model.Month || original.End.Month != Model.EndMonth))
{
    <a class="outline-button" asp-action="Details" asp-all-route-data="@Model.OverviewRoute"
       asp-route-id="@Model.Class.ClassSessionId" asp-route-month="@original.Start.Month" asp-route-endMonth="@original.End.Month">View overview period</a>
}
<p class="reports-note">Update after the lesson ends, within two hours (MYT). Late updates remain available with a reason. Cancelled lessons are excluded; replacements use their actual scheduled time. Tracking begins @Model.Syllabus.TrackingFrom.ToString("dd MMM yyyy").</p>
<div class="reports-table-wrap"><table class="table reports-table"><thead><tr><th>No.</th><th>Lesson date</th><th>Time (MYT)</th><th>Type</th><th>Deadline</th><th>Status</th><th>Action</th></tr></thead><tbody>
@{int lessonNo=0;}@foreach(var l in Model.Lessons){var key=l.Replacement?l.ChangeId??0:0;var saved=Model.Records.FirstOrDefault(r=>r.LessonDate==l.Date&&r.ChangeKey==key);var changed=saved!=null&&!ProgressRules.Same(saved,l);var state=changed?"Schedule changed · read only":saved!=null?(saved.SubmittedLate?"Recorded late":ProgressRules.Late(saved.LessonDate,saved.End,saved.UpdatedAtUtc.AddHours(8))?"Recorded · late amendment":"Recorded"):l.Date.Add(l.End.ToTimeSpan())>now?"Upcoming / in progress":ProgressRules.Late(l.Date,l.End,now)?"Missing · overdue":"Awaiting update";
<tr><td>@(++lessonNo)</td><td>@l.Date.ToString("dd MMM yyyy")</td><td>@l.Start.ToString("HH:mm")–@l.End.ToString("HH:mm")</td><td>@(l.Replacement?"Replacement":"Regular")</td><td>@ProgressRules.Deadline(l.Date,l.End).ToString("dd MMM HH:mm")</td><td>@state</td><td><a class="outline-button" asp-action="Details" asp-all-route-data="@Model.PeriodRoute" asp-route-id="@Model.Class.ClassSessionId" asp-route-date="@l.Date.ToString("yyyy-MM-dd")" asp-route-key="@key">@(User.IsInRole("Admin")?"View":"Open")</a></td></tr>}
</tbody></table></div>@if(Model.Lessons.Count==0){<p>No tracked lessons in this period.</p>}</section>
<section class="reports-card"><h2>@(Model.Selected==null?"Current chapter coverage":"Lesson update · "+Model.Selected.Date.ToString("dd MMM yyyy"))</h2>
<p class="reports-note">Select a finished lesson above to update. Percentages are cumulative coverage, not marks or student achievement. Partial work can advance to 25%, 50%, 75% or 100%. Confirmed 100% items are locked; corrections require Admin and a recorded reason.</p>
@if(Model.IsLate&&Model.CanSave){<div class="progress-alert">The two-hour update deadline has passed. Enter a reason before saving this update.</div>}
@if(Model.Selected!=null&&!Model.CanSave&&!User.IsInRole("Admin")){<p>This lesson is not open for editing: it may not have finished, the class may be inactive, or the saved schedule/tutor has changed. Existing history remains available.</p>}
<form asp-action="Save" asp-all-route-data="@Model.PeriodRoute" method="post" id="progress-form"><input name="ClassId" value="@Model.Form.ClassId" type="hidden"/><input name="Date" value="@Model.Form.Date.ToString("yyyy-MM-dd")" type="hidden"/><input name="ChangeKey" value="@Model.Form.ChangeKey" type="hidden"/><input name="Version" value="@Model.Form.Version" type="hidden"/>
<div class="reports-table-wrap progress-grid-wrap"><table class="table reports-table progress-grid" data-pagination="off"><thead><tr><th>Chapter</th><th>Subchapter</th><th>Done</th><th>Coverage</th></tr></thead><tbody>
@for(int i=0;i<topics.Count;i++){var t=topics[i];var percent=Model.Progress.FirstOrDefault(p=>p.TopicId==t.Id)?.Percent??0;var locked=percent==100;
<tr class="@(locked?"progress-done":"")"><td>@t.Chapter · @t.ChapterTitle</td><td>@t.Chapter.@t.Subchapter · @t.Title<input type="hidden" name="Topics[@i].TopicId" value="@t.Id"/></td><td><input type="checkbox" class="progress-done-toggle" aria-label="Mark @t.Chapter.@t.Subchapter done" checked="@locked" disabled="@(!Model.CanSave||locked)"/></td><td>
@if(!Model.CanSave||locked){<input name="Topics[@i].Percent" value="@percent" type="hidden"/><span class="progress-value">@percent% @(locked?"· Done · Locked":"")</span>}
else{<select name="Topics[@i].Percent" class="form-select progress-percent" data-initial="@percent" aria-label="Coverage for @t.Chapter.@t.Subchapter">@foreach(int p in new[]{0,25,50,75,100}){<option value="@p" selected="@(p==percent)" disabled="@(p<percent)">@(p==0?"Not started · 0%":p==100?"Done · 100%":p+"%")</option>}</select>}
</td></tr>}
</tbody></table></div>
@if(Model.CanSave){<div class="progress-notes"><label for="Notes" class="form-label">What was covered this lesson?</label><textarea id="Notes" name="Notes" class="form-control" maxlength="500" minlength="3" required rows="3">@Model.Form.Notes</textarea><p>Revision lessons can be recorded with a summary and no percentage change.</p>
@if(Model.IsLate){<label for="LateReason" class="form-label">Late update reason</label><textarea id="LateReason" name="LateReason" class="form-control" minlength="10" maxlength="500" required rows="2"></textarea>}
<label class="progress-confirm"><input name="ConfirmCompleted" type="checkbox" value="true"/> I confirm that newly completed (100%) subchapters will be locked after saving.</label><button class="primary-button" type="submit">Save lesson progress</button></div>}
</form>
@if(User.IsInRole("Admin")&&Model.State!=null){<details class="progress-admin"><summary>Correct / reopen a subchapter</summary><p>Completed items reopen at 75%. Partial values can also be corrected. Original lesson history is retained.</p><form asp-action="Reopen" asp-all-route-data="@Model.PeriodRoute" method="post" class="reports-toolbar"><input name="ClassId" value="@Model.Class.ClassSessionId" type="hidden"/><input name="Version" value="@version" type="hidden"/><div><label for="TopicId">Subchapter</label><select id="TopicId" name="TopicId" class="form-select">@foreach(var t in topics.Where(t=>Model.Progress.Any(p=>p.TopicId==t.Id))){<option value="@t.Id">@t.Chapter.@t.Subchapter · @t.Title</option>}</select></div><div><label for="TargetPercent">Corrected coverage</label><select id="TargetPercent" name="TargetPercent" class="form-select">@foreach(int p in new[]{0,25,50,75}){<option value="@p" selected="@(p==75)">@p%</option>}</select></div><div><label for="Reason">Correction reason</label><textarea id="Reason" name="Reason" class="form-control" minlength="10" maxlength="500" required></textarea></div><button class="outline-button" type="submit">Save correction</button></form></details>}
</section>
}
<section class="reports-card"><h2>Teaching &amp; correction history</h2>
@if(Model.Selected!=null){<p><a asp-action="Details" asp-all-route-data="@Model.PeriodRoute" asp-route-id="@Model.Class.ClassSessionId">View all class history</a></p>}<p class="reports-note">Updates are shown newest first, 25 per page. Selecting a lesson shows that lesson’s updates. No percentage change means a revision / summary-only update. Admin corrections do not rewrite previous lessons.</p><div class="reports-table-wrap"><table class="table reports-table" data-pagination="off"><thead><tr><th>No.</th><th>Recorded (MYT)</th><th>Lesson</th><th>Subchapter</th><th>Change</th><th>Actor</th><th>Summary / correction reason</th><th>Late reason</th></tr></thead><tbody>@{int hno=(Model.HistoryPage-1)*25;}@foreach(var h in Model.History){<tr><td>@(++hno)</td><td>@h.RecordedAtUtc.AddHours(8).ToString("dd MMM yyyy HH:mm")</td><td>@(h.LessonRecord==null?"Admin correction":h.LessonRecord.LessonDate.ToString("dd MMM yyyy"))</td><td>@(h.Topic==null?"Summary only":h.Topic.Chapter+"."+h.Topic.Subchapter+" · "+h.Topic.Title)</td><td>@(h.Before.HasValue?h.Before+"% → "+h.After+"%":"No percentage change")</td><td>@Model.Actors.GetValueOrDefault(h.ActorUserId,"Former account")</td><td>@h.Note</td><td>@h.LateReason</td></tr>}</tbody></table></div></section>

<nav class="progress-history-pages" aria-label="Teaching history pages"><span>@Model.HistoryTotal history entries · 25 per page</span>
@foreach(var paging in new[]{("First",1),("Previous",Math.Max(1,Model.HistoryPage-1)),(Model.HistoryPage.ToString(),Model.HistoryPage),("Next",Math.Min(Model.HistoryPages,Model.HistoryPage+1)),("Last",Model.HistoryPages)}){
<a class="outline-button" asp-action="Details" asp-all-route-data="@Model.PeriodRoute" asp-route-id="@Model.Class.ClassSessionId" asp-route-date="@Model.Selected?.Date.ToString("yyyy-MM-dd")" asp-route-key="@Model.Form.ChangeKey" asp-route-historyPage="@paging.Item2">@paging.Item1</a>}
</nav>
