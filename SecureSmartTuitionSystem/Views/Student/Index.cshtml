@model SecureSmartTuitionSystem.ViewModels.Student.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/learner-dashboard.css" asp-append-version="true" />
}
<div class="learner-dashboard">
    <header class="learner-welcome">
        <div>
            <span class="learner-eyebrow">MY LEARNING SPACE</span>
            <h1>Hello, @Model.StudentName</h1>
            <p>Your classes and learning essentials, in one place.</p>
            <div class="learner-identity"><span>@Model.StudentUserName</span><span>@Model.AcademicLevel</span>@if (!string.IsNullOrWhiteSpace(Model.School)) {
            <span>@Model.School</span>
                        }
</div>
        </div>
        <a asp-controller="LearningClasses" asp-action="Index" class="learner-button"><i class="bi bi-calendar-week" aria-hidden="true"></i> My Class Schedule <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </header>
    <div class="learner-content-grid">
        <section class="learner-panel">
            <div class="learner-section-heading"><div><h2>My Classes</h2><p>Your currently accessible classes.</p></div><span class="learner-count">@Model.ActiveClassCount active</span></div>
            @if (Model.Classes.Count == 0)
            {
                <div class="learner-empty"><i class="bi bi-journal-bookmark" aria-hidden="true"></i><h3>Your classes will appear here</h3><p>No classes are currently open. Class access starts on your enrollment start date.</p><a asp-controller="LearningClasses" asp-action="Index" class="learner-text-link">View enrollment &amp; schedules <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
            }
            else
            {
                <div class="learner-class-list">
                    @foreach (var item in Model.Classes)
                    {
                        <article class="learner-class-row"><div class="learner-row-icon"><i class="bi bi-book" aria-hidden="true"></i></div><div class="learner-row-content"><h3>@item.SubjectName</h3><p>@item.ClassName</p><span class="learner-schedule"><i class="bi bi-clock" aria-hidden="true"></i> @item.Day · @item.StartTime–@item.EndTime</span></div><span class="learner-code">@item.ClassCode</span></article>
                    }
                </div>
            }
        </section>
        <aside class="learner-shortcuts" aria-label="Student shortcuts">
            <a asp-controller="Attendance" asp-action="Report" class="learner-shortcut"><span class="learner-shortcut-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span><h2>My Attendance</h2><p>View your records and request a correction when needed.</p><span class="learner-text-link">View attendance <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a>
            <a asp-controller="Announcements" asp-action="Index" class="learner-shortcut"><span class="learner-shortcut-icon"><i class="bi bi-megaphone" aria-hidden="true"></i></span><h2>Announcements</h2><p>Read the latest updates from your tuition centre.</p><span class="learner-text-link">Read updates <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a>
        </aside>
    </div>
</div>
