@model SecureSmartTuitionSystem.ViewModels.Attendance.AttendanceCorrectionListViewModel
@using SecureSmartTuitionSystem.Models.Attendance
@{
    ViewData["Title"] = "Correction Requests";
    var statuses = new Dictionary<string,string> { ["review"]="Pending Admin Review", ["confirmation"]="Waiting Tutor Confirmation", ["pending"]="All Pending", ["approved"]="Approved", ["rejected"]="Rejected", ["all"]="All Statuses" };
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/attendance.css" asp-append-version="true" />
}
<div class="attendance-page attendance-unified-list" data-correction-page>
    <div class="page-header"><div><h1>Correction Requests</h1><p>@(Model.IsAdmin ? "Review requests and ask the lesson tutor for confirmation when needed." : Model.IsTutor ? "Respond to Admin confirmation requests and track your own corrections." : "Track your correction requests and administrative review.")</p></div>
        @if (!Model.IsAdmin && !Model.IsTutor) { <a asp-controller="Attendance" asp-action="Report" class="outline-button">Back to Records</a> }
    </div>
    @foreach (var key in new[] { "AttendanceCorrectionSuccess", "AttendanceCorrectionError" }) {
        if (TempData[key] is string message) { <div class="alert @(key.EndsWith("Error") ? "alert-danger" : "alert-success")" role="status">@message</div> }
    }
    <div class="alert" data-correction-feedback role="status" hidden></div>
    <form asp-action="Index" method="get" data-live-filter class="class-filter-card">
        <input type="hidden" name="sort" value="@Model.Sort" />
        <div class="class-filter-heading"><div><h2><i class="bi bi-funnel" aria-hidden="true"></i> Filter Correction Requests</h2><p>Filter requests; the list also checks for updates every 8 seconds.</p></div><a asp-action="Index" asp-route-status="all" class="clear-filter-link"><i class="bi bi-x-circle" aria-hidden="true"></i> Clear Filters</a></div>
        <div class="class-filter-grid">
            <div><label for="correction-search" class="form-label">Search Student / Class</label><input id="correction-search" name="search" value="@Model.Search" maxlength="100" class="form-control auto-filter" placeholder="Student name, ID or class code" /></div>
            <div><label for="correction-status" class="form-label">Request Status</label><select id="correction-status" name="status" class="form-select auto-filter">@foreach (var option in statuses) { <option value="@option.Key" selected="@(Model.Status == option.Key)">@option.Value</option> }</select></div>
            <div><label for="correction-from" class="form-label">Submitted From</label><input id="correction-from" name="from" type="date" value='@Model.From?.ToString("yyyy-MM-dd")' class="form-control auto-filter" /></div>
            <div><label for="correction-to" class="form-label">Submitted To</label><input id="correction-to" name="to" type="date" value='@Model.To?.ToString("yyyy-MM-dd")' class="form-control auto-filter" /></div>
        </div><noscript><button type="submit" class="primary-button mt-3">View Requests</button></noscript>
    </form>
    <partial name="_CorrectionResults" model="Model" />
    <p class="text-muted small mt-3" data-correction-live-status role="status">Requests update automatically while this page is visible.</p>
</div>
@section Scripts { <script src="~/js/attendance-correction-confirmation.js" asp-append-version="true"></script> }
