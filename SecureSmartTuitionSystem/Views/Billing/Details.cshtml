@model SecureSmartTuitionSystem.ViewModels.Billing.BillDetailsViewModel
@using SecureSmartTuitionSystem.Models.Billing

@{
    ViewData["Title"] = $"Bill {Model.BillNumber}";

    string StatusText(BillStatus status)
    {
        return status switch
        {
            BillStatus.PendingPayment => "Pending Payment",
            BillStatus.Paid => "Paid",
            BillStatus.Overdue => "Overdue",
            BillStatus.Cancelled => "Cancelled",
            BillStatus.Refunded => "Refunded",
            _ => status.ToString()
        };
    }

    string StatusClass(BillStatus status)
    {
        return status switch
        {
            BillStatus.PendingPayment => "billing-status pending",
            BillStatus.Paid => "billing-status paid",
            BillStatus.Overdue => "billing-status overdue",
            BillStatus.Cancelled => "billing-status cancelled",
            BillStatus.Refunded => "billing-status refunded",
            _ => "billing-status"
        };
    }

    string PaymentStatusText(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "Pending",
            PaymentStatus.Succeeded => "Succeeded",
            PaymentStatus.Failed => "Failed",
            PaymentStatus.Cancelled => "Cancelled",
            PaymentStatus.Refunded => "Refunded",
            _ => status.ToString()
        };
    }

    string PaymentStatusClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending =>
                "billing-status pending",

            PaymentStatus.Succeeded =>
                "billing-status paid",

            PaymentStatus.Failed =>
                "billing-status cancelled",

            PaymentStatus.Cancelled =>
                "billing-status cancelled",

            PaymentStatus.Refunded =>
                "billing-status refunded",

            _ => "billing-status"
        };
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/billing.css"
          asp-append-version="true" />
}

<div class="billing-page">
    <header class="billing-page-header billing-details-header">
        <div>
            <a asp-controller="Billing"
               asp-action="Index"
               class="billing-back-link">

                <i class="bi bi-arrow-left"></i>
                Back to Bills
            </a>

            <h1>Bill @Model.BillNumber</h1>

            <p>
                Application @Model.ApplicationNumber
            </p>
        </div>

        <div class="billing-header-actions">
            <span class="@StatusClass(Model.Status)">
                @StatusText(Model.Status)
            </span>

            @if (Model.Status == BillStatus.PendingPayment ||
                        Model.Status == BillStatus.Overdue)
            {
                <a asp-controller="Payments"
                   asp-action="OpenBill"
                   asp-route-id="@Model.BillId"
                   class="payment-link-button">

                    <i class="bi bi-credit-card"></i>
                    Open Payment Page
                </a>
            }
        </div>
    </header>

    <section class="billing-detail-grid">
        <article class="billing-detail-card">
            <div class="billing-section-title">
                <i class="bi bi-receipt"></i>
                <h2>Bill Information</h2>
            </div>

            <dl class="billing-information-list">
                <div>
                    <dt>Bill Number</dt>
                    <dd>@Model.BillNumber</dd>
                </div>

                <div>
                    <dt>Application</dt>
                    <dd>
                        <a asp-controller="AdminEnrollments"
                           asp-action="Details"
                           asp-route-id="@Model.EnrollmentApplicationId">
                            @Model.ApplicationNumber
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>Due Date</dt>
                    <dd>
                        @(Model.DueAt
                         .ToLocalTime()
                         .ToString("dd MMM yyyy"))
                    </dd>
                </div>

                <div>
                    <dt>Due Date</dt>
                    <dd>
                        @(Model.DueAt
                        .ToLocalTime()
                        .ToString("dd MMM yyyy"))
                    </dd>
                </div>

                <div>
                    <dt>Duration</dt>
                    <dd>
                        @Model.EnrollmentDurationMonths month(s)
                    </dd>
                </div>

                <div>
                    <dt>Academic Level</dt>
                    <dd>@Model.AcademicLevel</dd>
                </div>
            </dl>
        </article>

        <article class="billing-detail-card">
            <div class="billing-section-title">
                <i class="bi bi-people"></i>
                <h2>Applicant Information</h2>
            </div>

            <dl class="billing-information-list">
                <div>
                    <dt>Student</dt>
                    <dd>@Model.StudentName</dd>
                </div>

                <div>
                    <dt>Guardian</dt>
                    <dd>@Model.GuardianName</dd>
                </div>

                <div>
                    <dt>Email</dt>
                    <dd>@Model.GuardianEmail</dd>
                </div>

                <div>
                    <dt>Phone</dt>
                    <dd>@Model.GuardianPhoneNumber</dd>
                </div>
            </dl>
        </article>
    </section>

    <section class="billing-detail-card billing-items-card">
        <div class="billing-section-title">
            <i class="bi bi-list-ul"></i>
            <h2>Bill Items</h2>
        </div>

        <div class="billing-table-wrapper">
            <table class="billing-table billing-item-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th>Unit Amount</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.Description</strong>
                            </td>

                            <td>@item.Quantity</td>

                            <td>
                                RM @item.UnitAmount.ToString("F2")
                            </td>

                            <td class="billing-amount
                                           @(item.LineTotal < 0
                                                                           ? "discount"
                                                                           : "")">
                            RM @item.LineTotal.ToString("F2")
                        </td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>

        <div class="billing-total-panel">
            <div>
                <span>Tuition Subtotal</span>
                <strong>
                    RM @Model.TuitionSubtotal.ToString("F2")
                </strong>
            </div>

            @if (Model.TuitionDiscountAmount > 0)
            {
                <div>
                    <span>
                        Tuition Discount
                        (@Model.TuitionDiscountRate.ToString("F0")%)
                    </span>

                    <strong class="discount">
                        − RM @Model.TuitionDiscountAmount.ToString("F2")
                    </strong>
                </div>
            }

            @if (Model.HardcopyFee > 0)
            {
                <div>
                    <span>Hardcopy Materials</span>
                    <strong>
                        RM @Model.HardcopyFee.ToString("F2")
                    </strong>
                </div>
            }

            @if (Model.DeliveryFee > 0)
            {
                <div>
                    <span>Delivery Fee</span>
                    <strong>
                        RM @Model.DeliveryFee.ToString("F2")
                    </strong>
                </div>
            }

            <div class="billing-grand-total">
                <span>Total Amount</span>
                <strong>
                    RM @Model.TotalAmount.ToString("F2")
                </strong>
            </div>
        </div>
    </section>

    @if (Model.HardcopyMaterialsRequested)
    {
        <section class="billing-detail-card">
            <div class="billing-section-title">
                <i class="bi bi-credit-card"></i>
                <h2>Payment History</h2>
            </div>

            @if (Model.Payments.Count == 0)
            {
                <div class="billing-empty-payment">
                    <i class="bi bi-clock-history"></i>
                    <p>No payment attempt has been made.</p>
                </div>
            }
            else
            {
                <div class="billing-table-wrapper">
                    <table class="billing-table">
                        <thead>
                            <tr>
                                <th>Payment</th>
                                <th>Provider</th>
                                <th class="billing-number-column">
                                    Amount
                                </th>
                                <th>Created</th>
                                <th>Completed</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @payment.PaymentNumber
                                        </strong>
                                    </td>

                                    <td>
                                        @payment.PaymentProvider
                                    </td>

                                    <td class="billing-amount">
                                        @payment.Currency
                                        @payment.Amount.ToString("F2")
                                    </td>

                                    <td>
                                        @payment.CreatedAt
                                        .ToLocalTime()
                                        .ToString(
                                        "dd MMM yyyy, hh:mm tt")
                                    </td>

                                    <td>
                                        @(payment.CompletedAt.HasValue
                                                                    ? payment.CompletedAt.Value
                                                                    .ToLocalTime()
                                                                    .ToString(
                                                                    "dd MMM yyyy, hh:mm tt")
                                                                    : "—")
                        </td>

                                    <td>
                                        <span class="@PaymentStatusClass(
                                                                      payment.Status)">
                                @PaymentStatusText(
                                                                payment.Status)
                            </span>
                        </td>
                    </tr>

                    @if (!string.IsNullOrWhiteSpace(
                                        payment.FailureReason))
                                {
                                    <tr class="billing-failure-row">
                                        <td colspan="6">
                                            <strong>
                                                Failure reason:
                                            </strong>

                                            @payment.FailureReason
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <section class="billing-detail-card">
        <div class="billing-section-title">
            <i class="bi bi-credit-card"></i>
            <h2>Payment History</h2>
        </div>

        @if (Model.Payments.Count == 0)
        {
            <div class="billing-empty-payment">
                <i class="bi bi-clock-history"></i>

                <p>
                    No payment attempt has been made.
                </p>
            </div>
        }
        else
        {
            <div class="billing-table-wrapper">
                <table class="billing-table">

                    <thead>
                        <tr>
                            <th>Payment</th>
                            <th>Provider</th>
                            <th>Amount</th>
                            <th>Created</th>
                            <th>Completed</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @payment.PaymentNumber
                                    </strong>
                                </td>

                                <td>
                                    @payment.PaymentProvider
                                </td>

                                <td class="billing-amount">
                                    @payment.Currency
                                    @payment.Amount.ToString("F2")
                                </td>
                                <td>
                                    @(payment.CompletedAt.HasValue
                                        ? payment.CompletedAt.Value
                                        .ToLocalTime()
                                        .ToString(
                                        "dd MMM yyyy, hh:mm tt")
                                        : "—")
                                </td>

                                <td>
                                    @(payment.CompletedAt.HasValue
                                        ? payment.CompletedAt.Value
                                        .ToLocalTime()
                                        .ToString(
                                        "dd MMM yyyy, hh:mm tt")
                                        : "—")
                        </td>

                                <td>
                                    <span class="@PaymentStatusClass(
                                                                      payment.Status)">

                                @PaymentStatusText(
                                                                payment.Status)
                            </span>
                        </td>
                    </tr>

                    @if (!string.IsNullOrWhiteSpace(
                                        payment.FailureReason))
                            {
                                <tr class="billing-failure-row">
                                    <td colspan="6">
                                        <strong>
                                            Failure reason:
                                        </strong>

                                        @payment.FailureReason
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        }
    </section>
</div>