@model SecureSmartTuitionSystem.ViewModels.Billing.BillDetailsViewModel
@using SecureSmartTuitionSystem.Models.Billing

@{
    ViewData["Title"] = "Billing Details";

    string StatusText(BillStatus status)
    {
        return status switch
        {
            BillStatus.PendingPayment => "Pending Payment",
            BillStatus.Paid => "Paid",
            BillStatus.Overdue => "Overdue",
            BillStatus.Cancelled => "Cancelled",
            BillStatus.Refunded => "Refunded",
            _ => status.ToString()
        };
    }

    string StatusClass(BillStatus status)
    {
        return status switch
        {
            BillStatus.PendingPayment => "billing-status pending",
            BillStatus.Paid => "billing-status paid",
            BillStatus.Overdue => "billing-status overdue",
            BillStatus.Cancelled => "billing-status cancelled",
            BillStatus.Refunded => "billing-status refunded",
            _ => "billing-status"
        };
    }

    string PaymentStatusText(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "Pending",
            PaymentStatus.Succeeded => "Succeeded",
            PaymentStatus.Failed => "Failed",
            PaymentStatus.Cancelled => "Cancelled",
            PaymentStatus.Refunded => "Refunded",
            _ => status.ToString()
        };
    }

    string PaymentStatusClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending =>
                "billing-status pending",

            PaymentStatus.Succeeded =>
                "billing-status paid",

            PaymentStatus.Failed =>
                "billing-status cancelled",

            PaymentStatus.Cancelled =>
                "billing-status cancelled",

            PaymentStatus.Refunded =>
                "billing-status refunded",

            _ => "billing-status"
        };
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/billing.css"
          asp-append-version="true" />
}

<div class="billing-page">
    <header class="billing-page-header billing-details-header">
        <div class="billing-details-title">
            <h1>Billing Details</h1>
            <p>@Model.StudentName · @Model.AcademicLevel</p>
        </div>

        <div class="billing-header-actions">
            <span class="@StatusClass(Model.Status)">
                @StatusText(Model.Status)
            </span>

            @if (User.IsInRole("Parent") &&
                        (Model.Status == BillStatus.PendingPayment ||
                        Model.Status == BillStatus.Overdue))
            {
                <form asp-controller="Payments" asp-action="OpenBill" method="post">
                    <input type="hidden" name="id" value="@Model.BillId" />
                    <button type="submit" class="payment-link-button">

                    <i class="bi bi-credit-card"></i>
                    Make Payment
                    </button>
                </form>
            }
            else if ((User.IsInRole("Admin") ||
            User.IsInRole("Student")) &&
            (Model.Status == BillStatus.PendingPayment ||
            Model.Status == BillStatus.Overdue))
            {
                <span class="billing-status pending">
                    Awaiting Parent Payment
                </span>
            }

            <a asp-controller="Billing"
               asp-action="Index"
               class="billing-back-button">

                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
    </header>

    <section class="billing-detail-grid">
        <article class="billing-detail-card">
            <div class="billing-section-title">
                <i class="bi bi-receipt"></i>
                <h2>Billing Information</h2>
            </div>

            <dl class="billing-information-list">
                <div>
                    <dt>Issued Date</dt>
                    <dd>
                        @(Model.IssuedAt
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy"))
                    </dd>
                </div>

                <div>
                    <dt>Due Date</dt>
                    <dd>
                        @(Model.DueAt
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy"))
                    </dd>
                </div>

                <div>
                    <dt>Duration</dt>
                    <dd>
                        @Model.EnrollmentDurationMonths month(s)
                    </dd>
                </div>

                <div>
                    <dt>Academic Level</dt>
                    <dd>@Model.AcademicLevel</dd>
                </div>

                @if (Model.PaidAt.HasValue)
                {
                    <div>
                        <dt>Paid Date</dt>
                        <dd>
                            @(Model.PaidAt.Value
                                                    .ToLocalTime()
                                                    .ToString("dd MMM yyyy, hh:mm tt"))
                    </dd>
                </div>
                                }
            </dl>
        </article>

        <article class="billing-detail-card">
            <div class="billing-section-title">
                <i class="bi bi-people"></i>
                <h2>Applicant Information</h2>
            </div>

            <dl class="billing-information-list">
                <div>
                    <dt>Student</dt>
                    <dd>@Model.StudentName</dd>
                </div>

                <div>
                    <dt>Guardian</dt>
                    <dd>@Model.GuardianName</dd>
                </div>

                <div>
                    <dt>Email</dt>
                    <dd>@Model.GuardianEmail</dd>
                </div>

                <div>
                    <dt>Phone</dt>
                    <dd>@Model.GuardianPhoneNumber</dd>
                </div>
            </dl>
        </article>
    </section>

    <section class="billing-detail-card billing-items-card">
        <div class="billing-section-title">
            <i class="bi bi-list-ul"></i>
            <h2>Bill Items</h2>
        </div>

        <div class="billing-table-wrapper">
            <table class="billing-table billing-item-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th>Unit Amount</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@item.Description</strong>
                            </td>

                            <td>@item.Quantity</td>

                            <td>
                                <span class="currency-amount">
                                    <span class="currency-code">RM</span>
                                    <span class="currency-value">
                                        @item.UnitAmount.ToString("F2")
                                    </span>
                                </span>
                            </td>

                            <td class="billing-amount @(item.LineTotal < 0 ? "discount" : "")">
                                <span class="currency-amount">
                                    <span class="currency-code">RM</span>
                                    <span class="currency-value">
                                        @item.LineTotal.ToString("F2")
                                    </span>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="billing-total-panel">
            <div>
                <span>Tuition Subtotal</span>
                <strong class="currency-amount">
                    <span class="currency-code">RM</span>
                    <span class="currency-value">
                        @Model.TuitionSubtotal.ToString("F2")
                    </span>
                </strong>
            </div>

            @if (Model.TuitionDiscountAmount > 0)
            {
                <div>
                    <span>
                        Tuition Discount
                        (@Model.TuitionDiscountRate.ToString("F0")%)
                    </span>

                    <strong class="currency-amount discount">
                        <span class="currency-code">RM</span>
                        <span class="currency-value">
                            −@Model.TuitionDiscountAmount.ToString("F2")
                        </span>
                    </strong>
                </div>
            }

            @if (Model.HardcopyFee > 0)
            {
                <div>
                    <span>Hardcopy Materials</span>
                    <strong class="currency-amount">
                        <span class="currency-code">RM</span>
                        <span class="currency-value">
                            @Model.HardcopyFee.ToString("F2")
                        </span>
                    </strong>
                </div>
            }

            @if (Model.DeliveryFee > 0)
            {
                <div>
                    <span>Delivery Fee</span>
                    <strong class="currency-amount">
                        <span class="currency-code">RM</span>
                        <span class="currency-value">
                            @Model.DeliveryFee.ToString("F2")
                        </span>
                    </strong>
                </div>
            }

            <div class="billing-grand-total">
                <span>Total Amount</span>
                <strong class="currency-amount">
                    <span class="currency-code">RM</span>
                    <span class="currency-value">
                        @Model.TotalAmount.ToString("F2")
                    </span>
                </strong>
            </div>
        </div>
    </section>

    <section class="billing-detail-card">
        <div class="billing-section-title">
            <i class="bi bi-credit-card"></i>
            <h2>Payment Activity</h2>
        </div>

        @if (Model.Payments.Count == 0)
        {
            <div class="billing-empty-payment">
                <i class="bi bi-clock-history"></i>

                <p>
                    No payment attempt has been made.
                </p>
            </div>
        }
        else
        {
            <div class="billing-table-wrapper">
                <table class="billing-table billing-payment-table">

                    <thead>
                        <tr>
                            <th>Provider</th>
                            <th>Amount</th>
                            <th>Created</th>
                            <th>Completed</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td>
                                    @payment.PaymentProvider
                                </td>
                                <td class="billing-amount">
                                    <span class="currency-amount">
                                        <span class="currency-code">RM</span>
                                        <span class="currency-value">
                                            @payment.Amount.ToString("F2")
                                        </span>
                                    </span>
                                </td>
                                <td>
                                    @(payment.CreatedAt
                                                                .ToLocalTime()
                                                                .ToString(
                                                                "dd MMM yyyy, hh:mm tt"))
                                                                                     </td>

                                <td>
                                    @(payment.CompletedAt.HasValue
                                                                ? payment.CompletedAt.Value
                                                                .ToLocalTime()
                                                                .ToString(
                                                                "dd MMM yyyy, hh:mm tt")
                                                                : "—")
                        </td>

                                <td>
                                    <span class="@PaymentStatusClass(payment.Status)">
                                        @PaymentStatusText(payment.Status)
                                    </span>
                                </td>

                                <td>
                            @if (payment.Status == PaymentStatus.Succeeded)
                                    {
                                        <a asp-controller="Payments"
                                           asp-action="Receipt"
                                           asp-route-id="@payment.PaymentId"
                                           class="billing-details-button">

                                            <i class="bi bi-receipt"></i>
                                            View Receipt
                                        </a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>

                            @if (!string.IsNullOrWhiteSpace(
                                                payment.FailureReason))
                            {
                                <tr class="billing-failure-row">
                                    <td colspan="6">
                                        <strong>
                                            Failure reason:
                                        </strong>

                                        @payment.FailureReason
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        }
    </section>
</div>

<div class="class-details-card mt-3"><h2>Withdrawals and refunds</h2><p>The original paid bill and receipt are retained. Refund approval, provider status and withdrawal dates are recorded separately.</p><a class="btn btn-outline-primary" asp-controller="EnrollmentExits" asp-action="Index">View withdrawals &amp; refunds</a></div>
