@model SecureSmartTuitionSystem.ViewModels.Billing.BillingIndexViewModel
@using SecureSmartTuitionSystem.Models.Billing

@{
    ViewData["Title"] = "Payment & Billing";

    string StatusText(BillStatus status)
    {
        return status switch
        {
            BillStatus.PendingPayment => "Pending Payment",
            BillStatus.Paid => "Paid",
            BillStatus.Overdue => "Overdue",
            BillStatus.Cancelled => "Cancelled",
            BillStatus.Refunded => "Refunded",
            _ => status.ToString()
        };
    }

    string StatusClass(BillStatus status)
    {
        return status switch
        {
            BillStatus.PendingPayment => "billing-status pending",
            BillStatus.Paid => "billing-status paid",
            BillStatus.Overdue => "billing-status overdue",
            BillStatus.Cancelled => "billing-status cancelled",
            BillStatus.Refunded => "billing-status refunded",
            _ => "billing-status"
        };
    }

    string NextDirection(string column)
    {
        return Model.SortBy == column &&
               Model.SortDirection == "asc"
            ? "desc"
            : "asc";
    }

    string SortIcon(string column)
    {
        if (Model.SortBy != column)
        {
            return "bi-arrow-down-up";
        }

        return Model.SortDirection == "asc"
            ? "bi-sort-up"
            : "bi-sort-down";
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/billing.css"
          asp-append-version="true" />
}

<div class="billing-page">
    <header class="billing-page-header">
        <div>
            <h1>Payment &amp; Billing</h1>
            <p>
                Review bills and monitor payment status.
            </p>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success billing-alert"
             role="alert">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger billing-alert"
             role="alert">
            <i class="bi bi-exclamation-circle"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <section class="billing-summary-grid">
        <article class="billing-summary-card">
            <div class="billing-summary-icon total">
                <i class="bi bi-receipt"></i>
            </div>

            <div>
                <span>Total Bills</span>
                <strong>@Model.TotalBillCount</strong>
            </div>
        </article>

        <article class="billing-summary-card">
            <div class="billing-summary-icon pending">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <span>Pending</span>
                <strong>@Model.PendingBillCount</strong>
            </div>
        </article>

        <article class="billing-summary-card">
            <div class="billing-summary-icon paid">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Paid</span>
                <strong>@Model.PaidBillCount</strong>
            </div>
        </article>

        <article class="billing-summary-card">
            <div class="billing-summary-icon overdue">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>
                <span>Overdue</span>
                <strong>@Model.OverdueBillCount</strong>
            </div>
        </article>

        <article class="billing-summary-card amount">
            <div class="billing-summary-icon amount">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div>
                <span>Outstanding Amount</span>
                <strong>
                    RM @Model.TotalPendingAmount.ToString("F2")
                </strong>
            </div>
        </article>
    </section>

    <section class="billing-filter-card">
        <form asp-controller="Billing"
              asp-action="Index"
              method="get"
              id="billingFilterForm">

            <div class="billing-filter-row">
                @if (User.IsInRole("Admin"))
                {
                    <div class="billing-filter-field billing-search-field">
                        <label for="searchTerm">Search Student / Parent</label>

                        <div class="billing-search-input">
                            <i class="bi bi-search"></i>
                            <input id="searchTerm"
                                   name="searchTerm"
                                   type="search"
                                   value="@Model.SearchTerm"
                                   maxlength="100"
                                   placeholder="Name or guardian email"
                                   class="form-control" />
                        </div>
                    </div>
                }

                <div class="billing-filter-field">
                    <label for="status">Bill Status</label>

                    <select id="status"
                            name="status"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        @foreach (BillStatus status in
                                                Enum.GetValues<BillStatus>())
                        {
                            <option value="@status"
                                    selected="@(Model.SelectedStatus == status
                                                                                                                          ? "selected"
                                                                                                                          : null)">
                            @StatusText(status)
                        </option>
                                                }
                    </select>
                </div>

                <button type="submit"
                        class="payment-link-button billing-filter-button">
                    <i class="bi bi-funnel"></i>
                    Apply Filters
                </button>

                @if (Model.SelectedStatus.HasValue ||
                                !string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-controller="Billing"
                       asp-action="Index"
                       class="outline-button billing-clear-button">

                        <i class="bi bi-x-lg"></i>
                        Clear Filter
                    </a>
                }
            </div>
        </form>
    </section>

    <section class="billing-table-card">
        <div class="billing-table-heading">
            <div>
                <i class="bi bi-receipt-cutoff"></i>
                <h2>All Bills</h2>
            </div>

            <span>@Model.Bills.Count bill(s)</span>
        </div>

        @if (Model.Bills.Count == 0)
        {
            <div class="billing-empty-state">
                <i class="bi bi-receipt"></i>
                <h3>No bills found</h3>
                <p>
                    Bills will appear after an enrollment
                    application is approved.
                </p>
            </div>
        }
        else
        {
            <div class="billing-table-wrapper">
                <table class="billing-table">
                    <colgroup>
                        <col class="column-number" />
                        <col class="column-student" />
                        <col class="column-guardian" />
                        <col class="column-amount" />
                        <col class="column-issued" />
                        <col class="column-due" />
                        <col class="column-status" />
                        <col class="column-action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="billing-row-number">No.</th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-sortBy="studentName"
                                   asp-route-sortDirection="@NextDirection("studentName")">
                                    Student
                                    <i class="bi @SortIcon("studentName")"></i>
                                </a>
                            </th>

                            <th>Guardian</th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-sortBy="amount"
                                   asp-route-sortDirection="@NextDirection("amount")">
                                    Amount
                                    <i class="bi @SortIcon("amount")"></i>
                                </a>
                            </th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-sortBy="issuedAt"
                                   asp-route-sortDirection="@NextDirection("issuedAt")">
                                    Issued Date
                                    <i class="bi @SortIcon("issuedAt")"></i>
                                </a>
                            </th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-sortBy="dueAt"
                                   asp-route-sortDirection="@NextDirection("dueAt")">
                                    Due Date
                                    <i class="bi @SortIcon("dueAt")"></i>
                                </a>
                            </th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-status="@Model.SelectedStatus"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-sortBy="status"
                                   asp-route-sortDirection="@NextDirection("status")">
                                    Status
                                    <i class="bi @SortIcon("status")"></i>
                                </a>
                            </th>

                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int index = 0;
                                            index < Model.Bills.Count;
                                            index++)
                        {
                            var bill = Model.Bills[index];

                            <tr>
                                <td class="billing-row-number">
                                    <strong>@(index + 1)</strong>
                                </td>

                                <td>
                                    <strong class="billing-table-primary">@bill.StudentName</strong>

                                    <span class="billing-table-secondary">@bill.AcademicLevel</span>
                                </td>

                                <td>
                                    <strong class="billing-table-primary">@bill.GuardianName</strong>

                                    <span class="billing-table-secondary">
                                        @bill.GuardianEmail
                                    </span>
                                </td>

                                <td class="billing-amount">
                                    RM @bill.TotalAmount.ToString("F2")
                                </td>

                                <td>
                                    <strong class="billing-table-primary">
                                        @bill.IssuedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </strong>
                                    <span class="billing-table-secondary">
                                        @bill.IssuedAt.ToLocalTime().ToString("hh:mm tt")
                                    </span>
                                                                                     </td>

                                <td>
                                    <strong class="billing-table-primary">
                                        @bill.DueAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </strong>
                        </td>

                                <td>
                                    <span class="@StatusClass(bill.Status)">
                                        @StatusText(bill.Status)
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Billing"
                                       asp-action="Details"
                                       asp-route-id="@bill.BillId"
                                       class="billing-details-button">

                                        <i class="bi bi-eye"></i>
                                        Details
                                    </a>
                                </td>
                            </tr>
                                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script nonce="@Context.Items["CspNonce"]">
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("billingFilterForm");
            const status = document.getElementById("status");
            const search = document.getElementById("searchTerm");
            let timer;

            status?.addEventListener("change", () => form?.requestSubmit());
            search?.addEventListener("input", function () {
                window.clearTimeout(timer);
                timer = window.setTimeout(() => form?.requestSubmit(), 450);
            });
        });
    </script>
}
