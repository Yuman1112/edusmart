@{
    Layout = "~/Views/Shared/_ErrorLayout.cshtml";
    ViewData["Title"] = "Checkout closed";
    string? token = ViewBag.PaymentAccessToken as string;
    bool preserveSession = ViewBag.PreserveSession is bool value && value;
}
<section class="error-card" aria-labelledby="closed-title">
    <span class="error-status payment-status-neutral">Checkout closed</span>
    <h1 id="closed-title">Checkout closed</h1>
    <p class="error-message">The checkout was closed or cancelled. This page does not confirm the final payment status.
        If you may have completed payment, check your bill and receipt before trying again.</p>
    <div class="error-actions">
    @if (!string.IsNullOrWhiteSpace(token)) {
        <a asp-controller="Payments" asp-action="Checkout" asp-route-token="@token" asp-route-preserveSession="@preserveSession" class="error-button">Check Payment Status</a>
    }
        <a asp-controller="Home" asp-action="Index" class="error-button secondary">Return Home</a>
    </div>
</section>
