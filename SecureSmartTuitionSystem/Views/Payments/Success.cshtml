@{
    ViewData["Title"] = "Payment Result";

    bool paymentVerified =
        ViewBag.PaymentVerified == true;

    string statusMessage =
        ViewBag.StatusMessage as string
        ?? "EduSmart is verifying the payment status.";

    string? checkoutSessionId =
        ViewBag.CheckoutSessionId as string;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/payment.css"
          asp-append-version="true" />
}

<div class="payment-result-page">
    <main class="payment-result-card">

        @if (paymentVerified)
        {
            <div class="payment-result-icon success">
                <i class="bi bi-check-lg"></i>
            </div>

            <span class="payment-eyebrow">
                Payment Confirmed
            </span>

            <h1>Thank You</h1>

            <p>
                Your Stripe test payment was verified successfully.
            </p>

            <div class="payment-completed-message">
                <i class="bi bi-check-circle-fill"></i>

                <div>
                    <strong>Payment Successful</strong>
                    <span>@statusMessage</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(checkoutSessionId))
            {
                <a asp-controller="Payments"
                   asp-action="ReceiptBySession"
                   asp-route-sessionId="@checkoutSessionId"
                   class="payment-result-button">

                    <i class="bi bi-receipt"></i>
                    View Receipt
                </a>
            }
            else
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   class="payment-result-button">

                    Return to Home
                </a>
            }
        }
        else
        {
            <div class="payment-result-icon cancelled">
                <i class="bi bi-exclamation-lg"></i>
            </div>

            <span class="payment-eyebrow">
                Verification Incomplete
            </span>

            <h1>Payment Not Updated</h1>

            <p>
                @statusMessage
            </p>

            <div class="payment-verification-note">
                <i class="bi bi-clock-history"></i>

                <span>
                    Do not submit another payment.
                    Return to the bill and check its status first.
                </span>
            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="payment-result-button">

                Return to Home
            </a>
        }

    </main>
</div>