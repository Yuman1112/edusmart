@{ Layout = "~/Views/Shared/_ErrorLayout.cshtml"; ViewData["Title"] = "Payment already completed"; ViewData["HideHomeLink"] = true; }
<section class="error-card" aria-labelledby="paid-title">
    <span class="error-status payment-status-success">Already settled · PAID</span>
    <h1 id="paid-title">Payment already completed</h1>
    <p class="error-message">This bill has already been settled. You do not need to pay again or request another payment link.</p>
    <p class="error-message">Sign in with the account associated with this payment to view your bill, receipt or contact staff.</p>
    <div class="error-actions">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-area="Identity" asp-page="/Account/Logout" asp-page-handler="SwitchAccount" method="post">
            <button type="submit" class="error-button">Sign in with the correct account</button>
        </form>
    }
    else
    {
        <a class="error-button" href="@Url.Content("~/Identity/Account/Login")">Sign in</a>
    }
    </div>
</section>
