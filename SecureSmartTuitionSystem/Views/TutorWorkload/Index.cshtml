@model SecureSmartTuitionSystem.ViewModels.Tutor.TutorWorkloadViewModel
@{
    ViewData["Title"] = "Tutor Workload";
    string weekValue = Model.WeekStart.ToString("yyyy-MM-dd");
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
}
<div class="page-header">
    <div><h1>Tutor Workload</h1><p>Review weekly scheduled classes, lessons and teaching hours.</p></div>
</div>
<div class="class-form-card mb-4">
    <form asp-controller="TutorWorkload" asp-action="Index" method="get" data-live-filter>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label for="workload-week" class="form-label">Date Within Week</label>
                <input id="workload-week" name="week" type="date" class="form-control"
                       value="@weekValue" min="2000-01-01" max="2100-12-31" required />
            </div>
            <div class="col-12 col-md-5">
                <label for="workload-tutor" class="form-label">Tutor</label>
                <select id="workload-tutor" name="userId" class="form-select">
                    <option value="">All Tutors</option>
                    @foreach (var tutor in Model.AllTutors)
                    {
                        <option value="@tutor.UserId" selected="@(Model.SelectedUserId == tutor.UserId)">@tutor.TutorId · @tutor.FullName</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="primary-button"><i class="bi bi-funnel" aria-hidden="true"></i> View Workload</button>
            </div>
        </div>
    </form>
</div>
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <strong>@Model.WeekStart.ToString("dd MMM yyyy") – @Model.WeekEnd.ToString("dd MMM yyyy") · MYT (UTC+8)</strong>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.WeekStart.AddDays(-7).Year >= 2000)
        {
            <a class="outline-button" asp-action="Index" asp-route-week="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")" asp-route-userId="@Model.SelectedUserId">Previous Week</a>
        }
        <a class="outline-button" asp-action="Index" asp-route-userId="@Model.SelectedUserId">This Week</a>
        @if (Model.WeekStart.AddDays(7).Year <= 2100)
        {
            <a class="outline-button" asp-action="Index" asp-route-week="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")" asp-route-userId="@Model.SelectedUserId">Next Week</a>
        }
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4"><div class="class-form-card h-100"><p>Tutors Shown</p><h2>@Model.Rows.Count</h2></div></div>
    <div class="col-12 col-md-4"><div class="class-form-card h-100"><p>Scheduled Lessons</p><h2>@Model.TotalLessons</h2></div></div>
    <div class="col-12 col-md-4"><div class="class-form-card h-100"><p>Scheduled Teaching Hours</p><h2>@Model.TotalHours.ToString("0.##")</h2></div></div>
</div>
<div class="class-details-card mb-4">
    <section class="class-details-section">
        <h3><i class="bi bi-bar-chart" aria-hidden="true"></i> Weekly Overview</h3>
        <p class="text-muted">Cancelled lessons are excluded. Replacements are included in lessons and hours. Classes counts distinct classes scheduled this week. These figures follow the current Calendar records and are not attendance totals.</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Tutor</th><th scope="col">Status</th><th scope="col">Classes</th><th scope="col">Lessons</th><th scope="col">Replacements</th><th scope="col">Hours</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @foreach (var tutor in Model.Rows)
                    {
                        <tr>
                            <td><strong>@tutor.FullName</strong><br /><small class="text-muted">@tutor.TutorId</small></td>
                            <td><span class="status-pill @(tutor.IsActive ? "status-success" : "status-warning")">@(tutor.IsActive ? "Active" : "Inactive")</span></td>
                            <td>@tutor.ClassCount</td>
                            <td>@tutor.LessonCount</td>
                            <td>@tutor.ReplacementCount</td>
                            <td>@tutor.TeachingHours.ToString("0.##")</td>
                            <td><a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-week="@weekValue" asp-route-userId="@tutor.UserId" asp-fragment="workload-lessons">View Week</a></td>
                        </tr>
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted">No tutor records found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
@if (!string.IsNullOrEmpty(Model.SelectedUserId))
{
    <div id="workload-lessons" class="class-details-card">
        <section class="class-details-section">
            <h3><i class="bi bi-calendar-week" aria-hidden="true"></i> Lesson Breakdown · @Model.Rows[0].TutorId</h3>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th scope="col">Date</th><th scope="col">Class</th><th scope="col">Level / Subject</th><th scope="col">Time (MYT)</th><th scope="col">Type</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var lesson in Model.Lessons)
                        {
                            <tr>
                                <td class="text-nowrap">@lesson.Date.ToString("ddd, dd MMM yyyy")</td>
                                <td>@lesson.Class.ClassCode<br /><small>@lesson.Class.ClassName</small></td>
                                <td>@lesson.Class.Subject.AcademicLevel · @lesson.Class.Subject.SubjectName</td>
                                <td class="text-nowrap">@lesson.Start.ToString("HH:mm")–@lesson.End.ToString("HH:mm")</td>
                                <td>@(lesson.Replacement ? "Replacement" : "Regular")</td>
                                <td><a class="btn btn-sm btn-outline-secondary" asp-controller="ClassSessions" asp-action="Details" asp-route-id="@lesson.Class.ClassSessionId">Class Details</a></td>
                            </tr>
                        }
                        @if (Model.Lessons.Count == 0)
                        {
                            <tr><td colspan="6" class="text-muted">No scheduled lessons for this tutor in the selected week.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}