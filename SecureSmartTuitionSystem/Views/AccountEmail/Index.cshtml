@model SecureSmartTuitionSystem.Controllers.AccountEmailController.PageModel
@using SecureSmartTuitionSystem.Models.Identity
@{
    bool adding = string.IsNullOrWhiteSpace(Model.CurrentEmail);
    ViewData["Title"] = adding ? "Add Email" : "Change Email";
    var pending = Model.Pending;
    bool expired = pending != null && pending.ExpiresAtUtc <= DateTime.UtcNow;
    bool needsCode = pending != null && !expired && pending.Status == EmailChangeStatus.VerifyCurrent;
    string heading = pending == null ? "Account Email" : expired ? "Request Expired" : needsCode ? (adding ? "Guardian Verification" : "Verify Your Identity") : "Check Your New Email";
    string? success = TempData["EmailSuccess"] as string;
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login-otp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/email-change.css" asp-append-version="true" />
    <noscript><style>.email-change-page .otp-real-input { position: static; opacity: 1; height: 55px; border: 1px solid #cce1e8; border-radius: 9px; padding: 12px; } .email-change-page .otp-digits { display: none; }</style></noscript>
}
<partial name="_EmailFlow" model="Model" />
@section Scripts {
    <script src="~/js/account-request-cooldown.js" asp-append-version="true"></script>
    <script src="~/js/email-change-layout.js" asp-append-version="true"></script>
    @if (needsCode) { <script src="~/js/login-otp.js" asp-append-version="true" defer></script> }
}
