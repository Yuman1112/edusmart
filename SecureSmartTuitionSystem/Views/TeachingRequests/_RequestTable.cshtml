@model SecureSmartTuitionSystem.ViewModels.Tutor.TeachingRequestListViewModel
<div class="tutor-management-list-card teaching-request-list" data-teaching-live
     data-live-url="@Url.Action("Live", "TeachingRequests")">
    <div class="tutor-management-list-header">
        <h2><i class="bi bi-clipboard-check" aria-hidden="true"></i> @(Model.IsAdmin ? "Tutor Requests" : "My Requests")</h2>
        <span class="teaching-section-count" data-request-count>@Model.Requests.Count request(s)</span>
    </div>
    <p class="teaching-live-status" data-live-status role="status" aria-live="polite">Updates automatically every 5 seconds.</p>
    <div class="table-responsive">
        <table class="table align-middle mb-0 teaching-requests-table" id="teaching-requests-table">
            <thead>
                <tr>
                    <th scope="col">No.</th>
                    <th scope="col">Request ID</th>
                    @if (Model.IsAdmin)
                    {
                        <th scope="col">Tutor</th>
                    }
                    <th scope="col">Subject &amp; Level</th>
                    <th scope="col">Submitted On</th>
                    <th scope="col">Status</th>
                    <th scope="col" data-sortable="@(Model.IsAdmin ? "false" : "true")">@(Model.IsAdmin ? "Actions" : "Admin Notes & Evidence")</th>
                </tr>
            </thead>
            <tbody><partial name="_RequestTableRows" model="Model" /></tbody>
        </table>
    </div>
    <p class="teaching-empty-state @(Model.Requests.Count == 0 ? "" : "d-none")" data-request-empty>No requests have been submitted yet.</p>
</div>
