@model IReadOnlyList<SecureSmartTuitionSystem.ViewModels.Tutor.TeachingChangeRow>
@using SecureSmartTuitionSystem.Models.Tutor

@{
    ViewData["Title"] = "Teaching Change Requests";
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teaching-requests.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Teaching Change Requests</h1>
        <p>Review additional teaching subjects and levels. Each item has its own decision.</p>
    </div>
    <a asp-controller="TutorManagement" asp-action="Index" class="outline-button">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Tutor Management
    </a>
</div>

<partial name="_RequestTable" model="new SecureSmartTuitionSystem.ViewModels.Tutor.TeachingRequestListViewModel { IsAdmin = true, Requests = Model }" />

@section Scripts {
    <script src="~/js/teaching-requests-live.js" asp-append-version="true"></script>
}