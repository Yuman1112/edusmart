@model IReadOnlyList<SecureSmartTuitionSystem.ViewModels.Tutor.TeachingChangeRow>
@using SecureSmartTuitionSystem.Models.Tutor

@{
    ViewData["Title"] = "Teaching Change Requests";
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Teaching Change Requests</h1>
        <p>Review requests from tutors to change their approved subjects and levels.</p>
    </div>
    <a asp-controller="TutorManagement" asp-action="Index" class="outline-button">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Tutor Management
    </a>
</div>

<div class="class-form-card tutor-create-card">
    <section class="class-form-section">
        <h2><i class="bi bi-clipboard-check" aria-hidden="true"></i> Tutor Requests</h2>
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No teaching change requests have been submitted.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Request</th><th>Tutor</th><th>Subject &amp; Level</th><th>Status</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr>
                                <td>
                                    <strong>#@request.Id</strong> · @request.TypeLabel
                                    <div class="small text-muted">@request.SubmittedAtUtc.AddHours(8).ToString("dd MMM yyyy")</div>
                                </td>
                                <td>@request.TutorName <span class="text-muted">(@request.TutorId)</span></td>
                                <td>@request.SubjectLabel · @request.AcademicLevel</td>
                                <td><partial name="_TeachingRequestStatus" model="request" /></td>
                                <td>
                                    <a asp-action="Review" asp-route-id="@request.Id" class="outline-button">
                                        @(request.Status == TeachingChangeStatus.Pending ? "Review" : "View")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
