@model SecureSmartTuitionSystem.ViewModels.Tutor.TeachingChangeRow
@using SecureSmartTuitionSystem.Models.Tutor
@{
    var statusClass = Model.Status switch
    {
        TeachingChangeStatus.Approved => "tutor-badge-success",
        TeachingChangeStatus.Rejected => "teaching-badge-rejected",
        _ => "tutor-badge-pending"
    };
}
<span class="tutor-management-badge @statusClass" data-request-status>@Model.StatusLabel</span>
