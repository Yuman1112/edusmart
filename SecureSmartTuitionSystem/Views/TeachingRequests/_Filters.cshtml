@using SecureSmartTuitionSystem.Models.Tutor
@{var search=ViewData["TeachingSearch"] as string;var selected=ViewData["TeachingStatus"] as TeachingChangeStatus?;var from=ViewData["TeachingFrom"] as string;var to=ViewData["TeachingTo"] as string;var filtered=!string.IsNullOrEmpty(search)||selected.HasValue||!string.IsNullOrEmpty(from)||!string.IsNullOrEmpty(to);}
<form method="get" class="class-filter-card" data-teaching-filter>
    <div class="class-filter-heading"><div><h2><i class="bi bi-funnel" aria-hidden="true"></i> Filter Requests</h2><p>Search and filter teaching change requests.</p></div><a href="@(User.IsInRole("Admin")?Url.Action("Index"):Url.Action("Mine"))" class="clear-filter-link @(filtered?"":"d-none")" data-teaching-clear><i class="bi bi-x-circle" aria-hidden="true"></i> Clear Filters</a></div>
    <div class="class-filter-grid teaching-filter-grid"><div><label for="teaching-search" class="form-label">Search</label><input id="teaching-search" name="search" value="@search" class="form-control" placeholder="@(User.IsInRole("Admin")?"Request ID, tutor, subject or level":"Request ID, subject or level")" maxlength="200" /></div><div><label for="teaching-status" class="form-label">Status</label><select id="teaching-status" name="status" class="form-select"><option value="">All Statuses</option>@foreach(var item in Enum.GetValues<TeachingChangeStatus>()){<option value="@item" selected="@(selected==item)">@(item==TeachingChangeStatus.Pending?"Pending Review":item.ToString())</option>}</select></div><div><label for="teaching-from" class="form-label">Submitted From</label><input id="teaching-from" name="from" type="date" value="@from" class="form-control" /></div><div><label for="teaching-to" class="form-label">Submitted To</label><input id="teaching-to" name="to" type="date" value="@to" class="form-control" /></div></div>
    <noscript><button type="submit" class="outline-button mt-3">Apply Filters</button></noscript>
</form>
