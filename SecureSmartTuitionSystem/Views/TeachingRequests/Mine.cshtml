@model SecureSmartTuitionSystem.ViewModels.Tutor.TeachingChangeInput
@using SecureSmartTuitionSystem.Models.Tutor
@using SecureSmartTuitionSystem.Services

@{
    ViewData["Title"] = "Teaching Change Requests";
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learning-materials.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teaching-requests.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Teaching Change Requests</h1>
        <p>Request approval for additional teaching subjects and academic levels.</p>
    </div>
    <a asp-controller="Tutor" asp-action="MyProfile" class="outline-button">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> My Profile
    </a>
</div>

@if (TempData["TeachingSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

<div class="class-form-card tutor-create-card mb-4 teaching-approved-card">
    <section class="class-form-section">
        <partial name="_ApprovedSubjects" model="Model.ApprovedSubjects" />
    </section>
</div>

<div class="class-form-card tutor-create-card mb-4">
    <form asp-action="Mine" method="post" enctype="multipart/form-data" id="teaching-request-form">
        <section class="class-form-section">
            <div class="teaching-section-heading">
                <h2><i class="bi bi-clipboard-plus" aria-hidden="true"></i> Add New Subject</h2>
                <span class="teaching-section-count" id="teaching-subject-count" role="status" aria-live="polite">@Model.Items.Count / 10 items</span>
            </div>
            <p class="tutor-section-description">Add the subjects and levels you would like to teach. Each item is reviewed separately.</p>
            <div class="teaching-validation-notice" data-teaching-validation hidden="@ViewData.ModelState.IsValid"
                 role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <div>
                    <strong>Please review the highlighted fields.</strong>
                    <div asp-validation-summary="ModelOnly" class="teaching-model-errors"></div>
                </div>
            </div>
            <input name="Type" type="hidden" value="@TeachingChangeType.AddSubject" />

            <div class="row g-4">
                <div class="col-12">
                    <div class="teaching-subject-columns" aria-hidden="true">
                        <span>Academic Level</span><span>Subject</span><span></span>
                    </div>
                    <div id="teaching-subject-rows"
                         data-unavailable-combinations="@System.Text.Json.JsonSerializer.Serialize(Model.UnavailableCombinations)">
                        @for (int index = 0; index < Model.Items.Count; index++)
                        {
                            @Html.EditorFor(model => model.Items[index], "TeachingSubjectInput")
                        }
                    </div>
                    <button type="button" class="outline-button" id="add-teaching-subject">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Another Subject / Level
                    </button>
                    <p class="form-text">Approved combinations, pending requests and items already selected here are excluded.</p>
                    <template id="teaching-subject-template">
                        @Html.EditorFor(model => model.Items[0], "TeachingSubjectInput", "Items[__index__]")
                    </template>
                </div>
                <div class="col-12 teaching-request-reason">
                    <label asp-for="Reason" class="form-label"></label>
                    <textarea asp-for="Reason" class="form-control" rows="3" maxlength="1000"
                              placeholder="Tell us about your qualifications or experience in these subjects."></textarea>
                    <span asp-validation-for="Reason" class="text-danger"></span>
                </div>
                <div class="col-12 learning-materials-page teaching-evidence-editor">
                    <div class="material-attachment-heading">
                        <div>
                            <label asp-for="Evidence" class="form-label">Supporting Evidence <span class="text-muted fw-normal">(Optional)</span></label>
                            <p id="teaching-evidence-status" class="form-text" role="status" aria-live="polite"></p>
                        </div>
                        <button type="button" class="outline-button" id="add-teaching-evidence" hidden>
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Files
                        </button>
                    </div>
                    <input asp-for="Evidence" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg"
                           multiple aria-describedby="teaching-evidence-help" />
                    <div class="material-drop-zone" id="teaching-evidence-drop" hidden
                         role="region" aria-label="Add supporting evidence by dropping or choosing files">
                        <div class="material-drop-prompt">
                            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                            <div><strong>Drag and drop files here</strong><span>or choose Add Files above.</span></div>
                        </div>
                        <div id="teaching-evidence-list" data-file-list></div>
                    </div>
                    <div id="teaching-evidence-help" class="form-text">PDF, PNG, JPG · Max. 5 files · 10 MB/file · 25 MB total, including selected existing documents.</div>
                    <span asp-validation-for="Evidence" class="text-danger"></span>
                    @if (Model.ExistingEvidence.Count > 0)
                    {
                        <fieldset class="mt-3">
                            <legend class="form-label">Use Existing Verified Qualification Documents</legend>
                            <p class="form-text">Selected files will be attached to this submission as a snapshot.</p>
                            @foreach (var document in Model.ExistingEvidence)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="ReferenceDocumentIds" value="@document.Id"
                                           id="reference-document-@document.Id" class="form-check-input"
                                           data-evidence-size="@document.Size"
                                           checked="@Model.ReferenceDocumentIds.Contains(document.Id)" />
                                    <label for="reference-document-@document.Id" class="form-check-label">
                                        @document.Name (@((document.Size / 1024d / 1024).ToString("0.##")) MB)
                                    </label>
                                </div>
                            }
                            <span asp-validation-for="ReferenceDocumentIds" class="text-danger"></span>
                        </fieldset>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <p class="form-text">Select any new uploads again before resubmitting.</p>
                    }
                </div>
            </div>
        </section>
        <div class="teaching-confirmation">
            <div class="form-check">
                <input asp-for="ConfirmAccuracy" class="form-check-input" required
                       data-val="true"
                       data-val-required="Please confirm that you are qualified to teach the selected subjects and levels."
                       aria-describedby="teaching-confirmation-help" />
                <label asp-for="ConfirmAccuracy" class="form-check-label">
                    I confirm that I am qualified to teach the selected subjects and levels.
                </label>
                <p id="teaching-confirmation-help">
                    Each subject and level will be reviewed separately by the administrator.
                </p>
            </div>
            <span asp-validation-for="ConfirmAccuracy" class="text-danger"></span>
        </div>
        <div class="class-form-actions">
            <button type="submit" class="primary-button">
                <i class="bi bi-send" aria-hidden="true"></i> Submit Subject Requests
            </button>
        </div>
    </form>
</div>

<partial name="_RequestTable" model="new SecureSmartTuitionSystem.ViewModels.Tutor.TeachingRequestListViewModel { Requests = Model.Requests }" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/teaching-request.js" asp-append-version="true"></script>
    <script src="~/js/learning-materials-preview.js" asp-append-version="true"></script>
    <script src="~/js/teaching-requests-live.js" asp-append-version="true"></script>
}
