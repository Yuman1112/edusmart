@model SecureSmartTuitionSystem.ViewModels.Tutor.TeachingRequestListViewModel
@{ViewData["Title"]="Teaching Change Requests";}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learning-materials.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teaching-requests.css" asp-append-version="true" />
}

<div class="page-header"><div><h1>Teaching Change Requests</h1><p>Track your teaching subject and level requests.</p></div><div class="class-detail-header-actions"><a asp-controller="Tutor" asp-action="EditProfile" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Edit Profile</a><a asp-action="Create" class="primary-button"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Request</a></div></div>
@if(TempData["TeachingSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}
<partial name="_Filters" />
<partial name="_RequestTable" model="Model" />
@section Scripts {<script src="~/js/teaching-requests-live.js" asp-append-version="true"></script>}
