@model SecureSmartTuitionSystem.ViewModels.Tutor.TeachingDecisionInput
@using SecureSmartTuitionSystem.Models.Tutor
@{
    ViewData["Title"] = "Review Teaching Request";
    var request = Model.Request!;
    bool hasErrors = !ViewData.ModelState.IsValid;
    bool approveDecision = request.Type != TeachingChangeType.Remove;
    if (ViewData.ModelState.TryGetValue("approve", out var decisionState)
        && bool.TryParse(decisionState.AttemptedValue, out var attemptedDecision))
        approveDecision = attemptedDecision;
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teaching-requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enrollment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teaching-review.css" asp-append-version="true" />
}
<div class="page-header">
    <div><h1>Review Teaching Request</h1><p class="teaching-review-subtitle">Review the request details and supporting evidence.</p></div>
    <a asp-action="Index" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Requests</a>
</div>
@if (TempData["TeachingSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["TeachingWarning"] is string warning)
{
    <div class="alert alert-warning" role="alert">@warning</div>
}
<div class="teaching-review-page">
    <main class="teaching-review-main">
        <section class="teaching-review-panel" aria-labelledby="requestDetailsTitle">
            <div class="teaching-review-panel-header">
                <h2 id="requestDetailsTitle"><i class="bi bi-clipboard" aria-hidden="true"></i> Request Details</h2>
                <partial name="_TeachingRequestStatus" model="request" />
            </div>
            <div class="teaching-review-panel-body">
                <dl class="teaching-review-information">
                    <div><dt>Request ID</dt><dd>#@request.Id</dd></div>
                    <div><dt>Request Type</dt><dd>@request.TypeLabel</dd></div>
                    <div><dt>Tutor</dt><dd>@request.TutorName <span class="teaching-review-secondary">@request.TutorId</span></dd></div>
                    <div><dt>Subject &amp; Level</dt><dd>@request.SubjectLabel <span class="teaching-level-chip">@request.AcademicLevel</span></dd></div>
                    <div><dt>Submitted On</dt><dd>@request.SubmittedAtUtc.AddHours(8).ToString("dd MMM yyyy") <span class="teaching-review-secondary">@request.SubmittedAtUtc.AddHours(8).ToString("h:mm tt") MYT</span></dd></div>
                </dl>
            </div>
        </section>
        <section class="teaching-review-panel" aria-labelledby="requestReasonTitle">
            <div class="teaching-review-panel-header"><h2 id="requestReasonTitle"><i class="bi bi-chat-left-text" aria-hidden="true"></i> Reason for Request</h2></div>
            <div class="teaching-review-panel-body"><p class="teaching-review-copy">@request.Reason</p></div>
        </section>
        <section class="teaching-review-panel" aria-labelledby="requestEvidenceTitle">
            <div class="teaching-review-panel-header"><h2 id="requestEvidenceTitle"><i class="bi bi-paperclip" aria-hidden="true"></i> Supporting Evidence</h2><span class="teaching-section-count">@request.Evidence.Count file(s)</span></div>
            <div class="teaching-review-panel-body">
                @if (request.Evidence.Count == 0)
                {
                    <p class="text-muted mb-0">No supporting files were attached.</p>
                }
                @foreach (var document in request.Evidence)
                {
                    <div class="teaching-review-file">
                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                        <div><strong>@document.Name</strong><small class="text-muted">@((document.Size / 1024d / 1024).ToString("0.##")) MB</small></div>
                        <a asp-action="Document" asp-route-id="@document.Id" class="outline-button"><i class="bi bi-download" aria-hidden="true"></i> Download</a>
                    </div>
                }
            </div>
        </section>
    </main>
    <aside class="teaching-review-panel" aria-labelledby="reviewActionsTitle">
        <div class="teaching-review-panel-header"><h2 id="reviewActionsTitle"><i class="bi bi-check2-square" aria-hidden="true"></i> @(request.Status == TeachingChangeStatus.Pending ? "Review Actions" : "Review Outcome")</h2></div>
        <div class="teaching-review-panel-body">
        @if (request.Status == TeachingChangeStatus.Pending)
        {
            <div class="enrollment-review-actions">
                <button type="button" class="enrollment-action-button enrollment-approve-button" data-teaching-decision="true" disabled="@(request.Type == TeachingChangeType.Remove)"><i class="bi bi-check-circle" aria-hidden="true"></i> Approve Request</button>
                <button type="button" class="enrollment-action-button enrollment-reject-button" data-teaching-decision="false"><i class="bi bi-x-circle" aria-hidden="true"></i> Reject Request</button>
            </div>
            @if (hasErrors)
            {
                <p class="text-danger mt-3 mb-0" role="alert">The decision was not saved. Open the review dialog to check the highlighted details.</p>
            }
            @if (request.Type == TeachingChangeType.Remove)
            {
                <p class="form-text">Subject removal is currently unavailable. You can reject this earlier request.</p>
            }
            <noscript><p class="form-text">Enable JavaScript to open the review confirmation dialog.</p></noscript>
        }
        else
        {
            <p class="teaching-review-copy">@(string.IsNullOrWhiteSpace(request.ReviewNotes) ? "No review notes provided." : request.ReviewNotes)</p>
            @if (request.ReviewedAtUtc.HasValue)
            {
                <p class="text-muted mb-0">Reviewed @request.ReviewedAtUtc.Value.AddHours(8).ToString("dd MMM yyyy, h:mm tt") MYT</p>
            }
        }
        </div>
    </aside>
</div>
@if (request.Status == TeachingChangeStatus.Pending)
{
    <div class="modal fade enrollment-modal teaching-decision-modal" id="teachingDecisionModal" tabindex="-1" aria-labelledby="teachingDecisionTitle" aria-hidden="true" data-review-errors="@hasErrors.ToString().ToLowerInvariant()" data-review-approve="@approveDecision.ToString().ToLowerInvariant()">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Review" method="post" id="teachingDecisionForm">
                    <input asp-for="Id" type="hidden" />
                    <input type="hidden" name="approve" id="teachingApproveDecision" value="@approveDecision.ToString().ToLowerInvariant()" />
                    <div class="modal-header">
                        <h2 class="modal-title" id="teachingDecisionTitle">@(approveDecision ? "Approve Request" : "Reject Request")</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p id="teachingDecisionQuestion">@(approveDecision ? "Are you sure you want to approve this teaching request?" : "Are you sure you want to reject this teaching request?")</p>
                        <p class="text-muted" id="teachingDecisionEffect">@(approveDecision ? "Approval adds the requested subject and level to this tutor's approved teaching subjects." : "The requested teaching change will not be applied.")</p>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <label asp-for="ReviewNotes" class="form-label">Admin Review Notes <span class="teaching-review-optional">(Optional)</span></label>
                        <textarea asp-for="ReviewNotes" class="form-control" rows="3" maxlength="1000" placeholder="Enter optional remarks" aria-describedby="reviewNotesHelp"></textarea>
                        <span asp-validation-for="ReviewNotes" class="text-danger"></span>
                        <p id="reviewNotesHelp" class="form-text">Notes will be visible to the tutor when provided.</p>
                        @if (request.Type != TeachingChangeType.Remove)
                        {
                            <div id="teachingQualificationBlock" hidden="@(!approveDecision)">
                                <div class="form-check mt-3">
                                    <input asp-for="QualificationVerified" class="form-check-input" disabled="@(!approveDecision)" required="@approveDecision" />
                                    <label asp-for="QualificationVerified" class="form-check-label"></label>
                                </div>
                                <span asp-validation-for="QualificationVerified" class="text-danger" role="alert"></span>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button>
                        <button type="submit" class="btn @(approveDecision ? "btn-success" : "btn-danger")" id="teachingConfirmDecision">@(approveDecision ? "Confirm Approval" : "Confirm Rejection")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/teaching-review-modal.js" asp-append-version="true"></script>
}
