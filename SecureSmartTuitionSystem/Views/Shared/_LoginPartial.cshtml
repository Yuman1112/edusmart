@using Microsoft.AspNetCore.Identity
@using SecureSmartTuitionSystem.Models.Identity

@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav public-account-links">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item account-summary">
            <span class="account-avatar">
                @((User.Identity?.Name ?? "U")
                            .Substring(0, 1)
                            .ToUpper())
        </span>

            <span class="account-text">
                <strong>@(User.IsInRole("Admin") ? "Administrator" : User.Identity?.Name)</strong>

                <small>
                @if (User.IsInRole("Parent"))
                    {
                        <text>Parent</text>
                    }
                    else if (User.IsInRole("Student"))
                    {
                        <text>Student</text>
                    }
                    else
                    {
                        <text>User</text>
                    }
                </small>
            </span>
        </li>

        <li class="nav-item">
            <form action="/Identity/Account/Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="outline-button">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="outline-button"
               href="/Identity/Account/Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="primary-button"
               href="/Identity/Account/Login">
                Login
            </a>
        </li>
    }
</ul>