@model int

@{
    bool additional = Context.Session.GetInt32("Enrollment.AddSubjectStudentId").HasValue || ViewData["IsAdditionalEnrollment"] as bool? == true;
    int currentStep = additional ? Model - 2 : Model;
    var steps = additional ? new[] { "Classes", "Options", "Submitted" } : new[]
    {
        "Student",
        "Guardian",
        "Classes",
        "Options",
        "Submitted"
    };
}

<nav aria-label="Enrollment progress" class="mb-4">
    <ol class="enrollment-steps @(additional ? "enrollment-steps-additional" : "")">
        @for (var index = 0; index < steps.Length; index++)
        {
            var number = index + 1;

            var state = number == currentStep
            ? "is-current"
            : number < currentStep
            ? "is-complete"
            : "";

            <li class="enrollment-step @state"
                aria-current="@(number == currentStep ? "step" : null)">
                <span class="enrollment-step-number">
                    @number
                </span>

                <span class="enrollment-step-label">
                    @steps[index]
                </span>
            </li>
        }
    </ol>
</nav>
