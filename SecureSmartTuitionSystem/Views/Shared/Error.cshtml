@model SecureSmartTuitionSystem.Models.ErrorViewModel
@{ Layout = "~/Views/Shared/_ErrorLayout.cshtml"; ViewData["Title"] = Model.Title; }
<section class="error-card" aria-labelledby="error-title">
    <span class="error-status">HTTP @Model.StatusCode</span><h1 id="error-title">@Model.Title</h1>
    <p class="error-message">@Model.Message</p>
    <dl><div><dt>Error code</dt><dd>@Model.ErrorCode</dd></div>
    @if (Model.ShowRequestId) { <div><dt>Reference</dt><dd>@Model.RequestId</dd></div> }</dl>
    <div class="error-actions"><a class="error-button" href="@Url.Content("~/")">Return Home</a>
    @if (Model.StatusCode == 401) { <a class="error-button secondary" href="@Url.Content("~/Identity/Account/Login")">Sign in</a> }
    @if (SecureSmartTuitionSystem.Services.Security.PageAccessRules.CanUsePublicSupport(User)) {
        <a class="error-button secondary" href="@Url.Content("~/GuestSupport")">Contact staff</a>
    }</div>
</section>
