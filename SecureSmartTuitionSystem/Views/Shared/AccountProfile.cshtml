@model SecureSmartTuitionSystem.ViewModels.Identity.AccountProfileModel
@{
    var editing = ViewData["Editing"] is true;
    ViewData["Title"] = editing ? "Edit Profile" : "My Profile";
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
}
<div class="page-header">
    <div><h1>@ViewData["Title"]</h1><p>@(editing ? "Update your profile information." : "View your EduSmart account information.")</p></div>
    @if (!editing)
    {
        <a asp-action="EditProfile" class="primary-button"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit Profile</a>
    }
</div>
@if (TempData["ProfileSaved"] is string message)
{
    <div class="alert alert-success" role="status" data-success-timeout="5000">@message</div>
}
<div class="class-form-card">
    <dl class="row">
        <dt class="col-sm-3">User ID</dt>
        <dd class="col-sm-9">@Model.UserId</dd>
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.Role</dd>
        <dt class="col-sm-3">Email address</dt>
        <dd class="col-sm-9">@(Model.Email ?? "—")</dd>
        @if (Model.Detail is not null)
        {
            <dt class="col-sm-3">@(Model.Role == "Admin" ? "Position" : "Academic level")</dt>
            <dd class="col-sm-9">@Model.Detail</dd>
        }
        @if (!editing)
        {
            <dt class="col-sm-3">Full name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>
            @if (Model.Role == "Student")
            {
                <dt class="col-sm-3">School</dt>
                <dd class="col-sm-9">@(Model.School ?? "—")</dd>
            }
            @if (Model.Role is "Admin" or "Parent")
            {
                <dt class="col-sm-3">Phone number</dt>
                <dd class="col-sm-9">@(Model.PhoneNumber ?? "—")</dd>
            }
            @if (Model.Role == "Parent")
            {
                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@(Model.Address ?? "—")</dd>
            }
        }
    </dl>
@if (editing)
{
        <form asp-action="EditProfile" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            @if (Model.Role == "Student")
            {
                <div class="mb-3">
                    <label asp-for="School" class="form-label"></label>
                    <input asp-for="School" class="form-control" />
                    <span asp-validation-for="School" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Phone Number (Optional)</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                @if (Model.Role == "Parent")
                {
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Address (Optional)</label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                }
            }
            <div class="class-form-actions"><a asp-action="MyProfile" class="outline-button">Cancel</a><button type="submit" class="primary-button">Save Changes</button></div>
        </form>
}
    }
@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
