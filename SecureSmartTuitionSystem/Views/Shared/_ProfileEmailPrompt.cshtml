<dialog id="profile-email-prompt" class="profile-save-dialog" aria-labelledby="profile-email-prompt-title">
    <h2 id="profile-email-prompt-title">Save your changes first?</h2>
    <p data-profile-prompt-copy>You have unsaved changes. Save them before continuing.</p>
    <div class="class-form-actions">
        <button type="button" class="outline-button" data-profile-stay>Stay Here</button>
        <button type="button" class="primary-button" data-profile-save-continue>Save &amp; Continue</button>
    </div>
</dialog>
<noscript><p class="text-muted">Save your personal information before opening another settings page.</p></noscript>
