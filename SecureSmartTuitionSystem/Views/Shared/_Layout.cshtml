@using Microsoft.AspNetCore.Identity
@using SecureSmartTuitionSystem.Models.Identity

@{
    string currentPath =
        Context.Request.Path.Value?.ToLower() ?? "";


    bool isAuthPage =
        currentPath.Equals(
            "/identity/account/login",
            StringComparison.OrdinalIgnoreCase) ||
        currentPath.Equals(
            "/identity/account/loginwith2fa",
            StringComparison.OrdinalIgnoreCase) ||
        currentPath.Equals(
            "/identity/account/register",
            StringComparison.OrdinalIgnoreCase) ||
        currentPath.Equals(
            "/identity/account/forgotpassword",
            StringComparison.OrdinalIgnoreCase) ||
        currentPath.Equals(
            "/identity/account/resetpassword",
            StringComparison.OrdinalIgnoreCase) ||
        currentPath.Equals(
            "/identity/account/setuppassword",
            StringComparison.OrdinalIgnoreCase);


    bool isAdmin =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Admin");

    bool isTutor =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Tutor");

    bool isLearner = User.Identity?.IsAuthenticated == true && (User.IsInRole("Parent") || User.IsInRole("Student"));

    bool useStaffLayout =
        isAdmin || isTutor;

    string currentController =
        ViewContext.RouteData.Values["controller"]?
            .ToString() ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"]?
            .ToString() ?? "";

    bool learningModuleActive = currentController == "LearningMaterials" || currentController == "Assessments";
    bool learningMaterialsActive = currentController == "LearningMaterials";
    bool learningProgressActive = currentController == "Assessments" && currentAction == "Progress";
    bool learningAssessmentsActive = currentController == "Assessments" && !learningProgressActive;

    // Attendance menu
    bool attendanceModuleActive =
        currentController == "Attendance"
        || currentController == "AttendanceCorrections";

    bool attendanceRecordsActive =
        currentController == "Attendance"
        && (currentAction == "Report"
            || currentAction == "Print"
            || currentAction == "Download");

    bool attendanceLessonsActive =
        currentController == "Attendance"
        && !attendanceRecordsActive;

    bool attendanceCorrectionsActive =
        currentController == "AttendanceCorrections";

    bool tutorProfileActive =
    currentController == "Tutor"
    && (currentAction == "MyProfile"
        || currentAction == "EditProfile");

    bool tutorClassesActive =
        currentController == "Tutor"
        && (currentAction == "MyClasses"
            || currentAction == "ClassDetails");

    bool classModuleActive =
        currentController == "ClassSessions"
        || currentController == "AdminEnrollments"
        || currentController == "ClassSchedules"
        || currentController == "EnrollmentExits"
        || (isTutor && tutorClassesActive);

    bool billingModuleActive = currentController == "Billing" || currentController == "Payments" || currentController == "BillingCoverage" || currentController == "MonthlyBilling";

    bool communicationActive = currentController == "Announcements" || currentController == "Messages" || currentController == "Faq" || currentController == "GuestEnquiries" || currentController == "GuestSupport" || (!isAdmin && currentController == "NotificationCenter");
    bool pendingActive = currentController == "ClassSchedules" && (currentAction == "Pending" || currentAction == "Replacement" || currentAction == "Unschedule");
    bool calendarActive = currentController == "ClassSchedules" && !pendingActive;

    string dashboardController =
        isAdmin ? "Admin" : "Tutor";

    string roleDisplayName =
        isAdmin ? "Administrator" : "Tutor";

    string pageTitle =
        ViewData["Title"]?.ToString()
        ?? "EduSmart";

    string userName =
        isAdmin ? "Administrator" : User.Identity?.Name ?? "User";

    string userInitial =
        !string.IsNullOrWhiteSpace(userName)
            ? userName.Substring(0, 1).ToUpper()
            : "U";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - EduSmart</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/enrollment-form.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/components.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SecureSmartTuitionSystem.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet" href="~/css/class-schedule.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/learner-navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/consistency.css" asp-append-version="true" />

</head>

<body class="edusmart-ui">

    @if (isAuthPage)
    {
        <!-- Login and Register pages -->
        <main class="auth-layout">
            @await Component.InvokeAsync("BillingAccessBanner")
            @RenderBody()
        </main>
    }
    else if (useStaffLayout)
    {
        <!-- Admin and Tutor Layout -->
        <div class="staff-layout">

            <aside class="staff-sidebar" id="staffSidebar" tabindex="-1" aria-label="Staff sidebar">

                <!-- Staff Logo -->
                <div class="sidebar-brand">
                    <a asp-controller="@dashboardController"
                       asp-action="Index"
                       aria-label="Go to dashboard">

                        <img src="~/images/logo.png"
                             asp-append-version="true"
                             alt="EduSmart Logo"
                             class="sidebar-logo" />
                    </a>
                </div>

                <nav class="sidebar-navigation" aria-label="Staff navigation">

                    <!-- Shared: Dashboard -->
                    <a class="sidebar-link @(currentController == dashboardController && currentAction == "Index" ? "active" : "")"
                       asp-controller="@dashboardController"
                       asp-action="Index"
                       aria-current="@(currentController == dashboardController && currentAction == "Index" ? "page" : null)">
                        <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                        <span>Dashboard</span>
                    </a>

                    @if (isAdmin)
                    {
                        <a class="sidebar-link @(currentController == "Admin" && (currentAction == "MyProfile" || currentAction == "EditProfile") ? "active" : "")"
                           asp-area="" asp-controller="Admin" asp-action="MyProfile">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            <span>My Profile</span>
                        </a>
                        <a class="sidebar-link @(currentController == "UserAccounts" ? "active" : "")"
                           asp-controller="UserAccounts" asp-action="Index">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span>User Accounts</span>
                        </a>
                        <!-- Admin: Tutor Management -->
                        <a class="sidebar-link @((currentController == "TutorManagement" || currentController == "AdminTutorAvailability" || currentController == "TutorWorkload") ? "active" : "")"
                           asp-controller="TutorManagement"
                           asp-action="Index"
                           aria-current="@((currentController == "TutorManagement" || currentController == "AdminTutorAvailability" || currentController == "TutorWorkload") ? "page" : null)">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                            <span>Tutor Management</span>
                        </a>

                        <!-- Admin: Class & Enrollment -->
                        <div class="sidebar-module">
                            <button type="button"
                                    class="sidebar-link sidebar-module-button @(classModuleActive ? "module-current" : "")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#classEnrollmentMenu"
                                    aria-expanded="@(classModuleActive ? "true" : "false")"
                                    aria-controls="classEnrollmentMenu">
                                <span class="sidebar-link-content">
                                    <i class="bi bi-people-fill" aria-hidden="true"></i>
                                    <span>Class &amp; Enrollment</span>
                                </span>
                                <i class="bi bi-chevron-down sidebar-module-arrow"
                                   aria-hidden="true"></i>
                            </button>

                            <div id="classEnrollmentMenu"
                                 class="collapse sidebar-submenu @(classModuleActive ? "show" : "")">

                                <a class="sidebar-submenu-link @(currentController == "ClassSessions" ? "active" : "")"
                                   asp-controller="ClassSessions"
                                   asp-action="Index"
                                   aria-current="@(currentController == "ClassSessions" ? "page" : null)">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <span>Class Sessions</span>
                                </a>

                                <a class="sidebar-submenu-link @(calendarActive ? "active" : "")"
                                   asp-controller="ClassSchedules"
                                   asp-action="Index"
                                   aria-current="@(calendarActive ? "page" : null)">
                                    <i class="bi bi-calendar-week" aria-hidden="true"></i>
                                    <span>Class Calendar</span>
                                </a>

                                <a class="sidebar-submenu-link @(pendingActive ? "active" : "")"
                                   asp-controller="ClassSchedules"
                                   asp-action="Pending"
                                   aria-current="@(pendingActive ? "page" : null)">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    <span>Pending Replacements</span>
                                </a>

                                <a class="sidebar-submenu-link @(currentController == "AdminEnrollments" ? "active" : "")"
                                   asp-controller="AdminEnrollments"
                                   asp-action="Index"
                                   aria-current="@(currentController == "AdminEnrollments" ? "page" : null)">
                                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                    <span>Enrollment Requests</span>
                                </a>

                                <a class="sidebar-submenu-link @(currentController == "EnrollmentExits" ? "active" : "")"
                                   asp-controller="EnrollmentExits"
                                   asp-action="Index"
                                   aria-current="@(currentController == "EnrollmentExits" ? "page" : null)">
                                    <i class="bi bi-person-dash" aria-hidden="true"></i>
                                    <span>Withdrawal History</span>
                                </a>
                            </div>
                        </div>

                        <!-- Admin: Payment & Billing -->
                        <div class="sidebar-module">
                            <button type="button"
                                    class="sidebar-link sidebar-module-button @(billingModuleActive ? "module-current" : "")"
                                    data-bs-toggle="collapse" data-bs-target="#billingMenu"
                                    aria-expanded="@(billingModuleActive ? "true" : "false")" aria-controls="billingMenu">
                                <span class="sidebar-link-content"><i class="bi bi-credit-card" aria-hidden="true"></i><span>Payment &amp; Billing</span></span>
                                <i class="bi bi-chevron-down sidebar-module-arrow" aria-hidden="true"></i>
                            </button>
                            <div id="billingMenu" class="collapse sidebar-submenu @(billingModuleActive ? "show" : "")">
                                <a class="sidebar-submenu-link @((currentController == "Billing" || currentController == "Payments") ? "active" : "")"
                                   asp-controller="Billing" asp-action="Index" aria-current="@((currentController == "Billing" || currentController == "Payments") ? "page" : null)">
                                    <i class="bi bi-receipt" aria-hidden="true"></i><span>Bills &amp; Receipts</span>
                                </a>
                                <a class="sidebar-submenu-link @(currentController == "BillingCoverage" ? "active" : "")"
                                   asp-controller="BillingCoverage" asp-action="Index" aria-current="@(currentController == "BillingCoverage" ? "page" : null)">
                                    <i class="bi bi-calendar-check" aria-hidden="true"></i><span>Enrollment Plan Periods</span>
                                </a>
                                <a class="sidebar-submenu-link @(currentController == "MonthlyBilling" ? "active" : "")"
                                   asp-controller="MonthlyBilling" asp-action="Index" aria-current="@(currentController == "MonthlyBilling" ? "page" : null)">
                                    <i class="bi bi-calendar2-week" aria-hidden="true"></i><span>Monthly Tuition Bills</span>
                                </a>
                            </div>
                        </div>

                        <!-- Admin: Planned Modules -->
                        <div class="sidebar-module">
                            <button type="button" class="sidebar-link sidebar-module-button @(learningModuleActive ? "module-current" : "")"
                                    data-bs-toggle="collapse" data-bs-target="#adminLearningMenu"
                                    aria-expanded="@(learningModuleActive ? "true" : "false")" aria-controls="adminLearningMenu">
                                <span class="sidebar-link-content"><i class="bi bi-journal-bookmark" aria-hidden="true"></i><span>Learning &amp; Assessment</span></span>
                                <i class="bi bi-chevron-down sidebar-module-arrow" aria-hidden="true"></i>
                            </button>
                            <div id="adminLearningMenu" class="collapse sidebar-submenu @(learningModuleActive ? "show" : "")">
                                <a class="sidebar-submenu-link @(learningMaterialsActive ? "active" : "")" asp-controller="LearningMaterials" asp-action="Index" aria-current="@(learningMaterialsActive ? "page" : null)">
                                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i><span>Learning Materials</span>
                                </a>
                                <a class="sidebar-submenu-link @(learningAssessmentsActive ? "active" : "")" asp-controller="Assessments" asp-action="Index" aria-current="@(learningAssessmentsActive ? "page" : null)">
                                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>Assessments</span>
                                </a>
                                <a class="sidebar-submenu-link @(learningProgressActive ? "active" : "")" asp-controller="Assessments" asp-action="Progress" aria-current="@(learningProgressActive ? "page" : null)">
                                    <i class="bi bi-bar-chart" aria-hidden="true"></i><span>Results Overview</span>
                                </a>
                            </div>
                        </div>

                        <!-- Admin: Attendance -->
                        <div class="sidebar-module">
                            <button type="button"
                                    class="sidebar-link sidebar-module-button @(attendanceModuleActive ? "module-current" : "")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#adminAttendanceMenu"
                                    aria-expanded="@(attendanceModuleActive ? "true" : "false")"
                                    aria-controls="adminAttendanceMenu">

                                <span class="sidebar-link-content">
                                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                    <span>Attendance</span>
                                </span>

                                <i class="bi bi-chevron-down sidebar-module-arrow"
                                   aria-hidden="true"></i>
                            </button>

                            <div id="adminAttendanceMenu"
                                 class="collapse sidebar-submenu @(attendanceModuleActive ? "show" : "")">

                                <a class="sidebar-submenu-link @(attendanceLessonsActive ? "active" : "")"
                                   asp-controller="Attendance"
                                   asp-action="Index"
                                   aria-current="@(attendanceLessonsActive ? "page" : null)">
                                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                    <span>Class Attendance</span>
                                </a>

                                <a class="sidebar-submenu-link @(attendanceRecordsActive ? "active" : "")"
                                   asp-controller="Attendance"
                                   asp-action="Report"
                                   aria-current="@(attendanceRecordsActive ? "page" : null)">
                                    <i class="bi bi-list-check" aria-hidden="true"></i>
                                    <span>Attendance Records</span>
                                </a>

                                <a class="sidebar-submenu-link @(attendanceCorrectionsActive ? "active" : "")"
                                   asp-controller="AttendanceCorrections"
                                   asp-action="Index"
                                   aria-current="@(attendanceCorrectionsActive ? "page" : null)">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    <span>Correction Requests</span>
                                </a>
                            </div>
                        </div>

                        <span class="sidebar-link disabled-link"
                              aria-disabled="true"
                              title="This module will be developed later">
                            <i class="bi bi-play-circle" aria-hidden="true"></i>
                            <span>Video Playback Vault</span>
                        </span>
                    }
                    else
                    {
                        <!-- Tutor: Profile -->
                        <a class="sidebar-link @(tutorProfileActive ? "active" : "")"
                           asp-controller="Tutor"
                           asp-action="MyProfile"
                           aria-current="@(tutorProfileActive ? "page" : null)">

                            <i class="bi bi-person-vcard"
                               aria-hidden="true"></i>

                            <span>Profile</span>
                        </a>

                        <!-- Tutor: Availability -->
                        <a class="sidebar-link @(currentController == "TutorAvailability" ? "active" : "")"
                           asp-controller="TutorAvailability"
                           asp-action="Index"
                           aria-current="@(currentController == "TutorAvailability" ? "page" : null)">

                            <i class="bi bi-calendar-week"
                               aria-hidden="true"></i>

                            <span>Availability</span>
                        </a>

                        <!-- Tutor: Classes -->
                        <div class="sidebar-module">
                            <button type="button"
                                    class="sidebar-link sidebar-module-button @(classModuleActive ? "module-current" : "")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#tutorClassesMenu"
                                    aria-expanded="@(classModuleActive ? "true" : "false")"
                                    aria-controls="tutorClassesMenu">

                                <span class="sidebar-link-content">
                                    <i class="bi bi-journal-bookmark"
                                       aria-hidden="true"></i>
                                    <span>Classes</span>
                                </span>

                                <i class="bi bi-chevron-down sidebar-module-arrow"
                                   aria-hidden="true"></i>
                            </button>

                            <div id="tutorClassesMenu"
                                 class="collapse sidebar-submenu @(classModuleActive ? "show" : "")">

                                <a class="sidebar-submenu-link @(tutorClassesActive ? "active" : "")"
                                   asp-controller="Tutor"
                                   asp-action="MyClasses"
                                   aria-current="@(tutorClassesActive ? "page" : null)">

                                    <i class="bi bi-journal-bookmark"
                                       aria-hidden="true"></i>

                                    <span>My Classes</span>
                                </a>

                                <a class="sidebar-submenu-link @(calendarActive ? "active" : "")"
                                   asp-controller="ClassSchedules"
                                   asp-action="Index"
                                   aria-current="@(calendarActive ? "page" : null)">

                                    <i class="bi bi-calendar-week"
                                       aria-hidden="true"></i>

                                    <span>Class Calendar</span>
                                </a>

                                <a class="sidebar-submenu-link @(pendingActive ? "active" : "")"
                                   asp-controller="ClassSchedules"
                                   asp-action="Pending"
                                   aria-current="@(pendingActive ? "page" : null)">

                                    <i class="bi bi-clock-history"
                                       aria-hidden="true"></i>

                                    <span>Pending Replacements</span>
                                </a>

                            </div>
                        </div>

                        <a class="sidebar-link @(currentController == "Tutor" && currentAction == "Students" ? "active" : "")"
                           asp-controller="Tutor" asp-action="Students"
                           aria-current="@(currentController == "Tutor" && currentAction == "Students" ? "page" : null)">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span>Students</span>
                        </a>

                        <div class="sidebar-module">
                            <button type="button" class="sidebar-link sidebar-module-button @(learningModuleActive ? "module-current" : "")"
                                    data-bs-toggle="collapse" data-bs-target="#tutorLearningMenu"
                                    aria-expanded="@(learningModuleActive ? "true" : "false")" aria-controls="tutorLearningMenu">
                                <span class="sidebar-link-content"><i class="bi bi-journal-bookmark" aria-hidden="true"></i><span>Learning &amp; Assessment</span></span>
                                <i class="bi bi-chevron-down sidebar-module-arrow" aria-hidden="true"></i>
                            </button>
                            <div id="tutorLearningMenu" class="collapse sidebar-submenu @(learningModuleActive ? "show" : "")">
                                <a class="sidebar-submenu-link @(learningMaterialsActive ? "active" : "")" asp-controller="LearningMaterials" asp-action="Index" aria-current="@(learningMaterialsActive ? "page" : null)">
                                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i><span>Learning Materials</span>
                                </a>
                                <a class="sidebar-submenu-link @(learningAssessmentsActive ? "active" : "")" asp-controller="Assessments" asp-action="Index" aria-current="@(learningAssessmentsActive ? "page" : null)">
                                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>Assessments</span>
                                </a>
                                <a class="sidebar-submenu-link @(learningProgressActive ? "active" : "")" asp-controller="Assessments" asp-action="Progress" aria-current="@(learningProgressActive ? "page" : null)">
                                    <i class="bi bi-bar-chart" aria-hidden="true"></i><span>Results Overview</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Tutor: Attendance -->
                    @if (isTutor && !isAdmin)
                    {
                        <div class="sidebar-module">
                            <button type="button"
                                    class="sidebar-link sidebar-module-button @(attendanceModuleActive ? "module-current" : "")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#tutorAttendanceMenu"
                                    aria-expanded="@(attendanceModuleActive ? "true" : "false")"
                                    aria-controls="tutorAttendanceMenu">

                                <span class="sidebar-link-content">
                                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                    <span>Attendance</span>
                                </span>

                                <i class="bi bi-chevron-down sidebar-module-arrow"
                                   aria-hidden="true"></i>
                            </button>

                            <div id="tutorAttendanceMenu"
                                 class="collapse sidebar-submenu @(attendanceModuleActive ? "show" : "")">

                                <a class="sidebar-submenu-link @(attendanceLessonsActive ? "active" : "")"
                                   asp-controller="Attendance"
                                   asp-action="Index"
                                   aria-current="@(attendanceLessonsActive ? "page" : null)">
                                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                    <span>Class Attendance</span>
                                </a>

                                <a class="sidebar-submenu-link @(attendanceRecordsActive ? "active" : "")"
                                   asp-controller="Attendance"
                                   asp-action="Report"
                                   aria-current="@(attendanceRecordsActive ? "page" : null)">
                                    <i class="bi bi-list-check" aria-hidden="true"></i>
                                    <span>Attendance Records</span>
                                </a>

                                <a class="sidebar-submenu-link @(attendanceCorrectionsActive ? "active" : "")"
                                   asp-controller="AttendanceCorrections"
                                   asp-action="Index"
                                   aria-current="@(attendanceCorrectionsActive ? "page" : null)">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    <span>Correction Requests</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Shared: Communication -->
                    <div class="sidebar-module">
                        <button type="button"
                                class="sidebar-link sidebar-module-button @(communicationActive ? "module-current" : "")"
                                data-bs-toggle="collapse"
                                data-bs-target="#communicationMenu"
                                aria-expanded="@(communicationActive ? "true" : "false")"
                                aria-controls="communicationMenu">
                            <span class="sidebar-link-content">
                                <i class="bi bi-chat-dots" aria-hidden="true"></i>
                                <span>Communication</span>
                            </span>
                            <i class="bi bi-chevron-down sidebar-module-arrow"
                               aria-hidden="true"></i>
                        </button>

                        <div id="communicationMenu"
                             class="collapse sidebar-submenu @(communicationActive ? "show" : "")">

                            <a class="sidebar-submenu-link @(currentController == "Announcements" ? "active" : "")"
                               asp-controller="Announcements"
                               asp-action="Index"
                               aria-current="@(currentController == "Announcements" ? "page" : null)">
                                <i class="bi bi-megaphone" aria-hidden="true"></i>
                                <span>Announcements</span>
                                @await Component.InvokeAsync("AnnouncementUnread")
                            </a>

                            <a class="sidebar-submenu-link @(currentController == "Messages" ? "active" : "")"
                               asp-controller="Messages"
                               asp-action="Index"
                               aria-current="@(currentController == "Messages" ? "page" : null)">
                                <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                                <span>Messages</span>
                                @await Component.InvokeAsync("MessageUnread")
                            </a>

                            @if (isAdmin)
                            {
                                <a class="sidebar-submenu-link @(currentController == "GuestEnquiries" ? "active" : "")" asp-controller="GuestEnquiries" asp-action="Index"><i class="bi bi-envelope" aria-hidden="true"></i><span>Guest enquiries</span>@await Component.InvokeAsync("GuestEnquiryPending")</a>
                            }

                            @if (!isAdmin && !User.IsInRole("Tutor"))
                            {
                                <a class="sidebar-submenu-link @(currentController == "Faq" ? "active" : "")"
                                   asp-controller="Faq" asp-action="Index" aria-current="@(currentController == "Faq" ? "page" : null)">
                                    <i class="bi bi-question-circle" aria-hidden="true"></i><span>FAQ &amp; Support</span>
                                </a>
                            }

                            @if (!isAdmin)
                            {
                                <a class="sidebar-submenu-link @(currentController == "NotificationCenter" ? "active" : "")"
                                   asp-controller="NotificationCenter"
                                   asp-action="Index"
                                   aria-current="@(currentController == "NotificationCenter" ? "page" : null)">
                                    <i class="bi bi-bell" aria-hidden="true"></i>
                                    <span>Notifications</span>
                                    @await Component.InvokeAsync("NotificationUnread")
                                </a>
                            }
                        </div>
                    </div>

                    @if (isAdmin)
                    {
                        <!-- Admin: Reports & Security -->
                        <a class="sidebar-link @(currentController == "Reports" ? "active" : "")"
                           asp-controller="Reports" asp-action="Index"
                           aria-current="@(currentController == "Reports" ? "page" : null)">
                            <i class="bi bi-bar-chart" aria-hidden="true"></i>
                            <span>Reports &amp; Analytics</span>
                        </a>

                        <a class="sidebar-link @(currentController == "Security" ? "active" : "")"
                           asp-controller="Security"
                           asp-action="Index"
                           aria-current="@(currentController == "Security" ? "page" : null)">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <span>System &amp; Security</span>
                        </a>
                    }
                    else
                    {
                        <!-- Tutor: Reports -->
                        <span class="sidebar-link disabled-link"
                              aria-disabled="true"
                              title="This module will be developed later">
                            <i class="bi bi-bar-chart" aria-hidden="true"></i>
                            <span>Reports</span>
                        </span>
                    }

                </nav>

                <!-- Logout -->
                <div class="sidebar-bottom">

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home")"
                          method="post">

                        <button type="submit"
                                class="sidebar-logout">

                            <i class="bi bi-box-arrow-left"></i>
                            <span>Logout</span>
                        </button>
                    </form>

                </div>

            </aside>


            <button type="button" class="sidebar-overlay" id="sidebarOverlay" aria-label="Close navigation" hidden></button>

            <!-- Staff Main Page -->
            <div class="staff-main">

                <header class="staff-topbar">
                    <button type="button" id="sidebarToggle" class="sidebar-toggle" aria-label="Open navigation" aria-controls="staffSidebar" aria-expanded="false"><i class="bi bi-list" aria-hidden="true"></i></button>

                    <div class="topbar-user">

                        <div class="user-avatar">
                            @userInitial
                        </div>

                        <div class="user-information">
                            <strong>@userName</strong>
                            <span>@roleDisplayName</span>
                        </div>

                    </div>

                </header>

                <main class="staff-content">
                    @await Component.InvokeAsync("BillingAccessBanner")
                    @RenderBody()
                </main>

            </div>

        </div>
    }
    else
    {
        <!-- Guest, Parent and Student Layout -->
        <div class="public-layout">

            <header class="public-header">

                <nav class="public-navbar" aria-label="Main navigation">

                    <!-- Public Logo -->
                    <a class="public-brand"
                       asp-controller="@(isLearner ? (User.IsInRole("Parent") ? "Parent" : "Student") : "Home")"
                       asp-action="Index"
                       aria-label="Go to EduSmart home page">

                        <img src="~/images/logo.png"
                             asp-append-version="true"
                             alt="EduSmart Logo"
                             class="public-logo" />
                    </a>


                    <div class="public-navigation" aria-label="Main navigation">
                        @if (isLearner)
                        {
                            <a asp-controller="@(User.IsInRole("Parent") ? "Parent" : "Student")" asp-action="Index" class="public-nav-link @(currentController == "Parent" || currentController == "Student" ? "active" : "")"><i class="bi bi-grid" aria-hidden="true"></i>Dashboard</a>
                            <div class="learner-nav-group dropdown">
                                <button type="button" class="public-nav-link dropdown-toggle @(currentController == "LearningClasses" || currentController == "EnrollmentSubmission" || currentController == "EnrollmentHistory" || currentController == "EnrollmentExits" ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false">Class &amp; Enrollment</button>
                                <div class="dropdown-menu learner-nav-menu">
                                    <a class="dropdown-item @(currentController == "LearningClasses" ? "active" : "")" asp-controller="LearningClasses" asp-action="Index">My Classes</a>
                                    <a class="dropdown-item" href="@Url.Action("Index", "LearningClasses")#enrollment-actions">Add Subjects</a>
                                    <a class="dropdown-item @(currentController == "EnrollmentHistory" ? "active" : "")" asp-controller="EnrollmentHistory" asp-action="Index">Enrollment History</a>
                                    <a class="dropdown-item @(currentController == "EnrollmentExits" ? "active" : "")" asp-controller="EnrollmentExits" asp-action="Index">Withdrawals &amp; Refunds</a>
                                </div>
                            </div>

                            @if (User.IsInRole("Parent"))
                            {
                                <a asp-controller="Assessments" asp-action="Progress" class="public-nav-link @(learningModuleActive ? "active" : "")"><i class="bi bi-bar-chart" aria-hidden="true"></i>Learning Progress</a>
                            }
                            else if (User.IsInRole("Student"))
                            {
                                <div class="learner-nav-group dropdown">
                                    <button type="button" class="public-nav-link dropdown-toggle @(learningModuleActive ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-journal-bookmark" aria-hidden="true"></i>Learning</button>
                                    <div class="dropdown-menu learner-nav-menu">
                                        <a class="dropdown-item @(learningMaterialsActive ? "active" : "")" asp-controller="LearningMaterials" asp-action="Index" aria-current="@(learningMaterialsActive ? "page" : null)"><i class="bi bi-journal-bookmark" aria-hidden="true"></i>Learning Materials</a>
                                        <a class="dropdown-item @(learningAssessmentsActive ? "active" : "")" asp-controller="Assessments" asp-action="Index" aria-current="@(learningAssessmentsActive ? "page" : null)"><i class="bi bi-file-earmark-text" aria-hidden="true"></i>Assessments</a>
                                        <a class="dropdown-item @(learningProgressActive ? "active" : "")" asp-controller="Assessments" asp-action="Progress" aria-current="@(learningProgressActive ? "page" : null)"><i class="bi bi-bar-chart" aria-hidden="true"></i>My Learning Progress</a>
                                    </div>
                                </div>
                            }

                            <a asp-controller="Attendance"
                               asp-action="Report"
                               class="public-nav-link @((currentController == "Attendance" || currentController == "AttendanceCorrections") ? "active" : "")">
                                <i class="bi bi-calendar-check" aria-hidden="true"></i>
                                Attendance
                            </a>

                            <div class="learner-nav-group dropdown">
                                <button type="button" class="public-nav-link dropdown-toggle @(currentController == "Billing" || currentController == "Payments" || currentController == "MonthlyBilling" ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-credit-card" aria-hidden="true"></i>Payment &amp; Billing</button>
                                <div class="dropdown-menu learner-nav-menu">
                                    <a class="dropdown-item @(currentController == "Billing" || currentController == "Payments" ? "active" : "")" asp-controller="Billing" asp-action="Index">Bills &amp; Receipts</a>
                                    <a class="dropdown-item @(currentController == "MonthlyBilling" ? "active" : "")" asp-controller="MonthlyBilling" asp-action="Index">Monthly Tuition Bills</a>
                                </div>
                            </div>
                            <div class="learner-nav-group dropdown">
                                <button type="button" class="public-nav-link dropdown-toggle @(communicationActive ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false">Communication <span class="message-unread-badge" data-communication-unread-total hidden></span></button>
                                <div class="dropdown-menu learner-nav-menu">
                                    <a class="dropdown-item @(currentController == "Announcements" ? "active" : "")" asp-controller="Announcements" asp-action="Index">Announcements @await Component.InvokeAsync("AnnouncementUnread")</a>
                                    <a class="dropdown-item @(currentController == "Messages" ? "active" : "")" asp-controller="Messages" asp-action="Index">Messages @await Component.InvokeAsync("MessageUnread")</a>
                                    <a class="dropdown-item @(currentController == "Faq" ? "active" : "")" asp-controller="Faq" asp-action="Index">FAQ &amp; Support</a>
                                    <a class="dropdown-item @(currentController == "NotificationCenter" ? "active" : "")" asp-controller="NotificationCenter" asp-action="Index">Notifications @await Component.InvokeAsync("NotificationUnread")</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Index" class="public-nav-link @(currentController == "Home" ? "active" : "")">Home</a>
                            <a asp-controller="Classes" asp-action="Index" class="public-nav-link @(currentController == "Classes" ? "active" : "")">Classes</a>
                            <a asp-controller="Faq" asp-action="Index" class="public-nav-link @(currentController == "Faq" ? "active" : "")">FAQ &amp; Support</a>
                        }
                    </div>

                    <!-- Public Account Buttons -->
                    <div class="public-account">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (isLearner)
                            {
                                <a asp-area="" asp-controller="@(User.IsInRole("Parent") ? "Parent" : "Student")" asp-action="MyProfile" class="public-user-email"
                                   aria-label="My Profile (@userName)"><i class="bi bi-person-circle" aria-hidden="true"></i> @userName</a>
                            }
                            else
                            {
                                <span class="public-user-email">@userName</span>
                            }

                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action("Index", "Home")"
                                  method="post">

                                <button type="submit"
                                        class="btn-public-login">

                                    <i class="bi bi-box-arrow-left"></i>
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn-public-register"
                               asp-area="" asp-controller="Enrollment" asp-action="StudentDetails">
                                Register
                            </a>

                            <a class="btn-public-login"
                               href="/Identity/Account/Login">
                                Login
                            </a>
                        }

                    </div>

                </nav>

            </header>


            <!-- Public Page Content -->
            <main class="public-content">
                @await Component.InvokeAsync("BillingAccessBanner")
                @RenderBody()
            </main>


            <!-- Public Footer -->
            <footer class="public-footer">
                <div>
                    &copy; @DateTime.Now.Year EduSmart ·
                    Secure Smart Tuition System
                </div>
            </footer>

        </div>
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Parent") || User.IsInRole("Student") || User.IsInRole("Tutor")))
    {
        <script src="~/js/message-unread.js" asp-append-version="true"
                data-unread-url="@Url.Action("UnreadCounts", "Messages")"></script>
        <script src="~/js/communication-unread.js" asp-append-version="true" data-communication-counts-url="@Url.Action("UnreadCounts", "NotificationCenter")"></script>
    }

    <script src="~/js/live-filters.js" asp-append-version="true"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>
</html>
