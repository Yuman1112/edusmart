@model SecureSmartTuitionSystem.ViewModels.Parent.ParentDashboardViewModel

@{
    ViewData["Title"] = "Parent Dashboard";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="mb-4">

        <h1 class="fw-bold">
            Welcome, @Model.ParentName
        </h1>

        <p class="text-muted">
            Parent User ID:
            <strong>@Model.ParentUserName</strong>
        </p>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h2 class="h4 fw-bold mb-4">
                My Children
            </h2>

            @if (Model.Students.Count == 0)
            {
                <p class="text-muted mb-0">
                    No students are currently linked
                    to your account.
                </p>
            }
            else
            {
                @foreach (var student in Model.Students)
                {
                    <div class="border rounded-3 p-3 mb-3">

                        <div class="d-flex
                                            justify-content-between
                                            align-items-start">

                            <div>

                                <h3 class="h5 fw-bold mb-1">
                                    @student.StudentName
                                </h3>

                                <div class="text-muted">
                                    Student ID:
                                    @student.StudentUserName
                                </div>

                                <div class="text-muted">
                                    @student.AcademicLevel
                                    ·
                                    @student.School
                                </div>

                            </div>

                            <span class="badge bg-success">
                                @student.Relationship
                            </span>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>
<a class="btn btn-primary mt-3" asp-controller="LearningClasses" asp-action="Index">My children’s class schedules</a>
