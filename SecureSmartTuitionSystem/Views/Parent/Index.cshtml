@model SecureSmartTuitionSystem.ViewModels.Parent.ParentDashboardViewModel
@{
    ViewData["Title"] = "Parent Dashboard";
    Layout = "/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/learner-dashboard.css" asp-append-version="true" />
}
<div class="learner-dashboard">
    <header class="learner-welcome">
        <div><span class="learner-eyebrow">PARENT SPACE</span><h1>Welcome, @Model.ParentName</h1><p>Stay connected with your children's learning.</p><div class="learner-identity"><span>@Model.ParentUserName</span><span>Parent account</span></div></div>
        <a asp-controller="LearningClasses" asp-action="Index" class="learner-button"><i class="bi bi-calendar-week" aria-hidden="true"></i> Children's Schedules <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </header>
    <div class="learner-content-grid">
        <section class="learner-panel">
            <div class="learner-section-heading"><div><h2>My Children</h2><p>Students currently linked to your account.</p></div><span class="learner-count">@Model.Students.Count linked</span></div>
            @if (Model.Students.Count == 0)
            {
                <div class="learner-empty"><i class="bi bi-people" aria-hidden="true"></i><h3>No children linked yet</h3><p>Contact the tuition centre if your child's account should be linked here.</p></div>
            }
            else
            {
                <div class="learner-children-list">
                    @foreach (var student in Model.Students)
                    {
                        <article class="learner-child">
                            <div class="learner-child-heading"><span class="learner-row-icon"><i class="bi bi-person" aria-hidden="true"></i></span><div class="learner-row-content"><h3>@student.StudentName</h3><p>@student.StudentUserName</p></div><span class="learner-count">@student.Relationship</span></div>
                            <p class="learner-child-school">@student.AcademicLevel @if (!string.IsNullOrWhiteSpace(student.School)) {
                            <span>· @student.School</span>
                        }
    </p>
                        <a asp-controller="Attendance" asp-action="Report" asp-route-StudentId="@student.StudentProfileId" class="learner-text-link">View attendance <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </article>
                }
                </div>
            }
        </section>
        <aside class="learner-shortcuts" aria-label="Parent shortcuts">
            <a asp-controller="Attendance" asp-action="Report" class="learner-shortcut"><span class="learner-shortcut-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span><h2>Children's Attendance</h2><p>Review published attendance records for your linked children.</p><span class="learner-text-link">View records <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a>
            <a asp-controller="Announcements" asp-action="Index" class="learner-shortcut"><span class="learner-shortcut-icon"><i class="bi bi-megaphone" aria-hidden="true"></i></span><h2>Centre Updates</h2><p>Keep up with announcements from the tuition centre.</p><span class="learner-text-link">Read updates <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a>
        </aside>
    </div>
</div>
