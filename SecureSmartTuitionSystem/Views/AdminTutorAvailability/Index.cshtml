@model SecureSmartTuitionSystem.ViewModels.Tutor.TutorAvailabilityOverviewViewModel
@using SecureSmartTuitionSystem.Models.Tutor
@using SecureSmartTuitionSystem.Services.Tutor
@{ ViewData["Title"] = "Tutor Availability"; }
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-availability.css" asp-append-version="true" />
}
<div class="page-header">
    <div><h1>Tutor Availability</h1><p>@Model.TutorId · @Model.FullName</p></div>
    <a asp-controller="TutorManagement" asp-action="Details" asp-route-userId="@Model.UserId" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</a>
</div>
<p class="form-text mb-4">Monday–Saturday · 08:00–22:00 MYT · Maximum 8 hours per day · Maintained by the tutor</p>
<div data-availability-live data-live-url="@Url.Action("Index", new { userId = Model.UserId, partial = true })">
    <p class="form-text d-none" data-availability-live-status role="status" aria-live="polite"></p>
    <partial name="_AvailabilityState" model="Model" />
</div>
@section Scripts { <script src="~/js/tutor-availability-live.js" asp-append-version="true"></script> }
