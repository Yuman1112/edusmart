@model SecureSmartTuitionSystem.ViewModels.Learning.MaterialForm
@{
    ViewData["Title"] = "Edit Learning Material";
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learning-materials.css" asp-append-version="true" />
}
<div class="learning-materials-page">
    <div class="page-header"><div><h1>Edit Learning Material</h1><p>Update the title, description or attachments. The class stays unchanged.</p></div><a asp-action="Details" asp-route-id="@Model.Id" class="outline-button">Back</a></div>
    <div class="class-form-card tutor-create-card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<partial name="_Form" model="Model" /></form></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/learning-materials-files.js" asp-append-version="true"></script>
}
