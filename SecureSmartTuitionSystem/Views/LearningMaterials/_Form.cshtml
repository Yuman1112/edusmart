@model SecureSmartTuitionSystem.ViewModels.Learning.MaterialForm
@using SecureSmartTuitionSystem.Services.Learning
<div asp-validation-summary="All" class="alert alert-danger material-validation" role="alert"></div>
<input asp-for="Id" type="hidden" />
<input asp-for="RowVersion" type="hidden" />
<div id="material-no-classes" class="alert alert-info" role="status" hidden="@(Model.Classes.Count > 0)">No active assigned classes are available for managing materials. Contact your administrator.</div>
<div id="material-class-update" class="alert alert-warning" role="status" hidden></div>
<div class="row g-4">
    <div class="col-12">
        <label asp-for="ClassSessionId" class="form-label"></label>
        @if (Model.Id == 0)
        {
            <select asp-for="ClassSessionId" asp-items="Model.Classes" class="form-select"><option value="">Select assigned class</option></select>
        }
        else
        {

            <input asp-for="ClassSessionId" type="hidden" />
            <select class="form-select" disabled aria-label="Class (read only)">
                @* Selection below uses the model's immutable class. *@
                @foreach (var item in Model.Classes)
                {
                    <option value="@item.Value" selected="@(item.Value == Model.ClassSessionId?.ToString())">@item.Text</option>
                }
            </select>
        }
        <span asp-validation-for="ClassSessionId" class="material-field-error"></span>
    </div>
    <div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" maxlength="150" placeholder="For example: Chapter 1 revision notes" /><span asp-validation-for="Title" class="material-field-error"></span></div>
    <div class="col-12"><label asp-for="Description" class="form-label">Description <span class="text-muted fw-normal">(Optional)</span></label><textarea asp-for="Description" class="form-control" maxlength="2000" rows="4"></textarea><span asp-validation-for="Description" class="material-field-error"></span></div>
    <div class="col-12">
        <div data-attachment-editor>
            <div class="material-attachment-heading">
                <div><label asp-for="Files" class="form-label">Material Files</label><p class="form-text" data-file-total role="status"></p></div>
                <button type="button" class="outline-button" data-add-files hidden><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Files</button>
            </div>
            <input asp-for="Files" type="file" multiple class="form-control" accept=".pdf,.docx,.pptx,.xlsx,.png,.jpg,.jpeg" />
            <div class="material-drop-zone" data-file-drop hidden role="region" aria-label="Add material files by dropping or choosing files">
                <div class="material-drop-prompt" data-file-empty hidden>
                    <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    <div><strong>Drag and drop files here</strong><span>or choose Add Files above.</span></div>
                </div>
                <div data-file-list>
                    @foreach (var file in Model.CurrentFiles)
                    {
                        bool removed = Model.RemovedAttachmentIds.Contains(file.Id);
                        string? previewType = MaterialFileService.PreviewContentType(file.Name);
                        string? previewUrl = Url.Action("Preview", "LearningMaterials", new { id = Model.Id, attachmentId = file.Id == 0 ? (int?)null : file.Id });
                        <div class="material-attachment-row" data-saved-file data-size="@file.Size" data-removed="@(removed ? "true" : "false")">
                            <div>
                                @if (previewType?.StartsWith("image/") == true)
                                {
                                    <a href="@previewUrl" target="_blank" rel="noopener" class="material-thumbnail" data-material-preview data-preview-name="@file.Name" data-preview-type="@previewType" aria-label="@($"Preview {file.Name} in a new tab")"><img src="@previewUrl" alt="@file.Name" loading="lazy" /></a>
                                }
                                else
                                {

                                    <i class="bi bi-file-earmark-text material-attachment-icon" aria-hidden="true"></i>
                                }
                                <span>@file.Name</span><small class="text-muted d-block">@file.SizeLabel · <span data-file-state>@(removed ? "Pending removal" : "Saved")</span></small>
                            </div>
                            <input type="hidden" name="RemovedAttachmentIds" value="@file.Id" disabled="@(!removed)" />
                            @if (previewType != null)
                            {
                                <a href="@previewUrl" target="_blank" rel="noopener" class="outline-button material-file-preview" data-material-preview data-preview-name="@file.Name" data-preview-type="@previewType">Preview</a>
                            }
                            <button type="button" class="outline-button" data-toggle-remove aria-label="@(removed ? $"Undo removal of {file.Name}" : $"Remove {file.Name}")">@(removed ? "Undo" : "×")</button>
                        </div>
                    }
                </div>
            </div>
            <p class="material-field-error" data-file-error role="alert" hidden></p>
            <span asp-validation-for="Files" class="material-field-error"></span>
            <div class="form-text mt-3 mb-0 d-flex flex-wrap align-items-center gap-2">
                <span>PDF, DOCX, PPTX, XLSX, PNG, JPG, JPEG</span>
                <span aria-hidden="true" class="mx-1">|</span>
                <span>Max. 10 files · 10 MB/file · 30 MB total</span>
            </div>
        </div>
    </div>
</div>
<div class="class-form-actions"><a asp-action="Index" class="outline-button">Cancel</a><button type="submit" class="primary-button" disabled="@(Model.Classes.Count == 0)">@(Model.Id == 0 ? "Upload Material" : "Save Changes")</button></div>
