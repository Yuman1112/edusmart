@model List<SecureSmartTuitionSystem.Models.Communication.UserNotification>
@{ ViewData["Title"] = "Notifications"; int currentPage = (int)ViewBag.Page; bool unreadOnly = (bool)ViewBag.UnreadOnly; }
<div class="page-header"><div><h1>Notifications</h1><p>Class cancellations, replacements and enrollment changes.</p></div></div>
<div class="notification-toolbar"><span>Unread notifications are highlighted. Reading one does not change your classes or payments.</span><form asp-action="ReadAll" method="post"><input type="hidden" name="page" value="@currentPage" /><input type="hidden" name="unreadOnly" value="@unreadOnly.ToString().ToLowerInvariant()" /><button type="submit" class="btn btn-outline-primary">Mark all as read</button></form></div>
<div class="d-flex gap-2 mb-3"><a asp-action="Index" asp-route-unreadOnly="false" class="btn @(unreadOnly ? "btn-outline-primary" : "btn-primary")">All</a><a asp-action="Index" asp-route-unreadOnly="true" class="btn @(unreadOnly ? "btn-primary" : "btn-outline-primary")">Unread</a></div>
@foreach (var n in Model)
{
<article class="class-details-card notification-card @(n.ReadAtUtc == null ? "is-unread" : "") mb-3"><h2>@n.Title</h2><small>@n.CreatedAtUtc.AddHours(8).ToString("dd MMM yyyy HH:mm") MYT · @(n.ReadAtUtc == null ? "Unread" : "Read")</small><p class="mt-2">@n.Text</p>
@if (n.ReadAtUtc == null)
{
<form asp-action="Read" method="post"><input type="hidden" name="page" value="@currentPage" /><input type="hidden" name="unreadOnly" value="@unreadOnly.ToString().ToLowerInvariant()" /><input type="hidden" name="id" value="@n.UserNotificationId" /><button type="submit" class="btn btn-sm btn-outline-primary">Mark as read</button></form>
}
</article>
}
@if (!Model.Any()) { <p>@(unreadOnly ? "No unread notifications." : "No notifications.")</p> }
<nav class="table-pagination" aria-label="Notification pages"><span class="table-pagination-summary">@ViewBag.TotalRecords record(s) · 25 per page</span><div class="table-pagination-controls">
@if (currentPage > 1) { <a class="table-page-button" asp-action="Index" asp-route-unreadOnly="@unreadOnly" asp-route-page="1">First</a><a class="table-page-button" asp-action="Index" asp-route-unreadOnly="@unreadOnly" asp-route-page="@(currentPage - 1)">Previous</a> } else { <button class="table-page-button" type="button" disabled>First</button><button class="table-page-button" type="button" disabled>Previous</button> }
@for (int number = Math.Max(1, currentPage - 2); number <= Math.Min((int)ViewBag.TotalPages, currentPage + 2); number++) { <a class="table-page-button @(number == currentPage ? "active" : "")" aria-current="@(number == currentPage ? "page" : null)" asp-action="Index" asp-route-unreadOnly="@unreadOnly" asp-route-page="@number">@number</a> }
@if (currentPage < (int)ViewBag.TotalPages) { <a class="table-page-button" asp-action="Index" asp-route-unreadOnly="@unreadOnly" asp-route-page="@(currentPage + 1)">Next</a><a class="table-page-button" asp-action="Index" asp-route-unreadOnly="@unreadOnly" asp-route-page="@ViewBag.TotalPages">Last</a> } else { <button class="table-page-button" type="button" disabled>Next</button><button class="table-page-button" type="button" disabled>Last</button> }
</div></nav>
