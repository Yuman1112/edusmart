@model SecureSmartTuitionSystem.ViewModels.Enrollment.BrowseClassesViewModel

@{
    ViewData["Title"] = "Browse Classes";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/browse-classes.css"
          asp-append-version="true" />
}

<div class="browse-page">

    <!-- Page header -->
    <header class="browse-page-header">
        <div>
            <span class="browse-eyebrow">
                <i class="bi bi-journal-bookmark"></i>
                Class Catalogue
            </span>

            <h1>Browse Available Classes</h1>

            <p>
                View available subjects, schedules,
                tuition fees and remaining seats.
            </p>
        </div>

        <a asp-controller="Enrollment"
           asp-action="StudentDetails"
           class="browse-primary-button">

            <i class="bi bi-pencil-square"></i>
            Start Enrollment
        </a>
    </header>

    <!-- Filters -->
    <section class="browse-card browse-filter-card">
        <div class="browse-card-header">
            <div>
                <h2>
                    <i class="bi bi-funnel"></i>
                    Find a Class
                </h2>

                <p>
                    Results update automatically when
                    a filter is selected.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SelectedStage) ||
                        !string.IsNullOrWhiteSpace(
                        Model.SelectedSubject) ||
                        !string.IsNullOrWhiteSpace(
                        Model.SelectedLevel))
            {
                <a asp-controller="Classes"
                   asp-action="Index"
                   class="browse-clear-link">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    Clear Filters
                </a>
            }
        </div>

        <form method="get" data-live-filter
              asp-controller="Classes"
              asp-action="Index"
              id="browseFilterForm"
              class="browse-filter-grid">
            <div class="browse-form-field browse-date-field"><label for="browseStartDate" class="form-label">Requested Start Date</label><input id="browseStartDate" name="requestedStartDate" type="date" value="@ViewBag.RequestedStartDate" min="@DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-dd")" max="@DateTime.UtcNow.AddHours(8).AddYears(1).ToString("yyyy-MM-dd")" class="form-control browse-filter-input" /></div>


            <div class="browse-form-field">
                <label for="stageFilter">Academic Stage</label>
                <select id="stageFilter" name="stage" class="form-select browse-filter-input">
                    <option value="">All Academic Stages</option>
                    <option value="Primary" selected="@(Model.SelectedStage == "Primary")">Primary</option>
                    <option value="Secondary" selected="@(Model.SelectedStage == "Secondary")">Secondary</option>
                </select>
            </div>
            <div class="browse-form-field">
                <label for="levelFilter">Academic Level</label>
                <select id="levelFilter" name="level" class="form-select browse-filter-input">
                    <option value="">All Academic Levels</option>
                    @foreach (var item in Model.AcademicLevels)
                    {
                        <option value="@item" selected="@(item == Model.SelectedLevel)">@item</option>
                    }
                </select>
            </div>
            <div class="browse-form-field">
                <label for="subjectFilter">Subject</label>
                <select id="subjectFilter" name="subject" class="form-select browse-filter-input">
                    <option value="">All Subjects</option>
                    @foreach (var item in Model.Subjects)
                    {
                        <option value="@item" selected="@(string.Equals(item, Model.SelectedSubject, StringComparison.OrdinalIgnoreCase))">@item</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="browse-primary-button">Apply filters</button></noscript>
        </form>
    </section>

    <!-- Class list -->
    <section class="browse-card browse-results-card">
        <div class="browse-card-header">
            <div>
                <h2>
                    <i class="bi bi-grid"></i>
                    Available Classes
                </h2>

                <p>
                    Select a suitable class before
                    submitting an enrollment request.
                </p>
            </div>

            <span class="browse-result-count">
                @Model.Classes.Count
                @(Model.Classes.Count == 1
                                ? "class"
                                : "classes")
            </span>
        </div>

        @if (Model.Classes.Count == 0)
        {
            <div class="browse-empty-state">
                <div class="browse-empty-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h3>No Classes Found</h3>

                <p>
                    <span>No available classes match the selected filters.</span>
                    <span>Try choosing another subject or academic level.</span>
                </p>

                <a asp-controller="Classes"
                   asp-action="Index"
                   class="browse-outline-button">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    View All Classes
                </a>
            </div>
        }
        else
        {
            <div class="browse-class-grid">
                @foreach (var item in Model.Classes)
                {
                    bool isFull =
                    item.SeatsRemaining <= 0;

                    <article class="browse-class-card
                                            @(isFull ? "class-full" : "")">

                        <div class="browse-class-card-header">
                            <div class="browse-class-heading">
                                <span class="browse-subject-icon">
                                    <i class="bi bi-book"></i>
                                </span>

                                <div>
                                    <h3>
                                        <span style="display:block;">@item.AcademicLevel - @item.SubjectName - @item.TutorName</span>
                                        <span style="display:block;">@item.Day - @item.StartTime</span>
                                    </h3>

                                    <span class="browse-level-text">
                                        @item.SubjectName
                                    </span>
                                </div>
                            </div>

                            @if (isFull)
                            {
                                <span class="browse-status-pill full">
                                    Full
                                </span>
                            }
                            else
                            {
                                <span class="browse-status-pill available">
                                    Available
                                </span>
                            }
                        </div>

                        <div class="browse-class-information">
                            <div class="browse-info-item">
                                <span class="browse-info-icon">
                                    <i class="bi bi-person"></i>
                                </span>

                                <div>
                                    <span class="browse-info-label">
                                        Tutor
                                    </span>

                                    <strong>
                                        @item.TutorName
                                    </strong>
                                </div>
                            </div>

                            <div class="browse-info-item">
                                <span class="browse-info-icon">
                                    <i class="bi bi-calendar-week"></i>
                                </span>

                                <div>
                                    <span class="browse-info-label">
                                        Class Day
                                    </span>

                                    <strong>
                                        @item.Day
                                    </strong>
                                </div>
                            </div>

                            <div class="browse-info-item">
                                <span class="browse-info-icon">
                                    <i class="bi bi-clock"></i>
                                </span>

                                <div>
                                    <span class="browse-info-label">
                                        Time
                                    </span>

                                    <strong>
                                        @item.StartTime –
                                        @item.EndTime
                                    </strong>
                                </div>
                            </div>

                            <div class="browse-info-item">
                                <span class="browse-info-icon">
                                    <i class="bi bi-people"></i>
                                </span>

                                <div>
                                    <span class="browse-info-label">
                                        Remaining Seats
                                    </span>

                                    <strong>
                                        @Math.Max(
                                        item.SeatsRemaining,
                                                                0)
                                / @item.Capacity
                            </strong>
                        </div>
                    </div>
                </div>

                <div class="browse-class-card-footer">
                    <div class="browse-fee">
                        <span>Monthly Fee</span>

                        @if (item.MonthlyFee <= 0)
                                {
                                    <strong class="browse-free-fee">
                                        Free
                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        RM @(item.MonthlyFee.ToString("F2"))
                                    </strong>
                                }
                            </div>

                            @if (isFull)
                            {
                                <button type="button"
                                        class="browse-disabled-button"
                                        disabled>
                                    <i class="bi bi-x-circle"></i>
                                    Class Full
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Enrollment"
                                   asp-action="StudentDetails"
                                   class="browse-primary-button
                                                      browse-card-button">

                                    Enrol Now
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>


@section Scripts {
    <script src="~/js/browse-class-filters.js" asp-append-version="true"></script>
}
