@model SecureSmartTuitionSystem.ViewModels.Security.SecurityDetailsViewModel
@using SecureSmartTuitionSystem.Services.Security
@{ ViewData["Title"] = "Security Activity Details"; var entry = Model.Entry; }
<div class="page-header"><div><h1>Activity Details</h1><p>@Model.Summary</p></div>
@if (Model.ReturnUrl != null) { <a href="@Model.ReturnUrl" class="outline-button">Back to activity</a> } else { <a asp-action="Index" class="outline-button">Back to activity</a> }
</div>
@if (!Model.IntegrityValid) { <div class="alert alert-danger">This record failed integrity verification. Review the original log and investigate before relying on its contents.</div> }
<section class="dashboard-card mb-4"><header class="dashboard-card-header"><h2>Activity overview</h2><span>@entry.Severity</span></header>
<div class="p-3"><dl class="row mb-0">
<dt class="col-sm-3">Time (MYT)</dt><dd class="col-sm-9">@entry.OccurredAtUtc.AddHours(8).ToString("dd MMM yyyy HH:mm:ss")</dd>
<dt class="col-sm-3">User</dt><dd class="col-sm-9">@SecurityActivityText.UserLabel(entry.ActorName)</dd>
<dt class="col-sm-3">What happened</dt><dd class="col-sm-9">@Model.Summary</dd>
<dt class="col-sm-3">Record check</dt><dd class="col-sm-9">@(Model.IntegrityValid ? "Verified against its stored integrity proof." : "Verification failed.")</dd>
</dl></div></section>
@if (Model.AIConfigured && Model.IntegrityValid)
{
<section class="dashboard-card mb-4"><header class="dashboard-card-header"><h2>Simple explanation</h2></header><div class="p-3">
<p>Generate an optional AI explanation of the activity description. Personal details and the original log are not sent.</p>
<form asp-action="Explain" method="post"><input type="hidden" name="id" value="@entry.AuditLogEntryId" /><input type="hidden" name="returnUrl" value="@Model.ReturnUrl" /><button class="outline-button" type="submit">Explain with AI</button></form>
@if (Model.AIExplanation != null) { <div class="alert alert-info mt-3 mb-0"><strong>@(Model.GeneratedByAI ? "AI explanation — check against the original record." : "AI unavailable — showing the local description.")</strong><p class="mb-0">@Model.AIExplanation</p></div> }
</div></section>
}
<section class="dashboard-card"><header class="dashboard-card-header"><h2>Technical details</h2></header><div class="p-3 text-break"><dl class="row mb-0">
<dt class="col-sm-3">Log number</dt><dd class="col-sm-9">@entry.AuditLogEntryId</dd>
<dt class="col-sm-3">Event code</dt><dd class="col-sm-9">@entry.EventName</dd>
<dt class="col-sm-3">Record type</dt><dd class="col-sm-9">@entry.EntityName</dd>
<dt class="col-sm-3">Record reference</dt><dd class="col-sm-9">@entry.EntityKey</dd>
<dt class="col-sm-3">Original description</dt><dd class="col-sm-9">@entry.Summary</dd>
<dt class="col-sm-3">Account reference</dt><dd class="col-sm-9">@entry.ActorUserId</dd>
<dt class="col-sm-3">IP address</dt><dd class="col-sm-9">@entry.RemoteIp</dd>
<dt class="col-sm-3">Trace reference</dt><dd class="col-sm-9">@entry.TraceId</dd>
</dl></div></section>
