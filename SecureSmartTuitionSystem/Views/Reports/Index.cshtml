@model SecureSmartTuitionSystem.Services.Reporting.IncomeReport
@using System.Globalization
@{
    ViewData["Title"] = "Reports & Analytics";
    var highest = Model.Months.Max(x => x.Gross);
    string chosen = Model.EndMonth.ToString("yyyy-MM", CultureInfo.InvariantCulture);
}
@section Styles { <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" /> }
<div class="page-header"><div><h1>Reports &amp; Analytics</h1><p>View payment activity for the selected period.</p></div></div>
<section class="reports-card">
    <form method="get" asp-action="Index" data-live-filter class="reports-toolbar">
        <div><label for="report-year" class="form-label">Year</label><select id="report-year" name="year" class="form-select">
            @for (var year = DateTime.UtcNow.AddHours(8).Year; year >= 2000; year--)
            {
                <option value="@year" selected="@(Model.EndMonth.Year == year)">@year</option>
            }
        </select></div>
        <div><label for="report-month" class="form-label">Ending month</label><select id="report-month" name="month" class="form-select">
            @for (var month = 1; month <= 12; month++)
            {
                var isFuture = Model.EndMonth.Year == DateTime.UtcNow.AddHours(8).Year && month > DateTime.UtcNow.AddHours(8).Month;
                <option value="@month" selected="@(Model.EndMonth.Month == month)" disabled="@isFuture">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month)</option>
            }
        </select></div>
        <div><label for="months" class="form-label">Number of months</label><select id="months" name="months" class="form-select">
            @for (var count = 1; count <= 12; count++)
            {
                <option value="@count" selected="@(Model.Months.Count == count)">@count @(count == 1 ? "month" : "months")</option>
            }
        </select></div>
        <button type="submit" class="primary-button">Apply</button>
        <a class="outline-button" asp-action="Pdf" asp-route-end="@chosen" asp-route-months="@Model.Months.Count">Export PDF</a>
        <a class="outline-button" asp-action="Excel" asp-route-end="@chosen" asp-route-months="@Model.Months.Count">Export Excel</a>
    </form>
    <p class="reports-note">MYR payments and tracked refunds are grouped by Malaysia time. Gross includes successful payments; net deducts completed refunds recorded in this system. Other refunds, fees and taxes are not included. Current-month figures are month-to-date (Malaysia time).</p>
</section>
<div class="reports-summary">
    <section class="reports-card"><span>Gross received</span><strong>RM @Model.Gross.ToString("N2")</strong></section>
    <section class="reports-card"><span>Tracked refunds</span><strong>RM @Model.Refunds.ToString("N2")</strong></section>
    <section class="reports-card"><span>Net tracked</span><strong>RM @Model.Net.ToString("N2")</strong></section>
</div>
<section class="reports-card">
    <h2>Gross payments by month</h2>
    <p class="reports-note">The table below gives the exact amounts and payment counts.</p>
    <div class="reports-chart" aria-hidden="true">
        @foreach (var row in Model.Months)
        {
            var width = highest > 0 ? (row.Gross / highest * 100m).ToString("0.##", CultureInfo.InvariantCulture) : "0";
            <div class="reports-bar-row"><span>@row.Month.ToString("MMM yyyy", CultureInfo.InvariantCulture)</span><div class="reports-track"><div class="reports-bar" style="width:@(width)%"></div></div><strong>RM @row.Gross.ToString("N2")</strong></div>
        }
    </div>
    <div class="reports-table-wrap" role="region" aria-label="Payment report for selected months" tabindex="0">
        <table class="table reports-table"><caption>Payment activity in Malaysia time. Amounts are in MYR.</caption>
            <thead><tr><th scope="col">Month</th><th scope="col">Gross received</th><th scope="col">Tracked refunds</th><th scope="col">Net tracked</th><th scope="col">Payments</th></tr></thead>
            <tbody>@foreach (var row in Model.Months) { <tr><th scope="row">@row.Month.ToString("MMM yyyy", CultureInfo.InvariantCulture)</th><td>@row.Gross.ToString("N2")</td><td>@row.Refunds.ToString("N2")</td><td>@row.Net.ToString("N2")</td><td>@row.PaymentCount</td></tr> }</tbody>
        </table>
    </div>
</section>
