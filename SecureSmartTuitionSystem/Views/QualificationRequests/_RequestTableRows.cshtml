@model IReadOnlyList<SecureSmartTuitionSystem.ViewModels.Tutor.QualificationUpdateRow>
@using SecureSmartTuitionSystem.Models.Tutor
@{ bool admin = User.IsInRole("Admin"); int number = 0; }
        @foreach (var request in Model) {
            number++;
            var badge = request.Status switch { QualificationUpdateStatus.Approved => "tutor-badge-success", QualificationUpdateStatus.Rejected => "teaching-badge-rejected", QualificationUpdateStatus.Cancelled => "qualification-badge-neutral", _ => "tutor-badge-pending" };
            <tr data-request-id="@request.Id" data-request-status="@((int)request.Status)" data-request-version="@($"{request.Status}|{request.ReviewNotes}")"><td>@number</td><td data-sort-value="@request.Id"><strong>#@request.Id</strong></td>
                @if (admin) { <td><strong>@request.TutorName</strong><div class="small text-muted">@request.TutorId</div></td> }
                <td class="qualification-details-cell"><strong>@request.Qualification</strong><div class="small text-muted">@request.FieldOfStudy · @request.AreaOfExpertise</div><details class="qualification-reason"><summary>Reason for request</summary><p>@request.Reason</p></details></td>
                <td data-sort-value="@request.SubmittedAtUtc.ToString("O")">@request.SubmittedAtUtc.AddHours(8).ToString("dd MMM yyyy")<div class="small text-muted">@request.SubmittedAtUtc.AddHours(8).ToString("h:mm tt") MYT</div></td>
                <td><span class="tutor-management-badge @badge" data-qualification-status>@request.StatusLabel</span></td>
                @if (!admin) { <td class="teaching-table-notes"><span data-qualification-notes>@(string.IsNullOrWhiteSpace(request.ReviewNotes) ? "—" : request.ReviewNotes)</span><div class="small"><a asp-controller="QualificationRequests" asp-action="Document" asp-route-id="@request.Id">@request.CertificateName</a></div></td> }
                <td>
                    @if (admin) { <span hidden data-qualification-notes>@(string.IsNullOrWhiteSpace(request.ReviewNotes) ? "—" : request.ReviewNotes)</span><a asp-controller="QualificationRequests" asp-action="Review" asp-route-id="@request.Id" class="outline-button teaching-review-link"><i class="bi bi-eye" aria-hidden="true"></i> <span data-qualification-review-label>@(request.Status == QualificationUpdateStatus.Pending ? "Review" : "View")</span></a> }
                    else {
                        <form asp-controller="QualificationRequests" asp-action="Cancel" method="post" asp-antiforgery="true" data-qualification-cancel class="@(request.Status == QualificationUpdateStatus.Pending ? "" : "d-none")"><input type="hidden" name="id" value="@request.Id" /><button type="submit" class="outline-button">Cancel Request</button></form>
                        <span class="text-muted @(request.Status == QualificationUpdateStatus.Pending ? "d-none" : "")" data-qualification-no-action>—</span>
                    }
                </td>
            </tr>
        }
