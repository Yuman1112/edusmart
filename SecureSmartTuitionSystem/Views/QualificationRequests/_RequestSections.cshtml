@model SecureSmartTuitionSystem.ViewModels.Tutor.QualificationDecisionInput
@{var r=Model.Request!;}
@if(r.Changes.Count>0){<section class="class-details-section"><h3><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Requested Changes</h3><div class="table-responsive qualification-diff-wrap"><table class="table qualification-diff-table" data-server-managed="true"><thead><tr><th>Field</th><th>Original Value</th><th>Requested Value</th></tr></thead><tbody>@foreach(var c in r.Changes){<tr><th scope="row">@c.Label</th><td data-label="Original Value">@(string.IsNullOrWhiteSpace(c.Before)?"Not provided":c.Before)</td><td data-label="Requested Value" class="qualification-new-value">@c.After</td></tr>}</tbody></table></div></section>}
<section class="class-details-section"><div class="teaching-section-heading"><h3><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Supporting Documents</h3><span class="form-text">@r.Files.Count @(r.Files.Count==1?"file":"files")</span></div>@if(r.HasCertificate){<partial name="_DocumentList" model="new SecureSmartTuitionSystem.ViewModels.Tutor.QualificationFileList {OwnerId=r.Id,Files=r.Files}" />}else{<p class="qualification-detail-copy">No new files submitted.</p>}</section>
