@model IReadOnlyList<SecureSmartTuitionSystem.ViewModels.Tutor.QualificationUpdateRow>
@using SecureSmartTuitionSystem.Models.Tutor
@{ViewData["Title"]="Qualification Update Requests"; bool pending=ViewData["QualificationHasPending"] is bool hasPending ? hasPending : Model.Any(r=>r.Status==QualificationUpdateStatus.Pending);}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teaching-requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/qualification-requests.css" asp-append-version="true" />
}
<div class="qualification-requests-page" data-qualification-live-url="@Url.Action("Live", "QualificationRequests")">
    <div class="page-header"><div><h1>Qualification Update Requests</h1><p>Track your qualification update requests.</p></div><div class="qualification-page-actions"><a asp-controller="Tutor" asp-action="EditProfile" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Edit Profile</a><a asp-action="Create" class="primary-button @(pending ? "d-none" : "")" data-qualification-new><i class="bi bi-plus" aria-hidden="true"></i> New Request</a></div></div>
    @if(TempData["QualificationSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}
    <div class="alert alert-info @(pending ? "" : "d-none")" data-qualification-pending-list role="status">You have a pending request. View or cancel it before starting another.</div>
    <partial name="_Filters" />
    <partial name="/Views/QualificationRequests/_RequestTable.cshtml" model="Model" />
</div>
@section Scripts {<script src="~/js/qualification-live.js" asp-append-version="true"></script>}
