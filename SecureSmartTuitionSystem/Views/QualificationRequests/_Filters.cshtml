@using SecureSmartTuitionSystem.Models.Tutor
@{var search=ViewData["QualificationSearch"] as string;var selected=ViewData["QualificationStatus"] as QualificationUpdateStatus?;var from=ViewData["QualificationFrom"] as string;var to=ViewData["QualificationTo"] as string;var filtered=!string.IsNullOrEmpty(search)||selected.HasValue||!string.IsNullOrEmpty(from)||!string.IsNullOrEmpty(to);}
<form method="get" class="class-filter-card" data-qualification-filter>
    <div class="class-filter-heading"><div><h2><i class="bi bi-funnel" aria-hidden="true"></i> Filter Requests</h2><p>Search and filter qualification update requests.</p></div><a href="@(User.IsInRole("Admin")?Url.Action("Index"):Url.Action("Mine"))" class="clear-filter-link @(filtered?"":"d-none")" data-qualification-clear><i class="bi bi-x-circle" aria-hidden="true"></i> Clear Filters</a></div>
    <div class="class-filter-grid qualification-filter-grid"><div><label for="qualification-search" class="form-label">Search</label><input id="qualification-search" name="search" value="@search" class="form-control" placeholder="@(User.IsInRole("Admin")?"Request ID, tutor or qualification":"Request ID or qualification")" maxlength="200" /></div><div><label for="qualification-status" class="form-label">Status</label><select id="qualification-status" name="status" class="form-select"><option value="">All Statuses</option>@foreach(var item in Enum.GetValues<QualificationUpdateStatus>()){<option value="@item" selected="@(selected==item)">@(item==QualificationUpdateStatus.Pending?"Pending Review":item.ToString())</option>}</select></div><div><label for="qualification-from" class="form-label">Submitted From</label><input id="qualification-from" name="from" type="date" value="@from" class="form-control" /></div><div><label for="qualification-to" class="form-label">Submitted To</label><input id="qualification-to" name="to" type="date" value="@to" class="form-control" /></div></div>
    <noscript><button type="submit" class="outline-button mt-3">Apply Filters</button></noscript>
</form>
