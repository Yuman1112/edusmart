@model SecureSmartTuitionSystem.ViewModels.Tutor.QualificationUpdateInput
@using SecureSmartTuitionSystem.Models.Tutor
@{ ViewData["Title"] = "Request Qualification Update"; bool pending = Model.Requests.Any(r => r.Status == QualificationUpdateStatus.Pending); }
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teaching-requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learning-materials.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/qualification-requests.css" asp-append-version="true" />
}
<div class="qualification-requests-page learning-materials-page" data-qualification-live-url="@Url.Action("Live", "QualificationRequests")">
    <div class="page-header"><div><h1>Request Qualification Update</h1><p>Request approval for updated qualifications and supporting certificates.</p></div><a asp-action="Mine" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Requests</a></div>
    @if (TempData["QualificationSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="class-form-card tutor-create-card mb-4">
        <form id="qualification-request-form" data-original-qualification="@Model.CurrentQualification" data-original-field="@Model.CurrentFieldOfStudy" data-original-expertise="@Model.CurrentAreaOfExpertise" data-pending="@pending.ToString().ToLowerInvariant()" asp-action="Mine" method="post" enctype="multipart/form-data" asp-antiforgery="true">
            <input asp-for="BaselineToken" type="hidden" />
            <section class="class-form-section">
                <section class="qualification-current-summary" aria-labelledby="current-qualification-heading">
                    <h2 id="current-qualification-heading"><i class="bi bi-patch-check" aria-hidden="true"></i> Current Qualification</h2>
                    <div class="qualification-summary-grid">
                        <div class="class-detail-item"><span>Highest Qualification</span><strong data-qualification-field="qualification">@Model.CurrentQualification</strong></div>
                        <div class="class-detail-item"><span>Field of Study</span><strong data-qualification-field="fieldOfStudy">@(string.IsNullOrWhiteSpace(Model.CurrentFieldOfStudy)?"Not provided":Model.CurrentFieldOfStudy)</strong></div>
                        <div class="class-detail-item"><span>Area of Expertise</span><strong data-qualification-field="areaOfExpertise">@(string.IsNullOrWhiteSpace(Model.CurrentAreaOfExpertise)?"Not provided":Model.CurrentAreaOfExpertise)</strong></div>
                    </div>
                </section>
                <p class="tutor-section-description">Edit only the details you want to update. Other details will remain unchanged.</p>
                <div class="alert alert-info @(pending ? "" : "d-none")" role="status" data-qualification-pending-form>A request is pending review. Cancel it in My Requests before submitting another.</div>
                <div class="teaching-validation-notice" hidden="@ViewData.ModelState.IsValid" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><div><strong>Please review the highlighted fields.</strong><div asp-validation-summary="ModelOnly" class="teaching-model-errors"></div></div></div>
                <div class="row g-4">
                    <div class="col-md-6"><label asp-for="Qualification" class="form-label">Highest Qualification <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Qualification" class="form-control" maxlength="200" required disabled="@pending" /><span asp-validation-for="Qualification" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="FieldOfStudy" class="form-label"></label><input asp-for="FieldOfStudy" class="form-control" maxlength="200" required="@(!string.IsNullOrWhiteSpace(Model.CurrentFieldOfStudy))" disabled="@pending" /><span asp-validation-for="FieldOfStudy" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="AreaOfExpertise" class="form-label"></label><input asp-for="AreaOfExpertise" class="form-control" maxlength="200" required="@(!string.IsNullOrWhiteSpace(Model.CurrentAreaOfExpertise))" disabled="@pending" /><span asp-validation-for="AreaOfExpertise" class="text-danger"></span></div>
                    <div class="col-12 teaching-request-reason"><label asp-for="Reason" class="form-label">Reason for Request <span class="text-danger" aria-hidden="true">*</span></label><textarea asp-for="Reason" class="form-control" rows="3" maxlength="1000" placeholder="Tell us what has changed in your qualifications." required disabled="@pending"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div>
                    <div class="col-12"><div data-attachment-editor data-qualification-upload data-max-files="5" data-max-total-mb="25" data-extensions="pdf,png,jpg,jpeg">
                        <div class="material-attachment-heading"><div><label asp-for="Certificates" class="form-label">Supporting Documents <span class="text-danger d-none" aria-hidden="true" data-certificate-required>*</span></label><p class="form-text" data-file-total role="status"></p></div><button type="button" class="outline-button" data-add-files hidden><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Files</button></div>
                        <input asp-for="Certificates" type="file" multiple class="form-control" accept=".pdf,.png,.jpg,.jpeg" disabled="@pending" aria-describedby="qualification-file-help" />
                        <div class="material-drop-zone" data-file-drop hidden role="region" aria-label="Add supporting documents by dropping or choosing files"><div class="material-drop-prompt" data-file-empty hidden><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i><div><strong>Drag and drop files here</strong><span>or choose Add Files above.</span></div></div><div data-file-list></div></div>
                        <p class="material-field-error" data-file-error role="alert" hidden></p><span asp-validation-for="Certificates" class="material-field-error"></span>
                        <div id="qualification-file-help" class="form-text mt-3">PDF, PNG or JPG · Up to 5 files · 10 MB per file · 25 MB total.</div>
                        <p class="form-text mb-0">Required when changing your highest qualification; optional otherwise. Approved files replace your current qualification documents as a group.</p>
                    </div></div>
                </div>
            </section>
            <div class="class-form-actions"><a asp-action="Mine" class="outline-button" data-qualification-leave>Cancel</a><button type="submit" class="primary-button" disabled="@pending"><i class="bi bi-send" aria-hidden="true"></i> Submit for Review</button></div>
        </form>
    </div>

</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> <script src="~/js/qualification-request-changes.js" asp-append-version="true"></script> <script src="~/js/learning-materials-files.js" asp-append-version="true"></script> <script src="~/js/learning-materials-preview.js" asp-append-version="true"></script> <script src="~/js/qualification-navigation.js" asp-append-version="true"></script> <script src="~/js/qualification-live.js" asp-append-version="true"></script> }
