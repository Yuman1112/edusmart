@model SecureSmartTuitionSystem.ViewModels.Enrollment.ClassSessionFormViewModel

@{
    bool guided = ViewData["GuidedTutorAssignment"] is true;

    var initialDuration = Model.StartTime.HasValue && Model.EndTime.HasValue
        ? (int)(Model.EndTime.Value - Model.StartTime.Value).TotalMinutes
        : 120;

    if (initialDuration < 30 || initialDuration > 240)
    {
        initialDuration = 120;
    }
}

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>

<div class="class-form-section">
    <h2>
        <i class="bi bi-calendar-range"></i>
        Class Validity
    </h2>

    <div class="row g-4">
        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label"></label>

            <input asp-for="StartDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="StartDate"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EndDate" class="form-label"></label>

            <input asp-for="EndDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="EndDate"
                  class="text-danger"></span>

            <small class="text-muted">
                Academic year: January–December.
                Leave blank to end on 31 December of the start year.
            </small>
        </div>
    </div>

    <p class="text-muted mt-3">
        Weekly lessons exist only within this period.
        Once the class starts, use Calendar for individual cancellations
        and replacements.
    </p>
</div>

<input type="hidden"
       id="InitialAcademicLevel"
       value="@Model.AcademicLevel" />

<input type="hidden"
       id="InitialSubjectName"
       value="@Model.SubjectName" />

<div class="class-form-section">
    <h2>
        <i class="bi bi-book-fill"></i>
        Subject Information
    </h2>

    <div class="row g-4">
        <div class="col-md-6">
            <label asp-for="EducationStage" class="form-label"></label>

            <select asp-for="EducationStage"
                    asp-items="Model.EducationStages"
                    id="EducationStage"
                    class="form-select">
                <option value="">-- Select Education Stage --</option>
            </select>

            <span asp-validation-for="EducationStage"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="AcademicLevel" class="form-label"></label>

            <select asp-for="AcademicLevel"
                    id="AcademicLevel"
                    class="form-select">
                <option value="">-- Select Academic Level --</option>
            </select>

            <span asp-validation-for="AcademicLevel"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="SubjectName" class="form-label"></label>

            <select asp-for="SubjectName"
                    id="SubjectName"
                    class="form-select">
                <option value="">-- Select Subject --</option>
            </select>

            <span asp-validation-for="SubjectName"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="MonthlyFee" class="form-label"></label>

            <div class="input-group">
                <span class="input-group-text">RM</span>

                <input asp-for="MonthlyFee"
                       class="form-control"
                       type="number"
                       min="0"
                       max="99999"
                       step="0.01"
                       placeholder="0.00" />
            </div>

            <span asp-validation-for="MonthlyFee"
                  class="text-danger"></span>

            <div class="form-text">
                Enter RM0 for a free class.
            </div>
        </div>
    </div>
</div>

<div class="class-form-section">
    <h2>
        <i class="bi bi-calendar-check-fill"></i>
        Class Session Information
    </h2>

    <div class="row g-4">
        <div class="@(guided ? "col-12 col-lg-9" : "col-12")">
            <label asp-for="ClassName" class="form-label"></label>

            <div class="input-group">
                <input asp-for="ClassName"
                       id="ClassName"
                       class="form-control"
                       placeholder="Class Name will be suggested automatically" />

                <button type="button"
                        id="UseSuggestedName"
                        class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i>
                    Use Suggested
                </button>
            </div>

            <span asp-validation-for="ClassName"
                  class="text-danger"></span>

            <div class="form-text">
                Suggested format:
                Academic Level - Subject - Tutor - Class Day - Start Time.
                You may enter another unique Class Name.
            </div>
        </div>

        @if (guided)
        {
            <div class="col-12 col-lg-3">
                <label asp-for="Capacity" class="form-label"></label>

                <input asp-for="Capacity"
                       class="form-control"
                       type="number"
                       min="1"
                       max="100"
                       step="1" />

                <span asp-validation-for="Capacity"
                      class="text-danger"></span>
            </div>

            <div class="col-12 tutor-scheduling">

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="LessonDurationMinutes"
                               class="form-label">
                            Lesson Duration (minutes)
                        </label>

                        <input id="LessonDurationMinutes"
                               type="number"
                               class="form-control"
                               min="30"
                               max="240"
                               step="1"
                               value="@initialDuration"
                               list="lesson-duration-options"
                               required />

                        <datalist id="lesson-duration-options">
                            <option value="30"></option>
                            <option value="45"></option>
                            <option value="60"></option>
                            <option value="90"></option>
                            <option value="120"></option>
                            <option value="150"></option>
                            <option value="180"></option>
                            <option value="240"></option>
                        </datalist>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="TutorUserId" class="form-label">
                            Qualified Tutor
                        </label>

                        <select asp-for="TutorUserId"
                                asp-items="Model.Tutors"
                                id="TutorUserId"
                                class="form-select">
                            <option value="">Select tutor</option>
                        </select>

                        <span asp-validation-for="TutorUserId"
                              class="text-danger"></span>
                    </div>
                </div>

                <div id="tutor-scheduling-status"
                     class="alert alert-info"
                     role="status"
                     aria-live="polite">
                    Complete the subject, level, term and duration
                    to load qualified tutors.
                </div>

                <div id="tutor-scheduling-results" hidden>
                    <h4 class="tutor-slot-heading">
                        Available Weekly Times
                        <small>MYT (UTC+8)</small>
                    </h4>

                    <div id="tutor-scheduling-slots"
                         class="tutor-slot-list"></div>

                    <small id="tutor-scheduling-checked"
                           class="text-muted"></small>

                    <p class="form-text">
                        Availability updates automatically.
                        The selected time is checked again when you save.
                    </p>
                </div>

                <noscript>
                    <p class="text-danger">
                        Enable JavaScript to select an available weekly time.
                    </p>
                </noscript>
            </div>
        }
        else
        {
            <div class="col-12">
                <label asp-for="TutorUserId" class="form-label"></label>

                <select asp-for="TutorUserId"
                        asp-items="Model.Tutors"
                        id="TutorUserId"
                        class="form-select">
                    <option value="">-- Select Tutor --</option>
                </select>

                <span asp-validation-for="TutorUserId"
                      class="text-danger"></span>

                <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                    <a id="review-tutor-availability"
                       class="outline-button d-none"
                       href="@Url.Action("Index", "AdminTutorAvailability", new { userId = Model.TutorUserId })"
                       data-base-url="@Url.Action("Index", "AdminTutorAvailability")"
                       target="_blank"
                       rel="noopener">
                        View Tutor Availability
                        <span class="visually-hidden">
                            (opens in a new tab)
                        </span>
                    </a>

                    <small class="form-text m-0">
                        The tutor's availability and timetable conflicts are checked when you save.
                    </small>
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="Capacity" class="form-label"></label>

                <input asp-for="Capacity"
                       class="form-control"
                       type="number"
                       min="1"
                       max="100"
                       step="1" />

                <span asp-validation-for="Capacity"
                      class="text-danger"></span>
            </div>
        }

        <div class="col-md-4">
            @if (guided)
            {
                <label for="ChosenClassDay" class="form-label">
                    Class Day
                </label>

                <input asp-for="DayOfWeek"
                       type="hidden"
                       id="DayOfWeek" />

                <input id="ChosenClassDay"
                       class="form-control"
                       readonly
                       value="@Model.DayOfWeek"
                       placeholder="Select a weekly time above" />
            }
            else
            {
                <label asp-for="DayOfWeek" class="form-label"></label>

                <select asp-for="DayOfWeek"
                        asp-items="Model.Days"
                        id="DayOfWeek"
                        class="form-select">
                    <option value="">-- Select Day --</option>
                </select>
            }

            <span asp-validation-for="DayOfWeek"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="StartTime" class="form-label"></label>

            <input asp-for="StartTime"
                   id="StartTime"
                   class="form-control"
                   type="time"
                   step="@(guided ? "60" : "300")"
                   readonly="@guided" />

            <span asp-validation-for="StartTime"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="EndTime" class="form-label"></label>

            <input asp-for="EndTime"
                   id="EndTime"
                   class="form-control"
                   type="time"
                   step="@(guided ? "60" : "300")"
                   readonly="@guided" />

            <span asp-validation-for="EndTime"
                  class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Venue" class="form-label">
                Google Meet Link
            </label>

            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-camera-video-fill"></i>
                </span>

                <input asp-for="Venue"
                       class="form-control"
                       type="url"
                       placeholder="https://meet.google.com/abc-defg-hij" />
            </div>

            <span asp-validation-for="Venue"
                  class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Remark" class="form-label">
                Remark
                <span class="text-muted fw-normal">(Optional)</span>
            </label>

            <textarea asp-for="Remark"
                      class="form-control"
                      rows="4"
                      maxlength="500"
                      placeholder="Example: Trial class, replacement class, exam preparation or special instructions."></textarea>

            <span asp-validation-for="Remark"
                  class="text-danger"></span>

            <div class="form-text">
                Maximum 500 characters.
                Tutor will be able to view this remark.
            </div>
        </div>
    </div>
</div>