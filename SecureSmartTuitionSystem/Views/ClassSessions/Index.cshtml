@model SecureSmartTuitionSystem.ViewModels.Enrollment.ClassSessionIndexViewModel

@using SecureSmartTuitionSystem.Models.Enrollment
@using SecureSmartTuitionSystem.Services.Enrollment

@{
    ViewData["Title"] = "Manage Class Sessions";

    DayOfWeek[] orderedDays =
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/class-sessions.css"
          asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Class Sessions</h1>

        <p>
            Create and manage online tuition class schedules.
        </p>
    </div>

    <a asp-controller="ClassSessions"
       asp-action="Create"
       class="primary-button">

        <i class="bi bi-plus-lg"></i>
        Create Class Session
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-circle-fill me-2"></i>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<form asp-controller="ClassSessions"
      asp-action="Index"
      method="get" data-live-filter
      id="classFilterForm"
      class="class-filter-card">

    <input asp-for="SortBy"
           id="SortBy"
           type="hidden" />

    <input asp-for="SortDirection"
           id="SortDirection"
           type="hidden" />

    <div class="class-filter-heading">
        <div>
            <h2>
                <i class="bi bi-funnel"></i>
                Filter Classes
            </h2>

            <p>
                The class list updates automatically.
            </p>
        </div>

        @if (Model.HasFilters)
        {
            <a asp-controller="ClassSessions"
               asp-action="Index"
               class="clear-filter-link">

                <i class="bi bi-x-circle"></i>
                Clear Filters
            </a>
        }
    </div>

    <div class="class-filter-grid">

        <div>
            <label asp-for="EducationStage"
                   class="form-label">
                Education Stage
            </label>

            <select asp-for="EducationStage"
                    id="FilterEducationStage"
                    class="form-select auto-filter">

                <option value="">All Stages</option>
                <option value="Primary">Primary</option>
                <option value="Secondary">Secondary</option>
            </select>
        </div>

        <div>
            <label asp-for="AcademicLevel"
                   class="form-label">
                Academic Level
            </label>

            <select asp-for="AcademicLevel"
                    asp-items="Model.AcademicLevels"
                    id="FilterAcademicLevel"
                    class="form-select auto-filter">

                <option value="">All Levels</option>
            </select>
        </div>

        <div>
            <label asp-for="SubjectName"
                   class="form-label">
                Subject
            </label>

            <select asp-for="SubjectName"
                    asp-items="Model.Subjects"
                    id="FilterSubjectName"
                    class="form-select auto-filter">

                <option value="">All Subjects</option>
            </select>
        </div>

        <div>
            <label asp-for="FeeType"
                   class="form-label">
                Monthly Fee
            </label>

            <select asp-for="FeeType"
                    class="form-select auto-filter">

                <option value="">All Fees</option>
                <option value="free">Free</option>
                <option value="paid">Paid</option>
            </select>
        </div>

        <div>
            <label asp-for="TutorUserId"
                   class="form-label">
                Tutor
            </label>

            <select asp-for="TutorUserId"
                    asp-items="Model.Tutors"
                    class="form-select auto-filter">

                <option value="">All Tutors</option>
            </select>
        </div>

        <div>
            <label asp-for="DayOfWeek"
                   class="form-label">
                Class Day
            </label>

            <select asp-for="DayOfWeek"
                    class="form-select auto-filter">

                <option value="">All Days</option>

                @foreach (var day in orderedDays)
                {
                    <option value="@day">
                        @day
                    </option>
                }
            </select>
        </div>

        <div>
            <label asp-for="Status"
                   class="form-label">
                Status
            </label>

            <select asp-for="Status"
                    class="form-select auto-filter">

                <option value="">All Statuses</option>

                @foreach (
                                ClassSessionStatus status
                                in Enum.GetValues<ClassSessionStatus>())
                {
                    <option value="@status">
                        @status
                    </option>
                }
            </select>
        </div>

    </div>
</form>

<div class="dashboard-card compact-class-card">

    <div class="dashboard-card-header">
        <h2>
            <i class="bi bi-calendar3 me-2"></i>
            All Class Sessions
        </h2>

        <span class="text-muted">
            @Model.Sessions.Count session(s)
        </span>
    </div>

    @if (!Model.Sessions.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>

            <p>
                No class sessions match the selected filters.
            </p>

            <a asp-controller="ClassSessions"
               asp-action="Index"
               class="outline-button">

                Clear Filters
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle compact-class-table">

                <colgroup>
                    <col class="column-number" />
                    <col class="column-class-name" />
                    <col class="column-year" />
                    <col class="column-subject" />
                    <col class="column-tutor" />
                    <col class="column-schedule" />
                    <col class="column-enrollment" />
                    <col class="column-fee" />
                    <col class="column-status" />
                    <col class="column-actions" />
                </colgroup>

                <thead>
                    <tr>
                        <th class="number-column">
                            No.
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-button"
                                    data-sort="className">

                                Class Name

                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-button"
                                    data-sort="year">
                                Year
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-button"
                                    data-sort="subject">

                                Subject &amp; Level

                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-button"
                                    data-sort="tutor">

                                Tutor

                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-button"
                                    data-sort="schedule">

                                Schedule
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th class="enrollment-heading">
                            Enrollment
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-button"
                                    data-sort="monthlyFee">

                                Fee
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-button"
                                    data-sort="status">

                                Status

                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </th>

                        <th class="actions-heading">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int rowNumber = 0;
                    }

                    @foreach (var session in Model.Sessions)
                    {
                        rowNumber++;

                        <tr>
                            <td class="number-column">
                                @rowNumber
                            </td>

                            <td class="class-name-column">
                                @{
                                    var fullName = session.ClassName ?? "Unnamed Class";
                                    var scheduleSuffix = $" - {session.DayOfWeek} - {session.StartTime.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)}";
                                    var title = fullName.EndsWith(scheduleSuffix, StringComparison.OrdinalIgnoreCase)
                                        ? fullName[..^scheduleSuffix.Length] : fullName;
                                }
                                <strong class="class-name-full">
                                    <span>@title</span>
                                    <span>@scheduleSuffix[3..]</span>
                                </strong>
                            </td>

                            <td>
                                @ClassScheduleService.FirstDate(session).Year
                            </td>

                            <td>
                                <strong>
                                    @session.Subject.SubjectName
                                </strong>

                                <div class="class-secondary-text">
                                    @session.Subject.EducationStage
                                    ·
                                    @session.Subject.AcademicLevel
                                </div>
                            </td>

                            <td class="tutor-column">
                                @(session.TutorUser.FullName
                                                        ?? session.TutorUser.Email
                                                        ?? "Tutor")
                            </td>

                            <td>
                                <strong>
                                    @session.DayOfWeek
                                </strong>

                                <div class="class-secondary-text">
                                    @session.StartTime.ToString("hh:mm tt")
                                    –
                                    @session.EndTime.ToString("hh:mm tt")
                                </div>
                            </td>

                            @{
                                int enrolledCount =
                                Model.EnrollmentCounts.TryGetValue(
                                session.ClassSessionId,
                                out int currentCount)
                                ? currentCount
                                : 0;
                            }

                            <td class="enrollment-column">
                                <strong class="enrollment-count">
                                    @enrolledCount / @session.Capacity
                                </strong>

                                @if (enrolledCount >= session.Capacity)
                                {
                                    <small class="capacity-label">
                                        Full
                                    </small>
                                }
                            </td>

                            <td>
                                @if (session.Subject.MonthlyFee == 0)
                                {
                                    <span class="status-pill status-success">
                                        Free
                                    </span>
                                }
                                else
                                {
                                    <strong class="fee-text">
                                        RM @session.Subject.MonthlyFee.ToString("F2")
                                    </strong>
                                }
                            </td>

                            <td>
                                @if (
                                                        session.Status ==
                                                        ClassSessionStatus.Active)
                                {
                                    <span class="status-pill status-success">
                                        Active
                                    </span>
                                }
                                else if (
                                session.Status ==
                                ClassSessionStatus.Cancelled)
                                {
                                    <span class="status-pill status-danger">
                                        Cancelled
                                    </span>
                                }
                                else if (session.Status == ClassSessionStatus.Closed)
        {
            <span class="status-pill status-danger">Closed</span>
        }
        else
                                {
                                    <span class="status-pill status-warning">
                                        Completed
                                    </span>
                                }
                            </td>

                            <td class="action-column">
                                <div class="class-action-group">

                                    <a asp-controller="ClassSessions"
                                       asp-action="Details"
                                       asp-route-id="@session.ClassSessionId"
                                       class="btn btn-sm btn-outline-secondary class-details-button">

                                        <i class="bi bi-eye"></i>
                                        Details
                                    </a>

                                    @if (session.Status != ClassSessionStatus.Closed)
                                    {
                                    <div class="dropdown class-action-dropdown">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary class-more-button"
                                                data-bs-toggle="dropdown"
                                                data-bs-boundary="viewport"
                                                aria-expanded="false"
                                                aria-label="More actions">

                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end class-action-menu">

                                            @if (session.Status != ClassSessionStatus.Closed)
                                            {
                                            <li>
                                                <a asp-controller="ClassSessions"
                                                   asp-action="Edit"
                                                   asp-route-id="@session.ClassSessionId"
                                                   class="dropdown-item">

                                                    <i class="bi bi-pencil-square"></i>
                                                    Edit Class
                                                </a>
                                            </li>

                                            }

                                            @if (
                                                                                session.Status ==
                                                                                ClassSessionStatus.Active)
                                            {
                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>

                                                <li>
                                                    <form asp-controller="ClassSessions"
                                                          asp-action="Complete"
                                                          asp-route-id="@session.ClassSessionId"
                                                          method="post"
                                                          class="dropdown-action-form">

                                                        <button type="submit"
                                                                class="dropdown-item action-complete"
                                                                data-confirm="Complete this class after its term and all replacements have ended?">

                                                            <i class="bi bi-check2-circle"></i>
                                                            Mark as Completed
                                                        </button>
                                                    </form>
                                                </li>

                                                <li>
                                                    <a asp-controller="ClassSchedules" asp-action="Index" asp-route-classSessionId="@session.ClassSessionId" class="dropdown-item action-cancel"><i class="bi bi-calendar-x"></i> Cancel a dated lesson</a>
                                                </li>
                                                <li><a asp-action="Close" asp-route-id="@session.ClassSessionId" class="dropdown-item action-cancel"><i class="bi bi-archive"></i> Close Class</a></li>
                                            }
                                            else if (session.Status != ClassSessionStatus.Closed)
                                            {
                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>

                                                <li>
                                                    <form asp-controller="ClassSessions"
                                                          asp-action="Activate"
                                                          asp-route-id="@session.ClassSessionId"
                                                          method="post"
                                                          class="dropdown-action-form">

                                                        <button type="submit"
                                                                class="dropdown-item action-activate"
                                                                data-confirm="Activate this class session?">

                                                            <i class="bi bi-check-circle"></i>
                                                            Activate Class
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                        </ul>
                                    </div>

                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script nonce="@Context.Items["CspNonce"]">
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const filterForm =
                    document.getElementById(
                        "classFilterForm"
                    );

                const sortByInput =
                    document.getElementById(
                        "SortBy"
                    );

                const sortDirectionInput =
                    document.getElementById(
                        "SortDirection"
                    );

                const educationStageFilter =
                    document.getElementById(
                        "FilterEducationStage"
                    );

                const academicLevelFilter =
                    document.getElementById(
                        "FilterAcademicLevel"
                    );

                const subjectFilter =
                    document.getElementById(
                        "FilterSubjectName"
                    );


                /*
                 * =========================================
                 * Automatic filtering
                 * =========================================
                 */

                document
                    .querySelectorAll(".auto-filter")
                    .forEach(function (filter) {

                        filter.addEventListener(
                            "change",
                            function () {

                                /*
                                 * Changing Education Stage
                                 * resets both Academic Level
                                 * and Subject.
                                 */
                                if (
                                    filter ===
                                    educationStageFilter
                                ) {
                                    if (academicLevelFilter) {
                                        academicLevelFilter.value = "";
                                    }

                                    if (subjectFilter) {
                                        subjectFilter.value = "";
                                    }
                                }

                                /*
                                 * Changing Academic Level
                                 * resets Subject because the
                                 * available subjects may change.
                                 */
                                if (
                                    filter ===
                                    academicLevelFilter &&
                                    subjectFilter
                                ) {
                                    subjectFilter.value = "";
                                }

                                if (filterForm) {
                                    // Shared live-filters.js submits after dependent selections reset.
                                }
                            }
                        );
                    });


                /*
                 * =========================================
                 * Column sorting
                 * =========================================
                 */

                document
                    .querySelectorAll(".sort-button")
                    .forEach(function (button) {

                        const column =
                            button.dataset.sort;

                        if (
                            sortByInput &&
                            sortDirectionInput &&
                            sortByInput.value === column
                        ) {
                            const icon =
                                button.querySelector("i");

                            if (icon) {
                                icon.className =
                                    sortDirectionInput.value === "asc"
                                        ? "bi bi-sort-up"
                                        : "bi bi-sort-down";
                            }

                            button.classList.add(
                                "active-sort"
                            );
                        }

                        button.addEventListener(
                            "click",
                            function () {

                                if (
                                    !filterForm ||
                                    !sortByInput ||
                                    !sortDirectionInput
                                ) {
                                    return;
                                }

                                const sameColumn =
                                    sortByInput.value === column;

                                const currentlyAscending =
                                    sortDirectionInput.value === "asc";

                                if (
                                    sameColumn &&
                                    currentlyAscending
                                ) {
                                    sortDirectionInput.value = "desc";
                                }
                                else
                                {
                                    sortDirectionInput.value = "asc";
                                }

                                sortByInput.value = column;

                                filterForm.requestSubmit();
                            }
                        );
                    });


                /*
                 * =========================================
                 * Automatic alert dismissal
                 * =========================================
                 */

                const alerts =
                    document.querySelectorAll(
                        ".alert.alert-dismissible"
                    );

                alerts.forEach(function (alertElement) {

                    const isError =
                        alertElement.classList.contains(
                            "alert-danger"
                        );

                    const displayDuration =
                        isError ? 6000 : 3000;

                    const dismissTimer =
                        window.setTimeout(
                            function () {

                                if (
                                    !document.body.contains(
                                        alertElement
                                    )
                                ) {
                                    return;
                                }

                                if (
                                    typeof bootstrap ===
                                        "undefined" ||
                                    !bootstrap.Alert
                                ) {
                                    alertElement.remove();
                                    return;
                                }

                                const alertInstance =
                                    bootstrap.Alert
                                        .getOrCreateInstance(
                                            alertElement
                                        );

                                alertInstance.close();
                            },
                            displayDuration
                        );

                    alertElement.addEventListener(
                        "closed.bs.alert",
                        function () {
                            window.clearTimeout(
                                dismissTimer
                            );
                        }
                    );
                });
            }
        );
    </script>
}