<script nonce="@Context.Items["CspNonce"]">
    document.addEventListener("DOMContentLoaded", function () {

        const educationStageSelect =
            document.getElementById("EducationStage");

        const academicLevelSelect =
            document.getElementById("AcademicLevel");

        const subjectNameSelect =
            document.getElementById("SubjectName");

        const tutorSelect =
            document.getElementById("TutorUserId");

        const daySelect =
            document.getElementById("DayOfWeek");

        const startTimeInput =
            document.getElementById("StartTime");

        const classNameInput =
            document.getElementById("ClassName");

        const useSuggestedButton =
            document.getElementById("UseSuggestedName");

        const initialAcademicLevel =
            document.getElementById("InitialAcademicLevel")?.value || "";

        const initialSubjectName =
            document.getElementById("InitialSubjectName")?.value || "";

        const academicLevels = {
            Primary: [
                "YEAR 1",
                "YEAR 2",
                "YEAR 3",
                "YEAR 4",
                "YEAR 5",
                "YEAR 6"
            ],

            Secondary: [
                "FORM 1",
                "FORM 2",
                "FORM 3",
                "FORM 4",
                "FORM 5"
            ]
        };

        const subjectsByLevel = {
            "YEAR 1": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI"
            ],

            "YEAR 2": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI"
            ],

            "YEAR 3": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI"
            ],

            "YEAR 4": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI",
                "SEJ"
            ],

            "YEAR 5": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI",
                "SEJ"
            ],

            "YEAR 6": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI",
                "SEJ"
            ],

            "FORM 1": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI",
                "SEJ",
                "GEO",
                "RBT",
                "ASK"
            ],

            "FORM 2": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI",
                "SEJ",
                "GEO",
                "RBT",
                "ASK"
            ],

            "FORM 3": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "SCI",
                "SEJ",
                "GEO",
                "RBT",
                "ASK"
            ],

            "FORM 4": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "AM",
                "BIO",
                "CHE",
                "PHY",
                "SEJ",
                "ACC",
                "EKO",
                "PER"
            ],

            "FORM 5": [
                "BC",
                "BMP",
                "BMK",
                "BIP",
                "BIK",
                "MM",
                "AM",
                "BIO",
                "CHE",
                "PHY",
                "SEJ",
                "ACC",
                "EKO",
                "PER"
            ]
        };

        let classNameManuallyEdited =
            classNameInput &&
            classNameInput.value.trim() !== "";

        function resetSelect(selectElement, placeholder) {
            if (!selectElement) {
                return;
            }

            selectElement.innerHTML = "";

            const defaultOption =
                document.createElement("option");

            defaultOption.value = "";
            defaultOption.textContent = placeholder;

            selectElement.appendChild(defaultOption);
        }

        function addOptions(
            selectElement,
            values,
            selectedValue
        ) {
            values.forEach(function (value) {
                const option =
                    document.createElement("option");

                option.value = value;
                option.textContent = value;
                option.selected =
                    value === selectedValue;

                selectElement.appendChild(option);
            });
        }

        function populateAcademicLevels(selectedValue = "") {
            resetSelect(
                academicLevelSelect,
                "-- Select Academic Level --"
            );

            resetSelect(
                subjectNameSelect,
                "-- Select Subject --"
            );

            const selectedStage =
                educationStageSelect?.value || "";

            const levels =
                academicLevels[selectedStage] || [];

            addOptions(
                academicLevelSelect,
                levels,
                selectedValue
            );
        }

        function populateSubjects(selectedValue = "") {
            resetSelect(
                subjectNameSelect,
                "-- Select Subject --"
            );

            const selectedLevel =
                academicLevelSelect?.value || "";

            const subjects =
                subjectsByLevel[selectedLevel] || [];

            addOptions(
                subjectNameSelect,
                subjects,
                selectedValue
            );
        }

        function formatTime(timeValue) {
            if (!timeValue) {
                return "";
            }

            const parts = timeValue.split(":");

            if (parts.length < 2) {
                return "";
            }

            let hour = parseInt(parts[0], 10);
            const minute = parts[1];

            if (Number.isNaN(hour)) {
                return "";
            }

            const period =
                hour >= 12 ? "PM" : "AM";

            hour = hour % 12;

            if (hour === 0) {
                hour = 12;
            }

            return (
                hour.toString().padStart(2, "0") +
                ":" +
                minute +
                " " +
                period
            );
        }

        function getSelectedTutorName() {
            if (!tutorSelect || !tutorSelect.value) {
                return "";
            }

            const selectedOption =
                tutorSelect.options[
                    tutorSelect.selectedIndex
                ];

            return selectedOption
                ? selectedOption.text.trim()
                : "";
        }

        function buildSuggestedClassName() {
            const academicLevel =
                academicLevelSelect?.value || "";

            const subjectName =
                subjectNameSelect?.value || "";

            const tutorName =
                getSelectedTutorName();

            const classDay =
                daySelect?.value || "";

            const startTime =
                formatTime(startTimeInput?.value || "");

            if (
                !academicLevel ||
                !subjectName ||
                !tutorName ||
                !classDay ||
                !startTime
            ) {
                return "";
            }

            return (
                academicLevel +
                " - " +
                subjectName +
                " - " +
                tutorName +
                " - " +
                classDay +
                " - " +
                startTime
            );
        }

        function updateSuggestedClassName(forceUpdate = false) {
            if (!classNameInput) {
                return;
            }

            const suggestedName =
                buildSuggestedClassName();

            if (!suggestedName) {
                if (!classNameManuallyEdited) {
                    classNameInput.value = "";
                }

                return;
            }

            if (
                forceUpdate ||
                !classNameManuallyEdited
            ) {
                classNameInput.value =
                    suggestedName;

                classNameManuallyEdited = false;
            }
        }

        educationStageSelect?.addEventListener(
            "change",
            function () {
                populateAcademicLevels();
                populateSubjects();

                classNameManuallyEdited = false;
                updateSuggestedClassName();
            }
        );

        academicLevelSelect?.addEventListener(
            "change",
            function () {
                populateSubjects();

                classNameManuallyEdited = false;
                updateSuggestedClassName();
            }
        );

        subjectNameSelect?.addEventListener(
            "change",
            function () {
                updateSuggestedClassName();
            }
        );

        tutorSelect?.addEventListener(
            "change",
            function () {
                updateSuggestedClassName();
            }
        );

        daySelect?.addEventListener(
            "change",
            function () {
                updateSuggestedClassName();
            }
        );

        startTimeInput?.addEventListener(
            "change",
            function () {
                updateSuggestedClassName();
            }
        );

        startTimeInput?.addEventListener(
            "input",
            function () {
                updateSuggestedClassName();
            }
        );

        classNameInput?.addEventListener(
            "input",
            function () {
                classNameManuallyEdited =
                    classNameInput.value.trim() !== "";
            }
        );

        useSuggestedButton?.addEventListener(
            "click",
            function () {
                classNameManuallyEdited = false;
                updateSuggestedClassName(true);
            }
        );

        /*
         * Restore selected values when:
         * 1. Editing an existing class.
         * 2. Validation fails and the form reloads.
         */
        if (educationStageSelect?.value) {
            populateAcademicLevels(
                initialAcademicLevel
            );

            populateSubjects(
                initialSubjectName
            );
        }

        updateSuggestedClassName();
    });
</script>
<script src="~/js/tutor-class-availability.js" asp-append-version="true"></script>