@model SecureSmartTuitionSystem.ViewModels.Enrollment.ClassSessionFormViewModel

@{
    ViewData["Title"] = "Create Class Session";
    ViewData["GuidedTutorAssignment"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/class-sessions.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-scheduling.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Create Class Session</h1>

        <p>
            Create a new online tuition class.
            Enter the class information below.
        </p>
    </div>

    <a asp-controller="ClassSessions"
       asp-action="Index"
       class="outline-button">

        <i class="bi bi-arrow-left"></i>
        Back
    </a>
</div>

<div class="class-form-card">

    <form asp-controller="ClassSessions"
          asp-action="Create"
          method="post" id="class-create-form" data-scheduling-url="@Url.Action("TutorSchedulingOptions", "ClassSessions")">

        <partial name="_ClassSessionForm"
                 model="Model" />

        <div class="class-form-actions">
            <a asp-controller="ClassSessions"
               asp-action="Index"
               class="outline-button">
                Cancel
            </a>

            <button type="submit"
                    class="primary-button" id="class-create-submit" disabled>

                <i class="bi bi-check-lg"></i>
                Create Class Session
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ClassSessionScripts" />
    <script src="~/js/tutor-scheduling.js" asp-append-version="true"></script>
}