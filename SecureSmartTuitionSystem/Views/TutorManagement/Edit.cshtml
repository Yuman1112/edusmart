@model SecureSmartTuitionSystem.ViewModels.Tutor.EditTutorViewModel

@{
    ViewData["Title"] = "Edit Tutor";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/class-sessions.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/tutor-form.css"
          asp-append-version="true" />
}

<!-- =====================================================
     1. PAGE HEADER
===================================================== -->

<div class="page-header">

    <div>
        <h1>Edit Tutor</h1>

        <p>
            Update tutor information, teaching subjects,
            and academic levels.
        </p>
    </div>

    <a asp-controller="TutorManagement"
       asp-action="Details"
       asp-route-userId="@Model.UserId"
       class="outline-button">

        <i class="bi bi-arrow-left"
           aria-hidden="true"></i>

        Back
    </a>

</div>

@if (TempData["TutorSuccess"] is string successMessage)
{
    <div id="tutor-save-success-message"
         class="alert alert-success"
         role="status">
        @successMessage
    </div>
}

@if (TempData["TutorWarning"] is string warningMessage)
{
    <div class="alert alert-warning" role="alert">
        @warningMessage
    </div>
}

@if (TempData["TutorInfo"] is string infoMessage)
{
    <div class="alert alert-info" role="status">
        @infoMessage
    </div>
}

<!-- =====================================================
     2. MAIN FORM CARD
===================================================== -->

<div class="class-form-card tutor-create-card">

    <form id="edit-tutor-form"
          asp-controller="TutorManagement"
          asp-action="Edit"
          method="post"
          data-email-status-url="@Url.Action("EmailChangeStatus", "TutorManagement", new { userId = Model.UserId })"
          data-current-email="@Model.CurrentEmail"
          novalidate>

        @Html.AntiForgeryToken()

        <input asp-for="UserId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"
             role="alert"></div>

        <!-- =================================================
             3. PERSONAL INFORMATION
        ================================================= -->

        <section class="class-form-section">

            <h2>
                <i class="bi bi-person-vcard"
                   aria-hidden="true"></i>

                Personal Information
            </h2>

            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <label asp-for="EmploymentType" class="form-label">Employment Type</label>
                    <select asp-for="EmploymentType" class="form-select">
                        <option value="0">Part-time</option>
                        <option value="1">Full-time</option>
                    </select>
                    <span asp-validation-for="EmploymentType" class="text-danger"></span>
                    <div class="form-text">Full-time: Mon–Sat, 08:00–22:00; lunch 12:00–13:00 and dinner 18:00–19:00 excluded. Part-time: tutor selects slots within Mon–Sat, 08:00–22:00. Switching to Part-time keeps current slots until the tutor edits them.</div>
                </div>


                <!-- Tutor ID - Read Only -->
                <div class="col-12 col-md-6">

                    <div class="d-flex justify-content-between align-items-center">

                        <label asp-for="TutorId" class="form-label">
                            Tutor ID
                        </label>

                        <span class="tutor-readonly-label">
                            <i class="bi bi-lock-fill" aria-hidden="true"></i>
                            Read-only
                        </span>

                    </div>

                    <input asp-for="TutorId"
                           class="form-control tutor-readonly-field"
                           readonly
                           aria-readonly="true" />

                    <small class="tutor-field-hint">
                        System-generated ID. Cannot be changed.
                    </small>

                </div>

                <!-- Email -->
                <!-- Email -->
                <div class="col-12 col-md-6">

                    <label asp-for="Email"
                           class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           maxlength="254"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>

                    <small class="tutor-field-hint">
                        A new email address must be verified
                        before it replaces the current account email.
                    </small>

                </div>

                <!-- Full Name -->
                <div class="col-12 col-md-6">

                    <label asp-for="FullName"
                           class="form-label">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           class="form-control"
                           maxlength="100"
                           autocomplete="name"
                           placeholder="Full name as per IC" />

                    <span asp-validation-for="FullName"
                          class="text-danger"></span>

                </div>

                <!-- Phone Number -->
                <div class="col-12 col-md-6">

                    <label asp-for="PhoneNumber"
                           class="form-label">
                        Phone Number
                    </label>

                    <input asp-for="PhoneNumber"
                           id="tutorPhone"
                           type="tel"
                           class="form-control"
                           maxlength="12"
                           autocomplete="tel"
                           placeholder="012-3456789" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="tutor-info-note mt-4">

                <i class="bi bi-info-circle"
                   aria-hidden="true"></i>

                <span>
                    Tutor ID cannot be changed.
                    Account status is managed separately.
                </span>

            </div>

        </section>

        <!-- =================================================
             4. PROFESSIONAL INFORMATION
        ================================================= -->

        <section class="class-form-section">

            <h2>
                <i class="bi bi-mortarboard"
                   aria-hidden="true"></i>

                Professional Information
            </h2>

            <div class="row g-4">

                <!-- Qualification -->
                <div class="col-12 col-md-6">

                    <label asp-for="Qualification"
                           class="form-label">
                        Qualification
                    </label>

                    <input asp-for="Qualification"
                           class="form-control"
                           maxlength="200"
                           placeholder="e.g. Bachelor of Education" />

                    <span asp-validation-for="Qualification"
                          class="text-danger"></span>

                </div>

                <!-- Area of Expertise -->
                <div class="col-12 col-md-6">

                    <label asp-for="AreaOfExpertise"
                           class="form-label">
                        Area of Expertise
                    </label>

                    <input asp-for="AreaOfExpertise"
                           class="form-control"
                           maxlength="200"
                           placeholder="e.g. Mathematics, SPM preparation" />

                    <span asp-validation-for="AreaOfExpertise"
                          class="text-danger"></span>

                </div>

                <!-- Teaching Experience -->
                <div class="col-12">

                    <label asp-for="TeachingExperience"
                           class="form-label">
                        Teaching Experience
                    </label>

                    <textarea asp-for="TeachingExperience"
                              class="form-control"
                              maxlength="500"
                              rows="3"
                              placeholder="e.g. 3 years teaching Mathematics"></textarea>

                    <span asp-validation-for="TeachingExperience"
                          class="text-danger"></span>

                </div>

            </div>

        </section>

        <!-- =================================================
             5. TEACHING SUBJECTS & LEVELS
        ================================================= -->

        <section class="class-form-section">

            <h2 class="tutor-teaching-heading">

                <i class="bi bi-book-half"
                   aria-hidden="true"></i>

                Teaching Subjects &amp; Levels

            </h2>

            <p class="tutor-section-description">
                Select the academic levels this tutor can teach.
                Click Select Subjects or Edit Subjects to manage
                the subjects for each level. At least one subject
                is required for every selected level.
                Both Primary and Secondary levels can be selected.
            </p>

            <!-- =============================================
                 PRIMARY / SECONDARY TABS
            ============================================= -->

            <ul class="nav nav-tabs tutor-stage-tabs"
                id="teaching-stage-tabs"
                role="tablist">

                <!-- Primary -->
                <li class="nav-item"
                    role="presentation">

                    <button type="button"
                            class="nav-link active"
                            id="primary-tab"
                            role="tab"
                            aria-selected="true"
                            aria-controls="teaching-stage-content"
                            data-stage="Primary">

                        <i class="bi bi-book"
                           aria-hidden="true"></i>

                        Primary

                    </button>

                </li>

                <!-- Secondary -->
                <li class="nav-item"
                    role="presentation">

                    <button type="button"
                            class="nav-link"
                            id="secondary-tab"
                            role="tab"
                            aria-selected="false"
                            aria-controls="teaching-stage-content"
                            data-stage="Secondary">

                        <i class="bi bi-mortarboard"
                           aria-hidden="true"></i>

                        Secondary

                    </button>

                </li>

            </ul>

            <!-- =============================================
                 ACADEMIC LEVELS AND SUBJECTS
            ============================================= -->

            <div id="teaching-stage-content"
                 role="tabpanel"
                 aria-labelledby="primary-tab">

                <div class="tutor-teaching-panel">

                    <h3 class="tutor-panel-title">
                        Academic Levels
                    </h3>

                    <!-- Generated by tutor-edit.js -->
                    <div id="teaching-levels-container"
                         class="row g-3">
                    </div>

                    <!-- Subject Checkboxes -->
                    <div id="teaching-subjects-container"
                         class="tutor-subjects-panel">
                    </div>

                </div>

            </div>

            <!-- =============================================
                 SELECTED LEVELS SUMMARY
            ============================================= -->

            <div class="tutor-selection-panel">

                <div class="tutor-selection-header">

                    <h3 class="tutor-panel-title mb-0">

                        <i class="bi bi-check2-square"
                           aria-hidden="true"></i>

                        Selected Teaching Levels

                    </h3>

                    <span id="teaching-level-count"
                          class="tutor-level-count">
                        0 levels
                    </span>

                </div>

                <div id="teaching-selection-summary"
                     class="d-flex flex-wrap gap-2">
                </div>

            </div>

            <!-- =============================================
                 HIDDEN INPUTS FOR ASP.NET MODEL BINDING
            ============================================= -->

            <div id="teaching-levels-hidden"></div>

            <span asp-validation-for="TeachingLevels"
                  id="teaching-levels-error"
                  class="text-danger d-block mt-2"
                  role="alert">
            </span>

            <!-- =============================================
                 EXISTING TUTOR TEACHING SELECTIONS
            ============================================= -->

            <script id="initial-teaching-levels"
                    type="application/json">
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                                    Model.TeachingLevels,
                                    new System.Text.Json.JsonSerializerOptions
                                    {
                                                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default
                                    }))
            </script>

        </section>

        <!-- =================================================
             6. FORM ACTIONS
        ================================================= -->

        <div class="class-form-actions">

            <!-- Cancel -->
            <a asp-controller="TutorManagement"
               asp-action="Details"
               asp-route-userId="@Model.UserId"
               class="outline-button">

                Cancel

            </a>

            <!-- Save All Changes -->
            <button type="submit"
                    id="saveTutorChanges"
                    class="primary-button"
                    disabled>
                <i class="bi bi-check-lg"></i>
                Save Changes
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/tutor-edit.js"
            asp-append-version="true"></script>

}
