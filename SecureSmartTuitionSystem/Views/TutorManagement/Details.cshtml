@model SecureSmartTuitionSystem.ViewModels.Tutor.TutorDetailsViewModel

@{
    ViewData["Title"] = "Tutor Details";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/class-sessions.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/tutor-management.css"
          asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Tutor Details</h1>
        <p>View the complete tutor information.</p>
    </div>

    <div class="class-detail-header-actions">
        <a asp-controller="TutorManagement"
           asp-action="ChangeStatus"
           asp-route-userId="@Model.UserId"
           asp-route-activate="@(!Model.IsActive)"
           class="outline-button">

            <i class="bi @(Model.IsActive ? "bi-person-dash" : "bi-person-check")"
               aria-hidden="true"></i>

            @(Model.IsActive ? "Deactivate" : "Reactivate")
        </a>

        <a asp-controller="AdminTutorAvailability"
           asp-action="Index"
           asp-route-userId="@Model.UserId"
           class="outline-button">

            <i class="bi bi-calendar-week"
               aria-hidden="true"></i>
            Availability
        </a>

        <a asp-controller="TutorManagement"
           asp-action="Edit"
           asp-route-userId="@Model.UserId"
           class="primary-button">

            <i class="bi bi-pencil-square"
               aria-hidden="true"></i>
            Edit
        </a>

        <a asp-controller="TutorManagement"
           asp-action="Index"
           class="outline-button">

            <i class="bi bi-arrow-left"
               aria-hidden="true"></i>
            Back
        </a>
    </div>
</div>

@if (TempData["TutorSuccess"] is string successMessage)
{
    <div id="tutor-details-success"
         class="alert alert-success"
         role="status">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
        @successMessage
    </div>
}

@if (TempData["TutorWarning"] is string warningMessage)
{
    <div id="tutor-details-warning"
         class="alert alert-warning"
         role="alert">
        @warningMessage
    </div>
}

@if (TempData["TutorInfo"] is string infoMessage)
{
    <div class="alert alert-info" role="status">
        <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
        @infoMessage
    </div>
}

<div id="tutor-details-email-notice"
     class="alert alert-info"
     role="status"
     aria-live="polite"
     hidden></div>

<div id="tutor-details-card"
     class="class-details-card"
     data-email-status-url="@Url.Action("EmailChangeStatus", "TutorManagement", new { userId = Model.UserId })">

    <div class="class-details-title">
        <div>
            <h2>@Model.UserName - @Model.FullName</h2>
        </div>

        @if (Model.IsActive)
        {
            <span class="status-pill status-success">Active</span>
        }
        else
        {
            <span class="status-pill status-warning">Inactive</span>
        }
    </div>

    <section class="class-details-section">
        <h3>
            <i class="bi bi-person-vcard-fill" aria-hidden="true"></i>
            Tutor Information
        </h3>

        <div class="class-details-grid">
            <div class="class-detail-item">
                <span>Tutor User ID</span>
                <strong>@Model.UserName</strong>
            </div>

            <div class="class-detail-item">
                <span>Full Name</span>
                <strong>@Model.FullName</strong>
            </div>

            <div class="class-detail-item">
                <span>Email Address</span>
                <strong id="tutor-details-email"
                        class="text-break">@Model.Email</strong>
            </div>

            <div class="class-detail-item">
                <span>Phone Number</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                        ? "Not provided"
                                        : Model.PhoneNumber)
                </strong>
            </div>

            <div class="class-detail-item">
                <span>Employment Type</span>
                <strong>@(Model.EmploymentType == SecureSmartTuitionSystem.Models.Tutor.TutorEmploymentType.FullTime ? "Full-time" : "Part-time")</strong>
            </div>
            <div class="class-detail-item">
                <span>Qualification</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Qualification)
                                        ? "Not provided"
                                        : Model.Qualification)
                </strong>
            </div>

            <div class="class-detail-item">
                <span>Area of Expertise</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.AreaOfExpertise)
                                        ? "Not provided"
                                        : Model.AreaOfExpertise)
                </strong>
            </div>

            <div class="class-detail-item class-detail-wide">
                <span>Teaching Experience</span>
                <strong class="class-remark">
                    @(string.IsNullOrWhiteSpace(Model.TeachingExperience)
                                        ? "Not provided"
                                        : Model.TeachingExperience)
                </strong>
            </div>
        </div>
    </section>

    @if (Model.PendingEmailRequestId.HasValue
        && !string.IsNullOrWhiteSpace(Model.PendingEmail))
    {
        bool expired =
        !Model.PendingEmailExpiresAtUtc.HasValue
        || Model.PendingEmailExpiresAtUtc.Value <= DateTime.UtcNow;

        <section id="tutor-details-pending-email"
                 class="class-details-section">

            <h3>
                <i class="bi bi-envelope-check" aria-hidden="true"></i>
                Pending Email Change
            </h3>

            <div class="class-details-grid">
                <div class="class-detail-item">
                    <span>Awaiting Verification</span>
                    <strong id="tutor-details-pending-address"
                            class="text-break">@Model.PendingEmail</strong>
                </div>
            </div>

            <p id="tutor-details-pending-description"
               class="text-muted mt-3">
                @(expired
                            ? "The verification link has expired. Resend it to issue a new link."
                            : "The current account email remains unchanged until the new address is verified.")
        </p>

            <div class="d-flex flex-wrap gap-2">
                <form id="tutor-details-resend-form"
                      asp-controller="TutorManagement"
                      asp-action="ResendEmailVerification"
                      method="post"
                      asp-antiforgery="true">

                    <input type="hidden"
                           name="userId"
                           value="@Model.UserId" />

                    <input type="hidden"
                           name="requestId"
                           value="@Model.PendingEmailRequestId" />

                @if (Model.IsActive)
                    {
                        <button type="submit" class="outline-button">
                            Resend Verification Email
                        </button>
                    }
                </form>

                <form id="tutor-details-cancel-form"
                      asp-controller="TutorManagement"
                      asp-action="CancelEmailChange"
                      method="post"
                      asp-antiforgery="true">

                    <input type="hidden"
                           name="userId"
                           value="@Model.UserId" />

                    <input type="hidden"
                           name="requestId"
                           value="@Model.PendingEmailRequestId" />

                    <button type="submit" class="outline-button">
                        Cancel Email Change
                    </button>
                </form>
            </div>
        </section>
    }

    <section class="class-details-section">
        <h3>
            <i class="bi bi-book-fill" aria-hidden="true"></i>
            Teaching Subjects &amp; Levels
        </h3>

        @if (Model.TeachingLevels.Any())
        {
            @foreach (var stageGroup in Model.TeachingLevels
                    .GroupBy(x => x.EducationStage))
            {
                var stageId = stageGroup.Key.ToLowerInvariant();

                <div class="tutor-teaching-stage">
                    <div class="tutor-teaching-stage-header">
                        <div class="tutor-teaching-stage-title">
                            <i class="bi bi-mortarboard-fill"
                               aria-hidden="true"></i>
                            <span>@stageGroup.Key</span>
                        </div>
                    </div>

                    <div class="accordion tutor-teaching-accordion"
                         id="tutor-accordion-@stageId">

                        @foreach (var level in stageGroup)
                        {
                            var levelId = level.AcademicLevel
                            .ToLowerInvariant()
                            .Replace(" ", "-");

                            var collapseId = $"tutor-{stageId}-{levelId}";
                            var headingId = $"heading-{collapseId}";

                            <div class="accordion-item">
                                <h4 class="accordion-header"
                                    id="@headingId">

                                    <button class="accordion-button collapsed"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="false"
                                            aria-controls="@collapseId">

                                        <span class="tutor-accordion-level">
                                            @(System.Globalization.CultureInfo
                                                                            .CurrentCulture.TextInfo
                                                                            .ToTitleCase(level.AcademicLevel
                                                                            .ToLowerInvariant()))
                                                                                             </span>

                                        <span class="tutor-accordion-count">
                                            @level.SubjectNames.Count
                                            @(level.SubjectNames.Count == 1
                                                                            ? "Subject"
                                                                            : "Subjects")
                            </span>
                        </button>
                    </h4>

                                <div id="@collapseId"
                                     class="accordion-collapse collapse"
                                     aria-labelledby="@headingId"
                                     data-bs-parent="#tutor-accordion-@stageId">

                                    <div class="accordion-body">
                                        <div class="tutor-teaching-subjects">
                                @foreach (var subject in level.SubjectNames)
                                            {
                                                <span class="tutor-teaching-subject-badge">
                                                    @subject
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted mb-0">
                No teaching subjects assigned.
            </p>
        }
    </section>

    <section class="class-details-section">
        <h3>
            <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
            Account Information
        </h3>

        <div class="class-details-grid">
            <div class="class-detail-item">
                <span>Account Status</span>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="tutor-management-badge tutor-badge-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="tutor-management-badge tutor-badge-inactive">
                            Inactive
                        </span>
                    }
                </div>
            </div>

            <div class="class-detail-item">
                <span>Account Setup</span>
                <div>
                    @if (Model.SetupPending)
                    {
                        <span class="tutor-management-badge tutor-badge-pending">
                            Pending
                        </span>
                    }
                    else
                    {
                        <span class="tutor-management-badge tutor-badge-success">
                            Completed
                        </span>
                    }
                </div>
            </div>

            <div class="class-detail-item">
                <span>Created At</span>
                <strong>
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                </strong>
            </div>

            <div class="class-detail-item">
                <span>Last Updated</span>
                <strong>
                    @(Model.UpdatedAt.HasValue
                                        ? Model.UpdatedAt.Value.ToLocalTime()
                                        .ToString("dd MMM yyyy, hh:mm tt")
                                        : "Not updated yet")
                </strong>
            </div>
        </div>
    </section>

    <partial name="_TutorStatusHistory" model="Model" />
</div>

@section Scripts {
    <script src="~/js/tutor-details.js"
            asp-append-version="true"></script>
}