@model SecureSmartTuitionSystem.ViewModels.Enrollment.CancelLessonModel
@{ ViewData["Title"] = "Cancel Lesson"; }
<div class="page-header"><div><h1>Cancel one lesson</h1><p>@ViewBag.ClassName · @Model.Date.ToString("dd MMM yyyy")</p></div></div>
<div class="class-form-card"><p>The weekly class stays active. This lesson will appear in Pending Replacements until a replacement date is arranged.</p>
<form asp-action="Cancel" method="post" id="cancelLessonForm"><div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="ClassSessionId" type="hidden" /><input asp-for="Date" type="hidden" />
<label asp-for="Reason" class="form-label">Cancellation reason <span class="text-danger" aria-hidden="true">*</span></label>
<textarea asp-for="Reason" class="form-control" maxlength="500" rows="3" required aria-required="true" aria-describedby="cancellationReasonHelp" placeholder="Explain why this lesson needs to be cancelled."></textarea>
<span asp-validation-for="Reason" class="text-danger"></span>
<small id="cancellationReasonHelp" class="text-muted">Required. The reason will be included in the notification to affected users.</small>
<div class="mt-3"><button class="btn btn-danger" data-confirm="Cancel only this dated lesson and notify affected users?">Confirm cancellation</button> <a class="btn btn-outline-secondary" asp-action="Index" asp-route-mode="month" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">Back</a></div>
</form></div>

@section Scripts {
    <script src="~/js/cancel-lesson.js" asp-append-version="true"></script>
}
