@{
    ViewData["Title"] = "Recording Unavailable";
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/video-playback.css" asp-append-version="true" />
}
<div class="video-page"><div class="page-header"><div><h1>Recording Unavailable</h1><p>This lesson may be inactive, or your account may no longer have access to its class.</p></div></div><div class="class-form-card"><p>Select another recording from your available lessons. If you believe you should have access, contact your tutor or administrator.</p><a asp-action="Index" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Recorded Lessons</a></div></div>
