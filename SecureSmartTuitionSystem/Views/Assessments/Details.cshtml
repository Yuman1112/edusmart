@model SecureSmartTuitionSystem.ViewModels.Learning.AssessmentDetailsModel
@using SecureSmartTuitionSystem.Services.Learning
@{
    var a = Model.Assessment; ViewData["Title"] = a.Title;
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learning-materials.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/assessments.css" asp-append-version="true" />
}
<div class="assessment-page learning-materials-page @(!Model.IsStaff ? "student-material-page" : "")">
    <div class="page-header">
        <div><h1>@a.Title</h1><p>@a.ClassCode · @a.ClassName</p></div><div class="material-actions">
            @if (Model.CanManage && a.IsActive && a.PublishedAtUtc == null)
            {
                <form asp-action="ChangeState" method="post" class="m-0" data-confirm="Publish this assessment to the current eligible student roster?">
                    <input type="hidden" name="id" value="@a.Id" />
                    <input type="hidden" name="rowVersion" value="@a.RowVersion" />
                    <button type="submit" class="primary-button" name="command" value="publish"><i class="bi bi-send" aria-hidden="true"></i> Publish Assessment</button>
                </form>
            }
            @if (Model.CanEdit)
            {
                <a asp-action="Edit" asp-route-id="@a.Id" class="outline-button"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit</a>
            }
            @if (Model.CanManage)
            {
                <form asp-action="ChangeState" method="post" data-confirm="@a.AvailabilityConfirmation"><input type="hidden" name="id" value="@a.Id" /><input type="hidden" name="rowVersion" value="@a.RowVersion" /><button name="command" value="@(a.IsActive ? "deactivate" : "reactivate")" class="outline-button"><i class="bi @(a.IsActive ? (a.PublishedAtUtc.HasValue ? "bi-eye-slash" : "bi-archive") : (a.PublishedAtUtc.HasValue ? "bi-eye" : "bi-arrow-counterclockwise"))" aria-hidden="true"></i> @a.AvailabilityActionLabel</button></form>
            }
            @if (Model.CanUnsubmit)
            {
                <form asp-action="Unsubmit"
                      method="post"
                      class="m-0" data-student-unsubmit
                      data-confirm="Withdraw your answer? It will be marked Not submitted. Your files and note will be kept so you can review and resubmit before the deadline.">

                    <input type="hidden" name="id" value="@a.Id" />

                    <input type="hidden"
                           name="rowVersion"
                           value="@Model.Participants.Single().RowVersion" />

                    <button type="submit" class="primary-button">
                        <i class="bi bi-arrow-counterclockwise"
                           aria-hidden="true"></i>
                        Unsubmit
                    </button>
                </form>
            }
            <a asp-action="Index" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</a>
        </div>
    </div>
    <partial name="_Messages" />
    @if (!Model.IsStaff)
    {
        var submitted = Model.Participants.SingleOrDefault();
        @if (submitted?.SubmittedAtUtc != null)
        {
            <section class="class-form-card mb-4 assessment-own-submission">
                <h2 class="h5">Your Submission</h2>
                <partial name="_StudentResult" model="Model" />
                <p class="assessment-note">Submitted @submitted.SubmittedAtUtc.Value.AddHours(8).ToString("dd MMM yyyy · HH:mm") MYT</p>
                @if (!string.IsNullOrWhiteSpace(submitted.SubmissionNote))
                {
                    <p class="assessment-instructions">@submitted.SubmissionNote</p>
                }
                <partial name="_Files" model="submitted.Files" />
            </section>
        }
        else
        {
            <partial name="_StudentResult" model="Model" />
        }
    }
    <div class="class-form-card mb-4">
        <div class="material-list-heading assessment-detail-heading"><h2>@a.Kind · @a.Subject</h2><span class="assessment-badge" data-assessment-detail-state>@a.State</span></div>
        <div class="assessment-summary"><div><small>Open From (MYT)</small>@a.OpensAtMyt.ToString("dd MMM yyyy · HH:mm")</div><div><small>Due (MYT)</small>@a.DueAtMyt.ToString("dd MMM yyyy · HH:mm")</div><div><small>Total Marks</small>@a.MaxMarks.ToString("0.##")</div><div><small>Tutor</small>@a.Tutor</div></div>
        @if (!a.IsActive)
        {
            <div class="alert alert-info mt-3">@(a.PublishedAtUtc.HasValue ? "Inactive. Students cannot open this assessment or submit answers." : "Archived draft. Restore it before publishing. Students cannot see this draft.")</div>
        }
        @if (!string.IsNullOrWhiteSpace(a.Instructions))
        {
            <h3 class="h6 mt-4">Instructions</h3>
            <p class="assessment-instructions">@a.Instructions</p>
        }
        @if (Model.QuestionFiles.Any())
        {
            <h3 class="h6 mt-4">Question Files (@Model.QuestionFiles.Count)</h3>
            <partial name="_Files" model="Model.QuestionFiles" />
        }

    </div>
    @if (Model.IsStaff)
    {
        <partial name="_Submissions" model="Model" />
    }
    else
    {
        var p = Model.Participants.SingleOrDefault();
        @if (p?.SubmittedAtUtc == null && Model.CanSubmit)
        {

            <div class="class-form-card">
                <h2 class="h5 mb-3">Submit Your Assignment</h2><form asp-action="Submit" method="post" enctype="multipart/form-data" data-assessment-upload-form data-assessment-requires-file="true" data-confirm="Submit this answer? You can withdraw it before the deadline only while it remains ungraded.">
                    <input asp-for="Submission.AssessmentId" type="hidden" /><input asp-for="Submission.RowVersion" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>@{
                    ViewData["AssessmentSavedFiles"] = p?.Files.Where(f => Model.Submission.KeptFileIds.Contains(f.Id)).ToList()
                    ?? new List<SecureSmartTuitionSystem.ViewModels.Learning.AssessmentFileRow>();
                }
                <input asp-for="Submission.ParticipantRowVersion" type="hidden" />
                <partial name="_Upload" model='@("Submission.Files")' /><span asp-validation-for="Submission.Files" class="assessment-field-error"></span><label asp-for="Submission.Note" class="form-label mt-3">Note (Optional)</label><textarea asp-for="Submission.Note" class="form-control" rows="3" maxlength="2000"></textarea><span asp-validation-for="Submission.Note" class="assessment-field-error"></span><div class="class-form-actions mt-3"><button class="primary-button">@(p?.Files.Count > 0 ? "Resubmit Assignment" : "Submit Assignment")</button></div>
            </form>
        </div>
    }
        else if (p?.SubmittedAtUtc == null)
    {

        <div class="alert alert-info">Submissions are closed. No confirmed answer has been recorded for you.</div>
    }
        }
    @if (!Model.IsStaff)
    {
        <p class="assessment-note mt-3" data-student-result-status role="status">Results update automatically while this page is visible.</p>
    }

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" /><script src="~/js/learning-materials-preview.js" asp-append-version="true"></script><script src="~/js/assessments.js" asp-append-version="true"></script>
}

