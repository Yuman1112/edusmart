@model SecureSmartTuitionSystem.ViewModels.Learning.AssessmentDetailsModel
@using SecureSmartTuitionSystem.Services.Learning
@{ var a = Model.Assessment; }
<div data-submissions-live data-refresh-url="@Url.Action("Details", new { id = a.Id, fragment = true })">

<div class="dashboard-card compact-class-card assessment-results"><div class="dashboard-card-header"><h2><i class="bi bi-people me-2" aria-hidden="true"></i> Student Submissions</h2>@if(a.PublishedAtUtc.HasValue){<span>@a.Submitted / @a.Participants submitted · @a.Graded graded</span>}</div>
@if(Model.Participants.Count==0){<div class="assessment-empty">@(a.PublishedAtUtc.HasValue ? "No eligible students are included in this assessment." : "Publish the assessment to create its eligible student roster.")</div>}
else{<div class="table-responsive"><table class="table compact-class-table align-middle"><thead><tr><th>No.</th><th>Student</th><th>Submitted (MYT)</th><th>Status</th><th>Marks</th><th>Files</th><th>Actions</th></tr></thead><tbody>@{int number=0;}@foreach(var p in Model.Participants){number++;<tr><td>@number</td><td><strong>@p.StudentName</strong><small>@p.StudentNumber</small></td><td>@(p.SubmittedAtUtc?.AddHours(8).ToString("dd MMM yyyy HH:mm")??"—")</td><td>@(p.Marks.HasValue?"Graded":p.SubmittedAtUtc.HasValue?"Pending review":"Not submitted")</td><td>@(p.Marks.HasValue?$"{p.Marks:0.##} / {a.MaxMarks:0.##}":"—")</td><td>@foreach(var f in p.Files){<a asp-action="Download" asp-route-id="@f.Id">@f.Name</a><br/>}</td><td>@if(Model.CanGrade&&a.IsActive&&p.SubmittedAtUtc.HasValue){<a asp-action="Grade" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary class-details-button">@(p.Marks.HasValue?"Edit Grade":"Grade")</a>}else if(p.Marks.HasValue){<span>Locked</span>}</td></tr>}</tbody></table></div>}
</div>
@if(Model.CanManage&&a.PublishedAtUtc.HasValue&&!a.ResultsPublishedAtUtc.HasValue){<div class="assessment-release"><p class="assessment-note">Release after the deadline and after every submitted answer is graded. Unsubmitted work stays Not submitted; it is not automatically graded zero. Released grades are locked.</p><form asp-action="ChangeState" method="post" data-confirm="Release and lock these grades? Students and linked parents will be able to see them."><input type="hidden" name="id" value="@a.Id"/><input type="hidden" name="rowVersion" value="@a.RowVersion"/><button class="primary-button" name="command" value="release" disabled="@(!a.IsActive||AssessmentRules.NowMyt<a.DueAtMyt||a.Submitted==0||a.Graded!=a.Submitted)">Release Results</button></form></div>}

</div>
