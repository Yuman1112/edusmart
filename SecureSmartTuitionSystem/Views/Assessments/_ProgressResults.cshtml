@model SecureSmartTuitionSystem.ViewModels.Learning.AssessmentProgressModel
@using SecureSmartTuitionSystem.Services.Learning
<div data-assessment-results>
    <div class="assessment-stats"><div><small>Average · released grades</small><strong>@(Model.Average.HasValue? Model.Average.Value.ToString("0.##") + "%":"—")</strong></div><div><small>Released Grades</small><strong>@Model.Graded</strong></div><div><small>Not Submitted</small><strong>@(Model.Total - Model.Submitted)</strong></div></div>
    <div class="dashboard-card compact-class-card assessment-results">
        <div class="dashboard-card-header"><h2><i class="bi bi-bar-chart me-2" aria-hidden="true"></i> Assessment Results</h2><span>@Model.Total record(s)</span></div>
        @if (Model.Total == 0)
        {
            <div class="assessment-empty">No assessment records match. Results are limited to your current authorised students and classes.</div>
        }
        else
        {

            <div class="table-responsive">
                <table class="table compact-class-table align-middle" data-pagination="off">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th><a class="assessment-sort-link" asp-action="Progress" asp-route-Page="1" asp-route-ClassId="@Model.Filter.ClassId" asp-route-StudentId="@Model.Filter.StudentId" asp-route-SubjectId="@Model.Filter.SubjectId" asp-route-Kind="@Model.Filter.Kind" asp-route-Month="@Model.Filter.Month" asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status" asp-route-Sort='@(Model.Filter.Sort == "title_asc" ? "title_desc" : "title_asc")' data-assessment-nav>Assessment / Class <i class="bi bi-arrow-down-up" aria-hidden="true"></i></a></th>@if(Model.IsParent||Model.IsStaff){
                            <th>Student</th>
                        }
                        <th><a class="assessment-sort-link" asp-action="Progress" asp-route-Page="1" asp-route-ClassId="@Model.Filter.ClassId" asp-route-StudentId="@Model.Filter.StudentId" asp-route-SubjectId="@Model.Filter.SubjectId" asp-route-Kind="@Model.Filter.Kind" asp-route-Month="@Model.Filter.Month" asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status" asp-route-Sort='@(Model.Filter.Sort == "due_asc" ? "due_desc" : "due_asc")' data-assessment-nav>Due (MYT) <i class="bi bi-arrow-down-up" aria-hidden="true"></i></a></th>
                        <th>Status</th>
                        <th>Result</th>
                        <th>Feedback</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int number = (Model.Filter.Page - 1) * 25;
                    }
                    @foreach (var row in Model.Rows)
                    {
                        number++;
                        <tr>
                            <td>@number</td>
                            <td>@row.Title<small>@row.ClassCode · @row.Subject</small></td>@if(Model.IsParent||Model.IsStaff){
                            <td>@row.StudentName<small>@row.StudentNumber</small></td>
                        }
                        <td>@row.DueAtMyt.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@(row.Marks.HasValue ? "Graded" : row.SubmittedAtUtc.HasValue ? "Awaiting results" : AssessmentRules.NowMyt >= row.DueAtMyt ? "Not submitted" : "Pending submission")<small>@(row.SubmittedAtUtc.HasValue ? "Submitted " + row.SubmittedAtUtc.Value.AddHours(8).ToString("dd MMM yyyy HH:mm") : "")</small></td>
                        <td>
                            @if (row.Marks.HasValue && !string.IsNullOrWhiteSpace(row.Feedback))
                            {
                                <strong>@row.Marks.Value.ToString("0.##") / @row.MaxMarks.ToString("0.##")</strong>
                                <small>@row.Percentage?.ToString("0.##")% · @AssessmentRules.Grade(row.Percentage!.Value)</small>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            @if (row.Marks.HasValue && !string.IsNullOrWhiteSpace(row.Feedback))
                            {
                                <details><summary>View feedback</summary><p class="assessment-instructions">@row.Feedback</p><small>Graded @row.GradedAtUtc?.AddHours(8).ToString("dd MMM yyyy")</small></details>
                            }
                            else
                            {

                                <span>—</span>
                            }
                        </td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>
        <nav class="assessment-pagination" aria-label="Result pages">
            <span>@((Model.Filter.Page - 1) * 25 + 1)–@Math.Min(Model.Filter.Page * 25, Model.Total) of @Model.Total · 25 per page</span><div class="material-actions">
                @foreach (var link in new[] { (Text: "First", Page: 1, Off: Model.Filter.Page == 1), (Text: "Previous", Page: Model.Filter.Page - 1, Off: Model.Filter.Page == 1), (Text: Model.Filter.Page.ToString(), Page: Model.Filter.Page, Off: true), (Text: "Next", Page: Model.Filter.Page + 1, Off: Model.Filter.Page == Model.PageCount), (Text: "Last", Page: Model.PageCount, Off: Model.Filter.Page == Model.PageCount) })
                {
                    if (link.Off)
                    {
                        <span class="assessment-page-number" aria-disabled="true">@link.Text</span>
                    }
                    else
                    {

                        <a class="assessment-page-number" asp-action="Progress" asp-route-Page="@link.Page" asp-route-StudentId="@Model.Filter.StudentId" asp-route-ClassId="@Model.Filter.ClassId" asp-route-Search="@Model.Filter.Search" asp-route-Sort="@Model.Filter.Sort" asp-route-SubjectId="@Model.Filter.SubjectId" asp-route-Kind="@Model.Filter.Kind" asp-route-Month="@Model.Filter.Month" data-assessment-nav>@link.Text</a>
                    }
                }
            </div>
        </nav>
                }
    </div>
    @if (Model.Subjects.Count > 0)
    {
        <section class="class-form-card mt-4">
            <h2 class="h5 mb-3">Progress by Subject</h2><p class="assessment-note">Each assessment percentage has equal weight. Unsubmitted work and unreleased grades are excluded.</p><div class="assessment-subjects">
                @foreach (var subject in Model.Subjects)
                {
                    <div><strong>@subject.Subject</strong><span>@subject.Average.ToString("0.##")% · @subject.Completed graded</span><progress value="@subject.Average.ToString(System.Globalization.CultureInfo.InvariantCulture)" max="100" aria-label="@($"{subject.Subject} average percentage")"></progress></div>
                }
            </div>
        </section>
    }
</div>
