@model SecureSmartTuitionSystem.ViewModels.Learning.AssessmentProgressModel
@{
    var heading = Model.IsParent ? "Child Results & Learning Progress" : Model.IsStaff ? "Assessment Results Overview" : "My Learning Progress";
    ViewData["Title"] = heading;
    bool advanced = Model.Filter.SubjectId.HasValue || Model.Filter.Kind.HasValue || !string.IsNullOrEmpty(Model.Filter.Month);
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learning-materials.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/assessments.css" asp-append-version="true" />
}
<div class="assessment-page learning-materials-page assessment-progress-page @(!Model.IsStaff ? "student-material-page" : "")">
    <div class="page-header">
        <div><h1>@heading</h1><p>Review assessment results and released grades.</p></div>
        @if (!Model.IsParent)
        {
            <a asp-action="Index" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Assessments</a>
        }
    </div>
    <div class="class-filter-card">
        <div class="class-filter-heading"><h2><i class="bi bi-funnel" aria-hidden="true"></i> Filter Results</h2></div>
        <form id="assessment-progress-filter" asp-action="Progress" method="get" data-assessment-filter>
            <div class="progress-main-filters">
                <div>
                    <label for="progress-class" class="form-label">Class</label>
                    <select id="progress-class" name="ClassId" class="form-select">
                        <option value="">All Available Classes</option>
                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.Value" selected="@(Model.Filter.ClassId?.ToString() == item.Value)">@item.Text</option>
                        }
                    </select>
                </div>
                @if (Model.IsParent || Model.IsStaff)
                {
                    <div>
                        <label for="progress-student" class="form-label">@(Model.IsParent ? "Child" : "Student")</label>
                        <select id="progress-student" name="StudentId" class="form-select">
                            @if (Model.IsStaff)
                            {
                                <option value="">All Available Students</option>
                            }
                            @foreach (var item in Model.Students)
                            {
                                <option value="@item.Value" selected="@(Model.Filter.StudentId?.ToString() == item.Value)">@item.Text</option>
                            }
                        </select>
                    </div>
                }
                <div>
                    <label for="progress-search" class="form-label">Assessment title</label>
                    <input id="progress-search" name="Search" value="@Model.Filter.Search" placeholder="Search assessments" class="form-control" maxlength="100" />
                </div>
            </div>
            <details class="progress-more-filters" open="@advanced">
                <summary>More filters</summary>
                <div class="progress-main-filters">
                    <div>
                        <label for="progress-subject" class="form-label">Subject</label>
                        <select id="progress-subject" name="SubjectId" class="form-select">
                            <option value="">All Subjects</option>
                            @foreach (var item in Model.SubjectChoices)
                            {
                                <option value="@item.Value" selected="@(Model.Filter.SubjectId?.ToString() == item.Value)">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="progress-kind" class="form-label">Type</label>
                        <select id="progress-kind" name="Kind" class="form-select">
                            <option value="">All Types</option>
                            @foreach (var kind in Enum.GetValues<SecureSmartTuitionSystem.Models.Learning.AssessmentKind>())
                            {
                                <option value="@((int)kind)" selected="@(Model.Filter.Kind == kind)">@kind</option>
                            }
                        </select>
                    </div>
                    <div><label for="progress-month" class="form-label">Due Month</label><input id="progress-month" name="Month" type="month" value="@Model.Filter.Month" class="form-control" min="2000-01" max="2100-12" /></div>
                </div>
            </details>
            <noscript><button type="submit" class="primary-button mt-3">View Results</button></noscript>
        </form>
    </div>
    <partial name="_ProgressResults" model="Model" />
    <p class="assessment-refresh" data-assessment-refresh role="status">Updates automatically while visible.</p>
</div>
@section Scripts {
    <script src="~/js/assessments.js" asp-append-version="true"></script>
}
