@model SecureSmartTuitionSystem.ViewModels.Attendance.AttendanceReportViewModel
@using SecureSmartTuitionSystem.Models.Attendance
@{
    bool staffList = !Model.IsPrint && (User.IsInRole("Admin") || User.IsInRole("Tutor")); int recordNumber = 0;
}
<div id="attendance-report-results" class="@(staffList ? "dashboard-card compact-class-card attendance-unified-results" : "class-form-card")" data-report-results data-report-total="@Model.Total">
    @if (staffList)
    {
        <div class="dashboard-card-header attendance-record-header">
            <h2><i class="bi bi-list-check me-2" aria-hidden="true"></i> Attendance Records</h2>
            <div class="attendance-header-actions">
                <span class="text-muted">@Model.Total record(s)</span>

            </div>
        </div>
    }
    else
    {

        <h2 class="h5">Attendance Records (@Model.Total)</h2>
    }
    <div class="@(staffList ? "attendance-result-summary" : "")">
        <p class="text-muted">@Model.Filter.From.ToString("dd MMM yyyy") – @Model.Filter.To.ToString("dd MMM yyyy") · MYT (UTC+8). @(User.IsInRole("Student") || User.IsInRole("Parent") ? "Only submitted attendance is published. Unsubmitted lessons are pending; unrecorded attendance is not absence." : "Submitted and ended draft records; drafts are not published to students or parents.")</p>
        @if (!Model.IsPrint && Model.Total > Model.Rows.Count)
        {
            <p class="text-muted">Previewing @Model.Rows.Count records. Excel and the print view include all matching records, up to 5,000. Narrow the filters for larger reports.</p>
        }
        @if (Model.ExportLimitExceeded)
        {
            <div class="alert alert-warning">More than 5,000 records match. Narrow the date range or class before exporting or printing.</div>
        }
    </div>
    @if (Model.Total == 0)
    {
        <div class="alert alert-info">No published attendance records match these filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle @(staffList ? "compact-class-table" : "")" data-server-paged="@(Model.IsPrint ? "true" : "false")">
                <thead>
                    <tr>
                        @if (staffList)
                        {
                            <th scope="col" class="number-column column-number">No.</th>
                        }
                        <th scope="col" aria-sort='@(Model.Filter.Sort == "date_asc" ? "ascending" : Model.Filter.Sort == "date_desc" ? "descending" : "none")'>@if (Model.IsPrint) { <span>Date / Time</span> } else { <a class="attendance-sort-link" asp-action="Report" asp-route-From="@Model.Filter.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.Filter.To.ToString("yyyy-MM-dd")" asp-route-ClassId="@Model.Filter.ClassId" asp-route-StudentId="@Model.Filter.StudentId" asp-route-Status="@Model.Filter.Status" asp-route-sort='@(Model.Filter.Sort == "date_asc" ? "date_desc" : "date_asc")'>Date / Time <i class='bi @(Model.Filter.Sort == "date_asc" ? "bi-arrow-up" : Model.Filter.Sort == "date_desc" ? "bi-arrow-down" : "bi-arrow-down-up")' aria-hidden="true"></i></a> }</th>
                        <th scope="col" aria-sort='@(Model.Filter.Sort == "class_asc" ? "ascending" : Model.Filter.Sort == "class_desc" ? "descending" : "none")'>@if (Model.IsPrint) { <span>Class / Tutor</span> } else { <a class="attendance-sort-link" asp-action="Report" asp-route-From="@Model.Filter.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.Filter.To.ToString("yyyy-MM-dd")" asp-route-ClassId="@Model.Filter.ClassId" asp-route-StudentId="@Model.Filter.StudentId" asp-route-Status="@Model.Filter.Status" asp-route-sort='@(Model.Filter.Sort == "class_asc" ? "class_desc" : "class_asc")'>Class / Tutor <i class='bi @(Model.Filter.Sort == "class_asc" ? "bi-arrow-up" : Model.Filter.Sort == "class_desc" ? "bi-arrow-down" : "bi-arrow-down-up")' aria-hidden="true"></i></a> }</th>
                        <th scope="col" aria-sort='@(Model.Filter.Sort == "student_asc" ? "ascending" : Model.Filter.Sort == "student_desc" ? "descending" : "none")'>@if (Model.IsPrint) { <span>Student</span> } else { @if (!User.IsInRole("Student") || User.IsInRole("Admin") || User.IsInRole("Tutor")) { <a class="attendance-sort-link" asp-action="Report" asp-route-From="@Model.Filter.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.Filter.To.ToString("yyyy-MM-dd")" asp-route-ClassId="@Model.Filter.ClassId" asp-route-StudentId="@Model.Filter.StudentId" asp-route-Status="@Model.Filter.Status" asp-route-sort='@(Model.Filter.Sort == "student_asc" ? "student_desc" : "student_asc")'>Student <i class='bi @(Model.Filter.Sort == "student_asc" ? "bi-arrow-up" : Model.Filter.Sort == "student_desc" ? "bi-arrow-down" : "bi-arrow-down-up")' aria-hidden="true"></i></a> } else { <span>Student</span> } }</th>
                        <th scope="col" aria-sort='@(Model.Filter.Sort == "status_asc" ? "ascending" : Model.Filter.Sort == "status_desc" ? "descending" : "none")'>@if (Model.IsPrint) { <span>Status</span> } else { <a class="attendance-sort-link" asp-action="Report" asp-route-From="@Model.Filter.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.Filter.To.ToString("yyyy-MM-dd")" asp-route-ClassId="@Model.Filter.ClassId" asp-route-StudentId="@Model.Filter.StudentId" asp-route-Status="@Model.Filter.Status" asp-route-sort='@(Model.Filter.Sort == "status_asc" ? "status_desc" : "status_asc")'>Status <i class='bi @(Model.Filter.Sort == "status_asc" ? "bi-arrow-up" : Model.Filter.Sort == "status_desc" ? "bi-arrow-down" : "bi-arrow-down-up")' aria-hidden="true"></i></a> }</th>
                        <th scope="col">Remark</th>@if (Model.CanCorrect && !Model.IsPrint) {
                        <th scope="col">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    recordNumber++;
                    <tr>
                        @if (staffList)
                        {
                            <td class="number-column">@recordNumber</td>
                        }
                        <td>@if (row.SubmittedLate) { <span class="tutor-management-badge tutor-badge-pending">Late submission</span><br /> }@row.Date.ToString("dd MMM yyyy")<br /><small>@row.Start.ToString("HH:mm")–@row.End.ToString("HH:mm")<br />@(row.Replacement ? "Replacement" : "Regular")</small></td>
                        <td>
                            <strong>@row.ClassCode</strong><br />@row.Tutor<br />@if (row.ScheduleChanged) {
                            <small class="text-danger">Schedule changed · check before reporting totals</small>
                        }
                    </td>
                    <td><strong>@row.StudentName</strong><br /><small>@row.StudentNumber</small></td>
                    <td><span class="tutor-management-badge @(row.Status == AttendanceStatus.Present ? "tutor-badge-success" : row.Status == AttendanceStatus.Absent ? "tutor-badge-inactive" : "tutor-badge-pending")">@(row.Status?.ToString() ?? "Unrecorded")</span></td>
                    <td>@(row.Remark ?? "—")</td>
                    @if (Model.CanCorrect && !Model.IsPrint)
                    {
                        <td>
                            @if (row.CanRequest)
                            {
                                <a asp-controller="AttendanceCorrections" asp-action="Create" asp-route-recordId="@row.RecordId" class="btn btn-sm btn-outline-secondary class-details-button">Request Correction</a>
                            }
                        </td>
                    }
                </tr>
                                }
            </tbody>
        </table>
    </div>
        }
</div>