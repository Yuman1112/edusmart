@model SecureSmartTuitionSystem.ViewModels.Tutor.TutorAvailabilityViewModel
@using SecureSmartTuitionSystem.Services.Tutor
@{
    ViewData["Title"] = "Edit Availability";
    int[] days = { 1, 2, 3, 4, 5, 6 };
    var selected = Model.SelectedSlots.ToHashSet();
    var initialRanges = new List<(int Day, int Start, int End)>();
    foreach (var day in days)
    {
        var slots = selected.Where(value => value / 48 == day && TutorAvailabilityPolicy.IsOpen(value))
            .Select(value => value % 48).OrderBy(slot => slot).ToArray();
        for (int i = 0; i < slots.Length; i++)
        {
            int first = slots[i];
            int last = first;
            while (i + 1 < slots.Length && slots[i + 1] == last + 1) last = slots[++i];
            initialRanges.Add((day, first, last + 1));
        }
    }
    string SlotTime(int slot) => new TimeOnly(slot / 2, slot % 2 * 30).ToString("HH:mm");
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-availability.css" asp-append-version="true" />
    <noscript>
        <style nonce="@Context.Items["CspNonce"]">
            #availability-range-editor, #saveTutorAvailability { display: none !important; }
            [data-availability-grid-fallback][hidden] { display: block !important; }
        </style>
    </noscript>
    <script src="~/js/tutor-availability-ranges.js" asp-append-version="true" defer></script>
    <script src="~/js/tutor-availability.js" asp-append-version="true" defer></script>
    <script src="~/js/tutor-availability-live.js" asp-append-version="true" defer></script>
}
<div class="page-header">
    <div><h1>Edit Availability</h1><p>@(Model.EmploymentType == SecureSmartTuitionSystem.Models.Tutor.TutorEmploymentType.FullTime ? "Full-time" : "Part-time") · update your regular weekly teaching availability.</p></div>
    <a asp-controller="TutorAvailability" asp-action="Index" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</a>
</div>
<div class="class-form-card tutor-create-card tutor-availability">
    <form id="tutor-availability-form"
          asp-action="Index"
          method="post"
          data-stale="@(ViewData["AvailabilityStale"] is true ? "true" : "false")"
          data-live-url="@Url.Action("Index", new { partial = true, template = true })"
          data-save-failed="@(ViewData["AvailabilitySaveFailed"] is true ? "true" : "false")"
    >
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Version" />
        <div class="alert alert-warning @(ViewData["AvailabilityStale"] is true ? "" : "d-none")" data-availability-stale-notice role="alert">Saved availability has changed in another page. Your unsaved selections are kept. <a asp-action="Edit" class="alert-link">Reload latest availability</a> before saving.</div>
        <p class="form-text d-none" data-availability-live-status role="status" aria-live="polite"></p>
        <div class="alert d-none" data-availability-save-result role="status" aria-live="polite"></div>
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger availability-validation-summary"
             role="alert">
        </div>
        <section class="class-form-section">
            <h2><i class="bi bi-calendar-week" aria-hidden="true"></i> Weekly Teaching Availability</h2>
            <div class="tutor-info-note mb-4">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Monday–Saturday · 08:00–22:00 MYT · Maximum 8 hours per day and 45 hours per week. Leave meal and rest times out. This pattern repeats every week.</span>
            </div>
            @if (Model.LegacySlots.Count > 0)
            {
                <div class="alert alert-warning">
                    <p>Older availability outside the current centre hours is still stored. Review it before removing:</p>
                    <ul>
                        @foreach (var day in Enumerable.Range(0, 7))
                        {
                            var text = TutorAvailabilityService.DescribeDay(Model.LegacySlots, day);
                            if (text != "Not available")
                            {
                                <li>@((DayOfWeek)day): @text</li>
                            }
                        }
                    </ul>
                    <label><input asp-for="RemoveLegacySlots" class="form-check-input me-2" /> Remove these legacy slots when saving. Existing classes will not be cancelled automatically.</label>
                    <span asp-validation-for="RemoveLegacySlots" class="text-danger"></span>
                </div>
            }
            <div id="availability-range-editor">
                <p class="form-text" data-range-preparing role="status">Preparing editing controls… <a asp-action="Edit">Reload</a> if they do not become available.</p>
                <fieldset data-range-controls disabled class="border-0 p-0 m-0 w-100">
                <div class="availability-range-heading"><h3>Add Available Time</h3><strong data-range-total aria-live="polite">@(initialRanges.Sum(range => range.End - range.Start) / 2d) / 45 h per week</strong></div>
                <fieldset class="availability-range-days">
                    <legend>Days</legend>
                    @foreach (var day in days)
                    {
                        <label><input type="checkbox" value="@day" data-range-day /><span>@(((DayOfWeek)day).ToString().Substring(0, 3))</span></label>
                    }
                </fieldset>
                <div class="availability-range-inputs">
                    <label>Start Time<select class="form-select" data-range-start>
                        @for (int slot = 16; slot < 44; slot++)
                        {
                            <option value="@slot" selected="@(slot == 38)">@(new TimeOnly(slot / 2, slot % 2 * 30).ToString("HH:mm"))</option>
                        }
                    </select></label>
                    <label>End Time<select class="form-select" data-range-end>
                        @for (int slot = 17; slot <= 44; slot++)
                        {
                            <option value="@slot" selected="@(slot == 42)">@(new TimeOnly(slot / 2, slot % 2 * 30).ToString("HH:mm"))</option>
                        }
                    </select></label>
                    <button type="button" class="outline-button" data-range-add>+ Add Time</button>
                    <button type="button" class="outline-button" data-range-cancel hidden>Cancel Edit</button>
                </div>
                <p data-range-message role="status" aria-live="polite" hidden></p>
                <div class="availability-range-heading availability-range-list-heading"><h3>Your Weekly Availability</h3><span class="form-text">Changes take effect after saving.</span></div>
                <div data-range-list aria-label="Selected weekly availability">
                    @if (initialRanges.Count == 0)
                    {
                        <p class="availability-range-empty">No available times added. Choose days and a time above to get started.</p>
                    }
                    @foreach (var range in initialRanges)
                    {
                        <div class="availability-range-row">
                            <strong>@((DayOfWeek)range.Day)</strong>
                            <span>@SlotTime(range.Start)–@SlotTime(range.End)</span>
                            <span>@((range.End - range.Start) / 2d) h</span>
                            <div class="availability-range-actions">
                                <button type="button" class="outline-button">Edit</button>
                                <button type="button" class="outline-button">Remove</button>
                            </div>
                        </div>
                    }
                </div>
                </fieldset>
            </div>
            <div data-availability-grid-fallback hidden>
            <div id="availability-day-totals" class="availability-day-totals" role="status" aria-live="polite"></div>
            <p id="availability-limit-message" class="text-danger" role="alert" hidden></p>
            <p id="availability-help">Tick available slots; untick to remove. This pattern repeats every week.</p>
            <div class="availability-scroll" tabindex="0" role="region" aria-label="Weekly availability timetable">
                <table data-pagination="off" class="availability-table" aria-describedby="availability-help">
                    <caption class="visually-hidden">Weekly teaching availability in 30-minute intervals</caption>
                    <thead>
                        <tr>
                            <th scope="col" data-sortable="false">Time</th>@foreach (var day in days) {
                            <th scope="col" data-sortable="false">@((DayOfWeek)day)</th>
                                                        }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int slot = TutorAvailabilityPolicy.FirstSlot; slot < TutorAvailabilityPolicy.EndSlot; slot++)
                        {
                            var start = new TimeOnly(slot / 2, slot % 2 * 30).ToString("HH:mm");
                            var end = new TimeOnly((slot + 1) / 2, (slot + 1) % 2 * 30).ToString("HH:mm");
                            <tr data-slot="@slot">
                                <th scope="row">@start–@end</th>
                                @foreach (var day in days)
                                {
                                    var value = day * 48 + slot;
                                    <td><label class="availability-cell"><input type="checkbox" name="SelectedSlots" value="@value" checked="@selected.Contains(value)" aria-label="@($"{(DayOfWeek)day} {start} to {end}")" /></label></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        </section>
        <div class="class-form-actions">
            <a asp-controller="TutorAvailability" asp-action="Index" class="outline-button">Cancel</a>
            <noscript><button type="submit" class="primary-button">Save Availability</button></noscript>
            <button id="saveTutorAvailability" type="submit" class="primary-button" disabled><i class="bi bi-check-lg" aria-hidden="true"></i> Save Availability</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
