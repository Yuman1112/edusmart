@model SecureSmartTuitionSystem.ViewModels.Tutor.EditOwnTutorProfileViewModel
@{
    ViewData["Title"] = "Edit My Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-form.css" asp-append-version="true" />
}

<div class="page-header">
    <div><h1>Edit My Profile</h1><p>Update your personal information and contact details.</p></div>
    <a asp-controller="Tutor" asp-action="MyProfile" class="outline-button">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
    </a>
</div>

<div class="class-form-card tutor-create-card">
    <form id="edit-tutor-form" asp-controller="Tutor" asp-action="EditProfile" method="post" data-personal-only="true"
          data-has-errors="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <section class="class-form-section">
            <h2><i class="bi bi-person-vcard" aria-hidden="true"></i> Personal Information</h2>
            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <label asp-for="TutorId" class="form-label">Tutor ID</label>
                    <input asp-for="TutorId" class="form-control tutor-readonly-field" readonly aria-readonly="true" />
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" maxlength="100" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           maxlength="254"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>
                
                <div class="col-12 col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" type="tel" class="form-control" maxlength="12" autocomplete="tel" placeholder="012-3456789" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="tutor-info-note mt-4">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Your Tutor ID cannot be changed. A new email address must be verified before it replaces your current email.</span>
            </div>
        </section>

        <section class="class-form-section">
            <h2><i class="bi bi-mortarboard" aria-hidden="true"></i> Teaching Information</h2>
            <p class="tutor-section-description">The administrator manages your qualifications and teaching approvals.</p>
            <a asp-controller="TeachingRequests" asp-action="Mine" class="outline-button">
                <i class="bi bi-clipboard-plus" aria-hidden="true"></i> Request Teaching Change
            </a>
        </section>


        <div class="class-form-actions">
            <a asp-controller="Tutor" asp-action="MyProfile" class="outline-button">Cancel</a>
            <button type="submit" id="saveTutorChanges" class="primary-button" disabled>
                <i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tutor-edit.js" asp-append-version="true"></script>
}
