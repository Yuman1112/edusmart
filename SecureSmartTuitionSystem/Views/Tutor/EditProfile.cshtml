@model SecureSmartTuitionSystem.ViewModels.Tutor.EditOwnTutorProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-profile.css" asp-append-version="true" />
}
<div class="account-profile-page tutor-profile-layout" data-qualification-live-url="@Url.Action("Live", "QualificationRequests")">
    <div class="page-header">
        <div><h1>Edit Profile</h1><p>Update your information and manage documents.</p></div>
        <div class="class-detail-header-actions">
            <a asp-controller="Tutor" asp-action="MyProfile" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</a>
        </div>
    </div>
    <div class="class-details-card">
        <div class="class-details-title"><h2>@Model.TutorId - @Model.FullName</h2><span class="profile-role">Tutor</span></div>
        <form id="edit-tutor-form" data-profile-edit-form asp-controller="Tutor" asp-action="EditProfile" method="post" enctype="multipart/form-data" data-personal-only="true"
              data-has-errors="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())" novalidate>
            @Html.AntiForgeryToken()
            @* Keep the existing client validation/change detection contract. The controller reloads identity fields from the signed-in account. *@
            <input asp-for="TutorId" type="hidden" />
            <input asp-for="Email" type="hidden" />
        <section class="class-details-section">
            <h3><i class="bi bi-person-badge" aria-hidden="true"></i> Account Information</h3>
            <div class="class-details-grid">
                <div class="class-detail-item"><span>User ID</span><strong>@Model.TutorId</strong></div>
                <div class="class-detail-item"><span>Role</span><strong>Tutor</strong></div>
                <div class="class-detail-item profile-email-row">
                    <div><span>Email Address</span><strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "Not provided" : Model.Email)</strong></div>
                    <a asp-controller="AccountEmail" asp-action="Index" class="outline-button profile-email-link" data-profile-email-link>@(string.IsNullOrWhiteSpace(Model.Email) ? "Add Email" : "Change Email")</a>
                </div>
            </div>
        </section>
            <section class="class-details-section">
                <h3 class="profile-personal-heading"><i class="bi bi-person-vcard" aria-hidden="true"></i> Personal Information <span class="profile-unsaved-note" data-profile-unsaved hidden>Unsaved changes</span></h3>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="profile-edit-grid">
                    <div class="profile-field">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" maxlength="100" autocomplete="name" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="profile-field">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" maxlength="12" autocomplete="tel" placeholder="012-3456789" pattern="01[0-9]-[0-9]{7,8}" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
            </section>
            <section class="class-details-section">
                <h3><i class="bi bi-journal-text" aria-hidden="true"></i> Teaching Experience</h3>
                <label asp-for="TeachingExperience" class="visually-hidden"></label>
                <textarea asp-for="TeachingExperience" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="TeachingExperience" class="text-danger"></span>
            </section>
            <section class="class-details-section">
                <h3><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Supporting Documents</h3>
                <div class="profile-resume-field">
                    <p class="profile-file-label">Resume</p>
                    @{ var resume = Model.Documents.FirstOrDefault(d => d.Kind == SecureSmartTuitionSystem.Models.Tutor.TutorDocumentKind.Resume); }
                    <div class="profile-file-card" data-qualification-document="2" data-document-url="@Url.Action("ProfileDocument", "Tutor")">
                        <span class="profile-file-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
                        <div class="profile-file-copy"><strong data-qualification-file-name>@(resume?.FileName ?? "Not uploaded")</strong></div>
                        <a asp-action="ProfileDocument" asp-route-id="@(resume?.Id ?? 0)" class="outline-button @(resume == null ? "d-none" : "")" data-qualification-file-link>View</a>
                        <span class="profile-verification-badge @(resume == null ? "" : "d-none")" data-qualification-no-file>No file</span>
                    </div>
                    <label asp-for="Resume" class="form-label mt-3">Upload / Replace Resume</label>
                    <input asp-for="Resume" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg" aria-describedby="resume-upload-help" />
                    <span asp-validation-for="Resume" class="text-danger"></span>
                    <small id="resume-upload-help" class="profile-field-help">PDF, PNG or JPG · Maximum 10 MB. Saved with your profile.</small>
                </div>
                <div class="class-form-actions">
                    <a asp-controller="Tutor" asp-action="MyProfile" class="outline-button">Cancel</a>
                    <button type="submit" id="saveTutorChanges" class="primary-button" disabled>Save Changes</button>
                </div>

            </section>
        </form>
    </div>
    <div class="class-details-card profile-teaching-card">
        <section class="class-details-section">
            <div class="profile-section-heading"><h3><i class="bi bi-mortarboard" aria-hidden="true"></i> Teaching Information</h3><span data-qualification-verified class="profile-verification-badge @(Model.QualificationVerifiedAtUtc.HasValue ? "is-verified" : "")">@(Model.QualificationVerifiedAtUtc.HasValue ? "Verified" : "Not verified")</span></div>
            <div class="class-details-grid profile-qualification-fields">
                <div class="class-detail-item"><span>Highest Qualification</span><strong data-qualification-field="qualification">@Model.Qualification</strong></div>
                <div class="class-detail-item"><span>Field of Study</span><strong data-qualification-field="fieldOfStudy">@(string.IsNullOrWhiteSpace(Model.FieldOfStudy) ? "Not provided" : Model.FieldOfStudy)</strong></div>
            </div>
            <div class="profile-request-action-row">
                <div><h4>Qualification details</h4><p>Submit updated qualifications and supporting certificates.</p></div>
                <a asp-controller="QualificationRequests" asp-action="Mine" class="outline-button" data-profile-destination="qualification">Request Qualification Update</a>
            </div>
            <div class="profile-request-action-row">
                <div><h4>Approved subjects &amp; levels</h4><p>Request additional teaching subjects or levels.</p></div>
                <a asp-controller="TeachingRequests" asp-action="Mine" class="outline-button" data-profile-destination="teaching">Request Teaching Change</a>
            </div>
        </section>
        <div class="profile-pending-note @(Model.PendingQualification == null ? "d-none" : "")" role="status" data-qualification-pending-note><strong>Pending review:</strong> <span data-qualification-pending-copy>@Model.PendingQualification?.Qualification · @Model.PendingQualification?.FieldOfStudy</span>. Current approved details remain active. <a asp-controller="QualificationRequests" asp-action="Mine" data-profile-destination="qualification">View Request</a></div>
    </div>
</div>
<partial name="_ProfileEmailPrompt" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tutor-edit.js" asp-append-version="true"></script>
    <script src="~/js/profile-email-navigation.js" asp-append-version="true"></script>
    <script src="~/js/qualification-live.js" asp-append-version="true"></script>
}
