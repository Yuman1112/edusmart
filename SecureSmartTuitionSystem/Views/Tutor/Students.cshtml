@model SecureSmartTuitionSystem.ViewModels.Tutor.TutorStudentRoster
@{
    ViewData["Title"] = "My Students";
}
@section Styles {
    <link rel="stylesheet" href="~/css/class-sessions.css" asp-append-version="true" />
}
<div class="page-header">
    <div><h1>My Students</h1><p>View current students in your assigned classes.</p></div>
    <a asp-action="Index" class="outline-button"><i class="bi bi-arrow-left" aria-hidden="true"></i> Dashboard</a>
</div>
<div class="class-form-card mb-4">
    <form asp-action="Students" method="get" class="row g-3 align-items-end">
        <div class="col-md-7">
            <label for="roster-class" class="form-label">Class</label>
            <select id="roster-class" name="classId" class="form-select">
                <option value="">All My Classes</option>
                @foreach (var choice in Model.Classes)
                {
                    <option value="@choice.Id" selected="@(Model.ClassId == choice.Id)">@choice.Code · @choice.Name</option>
                }
            </select>
        </div>
        <div class="col-md-5"><button type="submit" class="primary-button">View Students</button></div>
    </form>
</div>
<div class="class-form-card">
    <h2 class="h5">Student Roster</h2>
    @if (Model.Students.Count == 0)
    {
        <p class="text-muted">No students are currently enrolled in these classes.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Student ID</th><th scope="col">Student Name</th><th scope="col">Class</th></tr></thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr><td>@student.Number</td><td>@student.Name</td><td>@student.ClassCode · @student.ClassName</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
