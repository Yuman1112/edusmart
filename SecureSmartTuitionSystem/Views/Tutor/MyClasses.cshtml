@model SecureSmartTuitionSystem.ViewModels.Tutor.TutorMyClassesViewModel

@using SecureSmartTuitionSystem.Models.Enrollment

@{
    ViewData["Title"] = "My Classes";

    DayOfWeek[] orderedDays =
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/tutor.css"
          asp-append-version="true" />
}


<div class="page-header">
    <div>
        <h1>My Classes</h1>

        <p>
            View your assigned online tuition classes.
        </p>
    </div>

    <a asp-controller="Tutor"
       asp-action="Index"
       class="outline-button">

        <i class="bi bi-arrow-left"></i>
        Dashboard
    </a>
</div>


<section class="dashboard-grid tutor-class-summary">

    <article class="metric-card">
        <span class="metric-icon blue">
            <i class="bi bi-journal-bookmark-fill"></i>
        </span>

        <div class="metric-content">
            <span>Total Classes</span>
            <strong>@Model.TotalClassCount</strong>
            <small>All assigned classes</small>
        </div>
    </article>

    <article class="metric-card">
        <span class="metric-icon green">
            <i class="bi bi-check-circle-fill"></i>
        </span>

        <div class="metric-content">
            <span>Active Classes</span>
            <strong>@Model.ActiveClassCount</strong>
            <small>Currently available</small>
        </div>
    </article>

    <article class="metric-card">
        <span class="metric-icon orange">
            <i class="bi bi-calendar-check-fill"></i>
        </span>

        <div class="metric-content">
            <span>Classes Today</span>
            <strong>@Model.TodayClassCount</strong>
            <small>Today's active classes</small>
        </div>
    </article>

</section>


<form asp-controller="Tutor"
      asp-action="MyClasses"
      method="get"
      id="tutorClassFilterForm"
      class="tutor-class-filter-card">

    <div class="tutor-filter-heading">
        <div>
            <h2>
                <i class="bi bi-funnel"></i>
                Filter Classes
            </h2>

            <p>
                The class list updates automatically.
            </p>
        </div>

        @if (Model.HasFilters)
        {
            <a asp-controller="Tutor"
               asp-action="MyClasses"
               class="clear-filter-link">

                <i class="bi bi-x-circle"></i>
                Clear Filters
            </a>
        }
    </div>


    <div class="tutor-filter-grid">

        <div>
            <label asp-for="SubjectName"
                   class="form-label">
                Subject
            </label>

            <select asp-for="SubjectName"
                    class="form-select tutor-auto-filter">

                <option value="">
                    All Subjects
                </option>

                @foreach (var subject in Model.SubjectOptions)
                {
                    <option value="@subject">
                        @subject
                    </option>
                }
            </select>
        </div>


        <div>
            <label asp-for="DayOfWeek"
                   class="form-label">
                Class Day
            </label>

            <select asp-for="DayOfWeek"
                    class="form-select tutor-auto-filter">

                <option value="">
                    All Days
                </option>

                @foreach (var day in orderedDays)
                {
                    <option value="@day">
                        @day
                    </option>
                }
            </select>
        </div>


        <div>
            <label asp-for="Status"
                   class="form-label">
                Status
            </label>

            <select asp-for="Status"
                    class="form-select tutor-auto-filter">

                <option value="">
                    All Statuses
                </option>

                @foreach (var classStatus
                                in Enum.GetValues<ClassSessionStatus>())
                {
                    <option value="@classStatus">
                        @classStatus
                    </option>
                }
            </select>
        </div>

    </div>
</form>


@if (Model.Classes.Count == 0)
{
    <section class="dashboard-card tutor-empty-card">

        <div class="empty-state">

            <i class="bi bi-calendar-x"></i>

            @if (Model.HasFilters)
            {
                <p>
                    No assigned classes match the selected filters.
                </p>

                <a asp-controller="Tutor"
                   asp-action="MyClasses"
                   class="outline-button">

                    Clear Filters
                </a>
            }
            else
            {
                <p>
                    No classes are currently assigned to you.
                </p>
            }

        </div>

    </section>
}
else
{
    <section class="tutor-classes-grid">

        @foreach (var item in Model.Classes)
        {
            <article class="tutor-class-card">

                <header class="tutor-class-card-header">

                    <div class="tutor-class-title">

                        <span class="class-code">
                            @item.ClassCode
                        </span>

                        <h2>
                            @item.ClassName
                        </h2>

                    </div>


                    @if (item.Status ==
                                ClassSessionStatus.Active)
                    {
                        <span class="status-pill status-success">
                            Active
                        </span>
                    }
                    else if (item.Status ==
                    ClassSessionStatus.Cancelled)
                    {
                        <span class="status-pill status-danger">
                            Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="status-pill status-warning">
                            Completed
                        </span>
                    }

                </header>


                <div class="tutor-class-card-body">

                    <div class="tutor-class-detail">

                        <i class="bi bi-mortarboard-fill"></i>

                        <div>
                            <span>Education Level</span>

                            <strong>
                                @item.EducationStage ·
                                @item.AcademicLevel
                            </strong>
                        </div>

                    </div>


                    <div class="tutor-class-detail">

                        <i class="bi bi-book-fill"></i>

                        <div>
                            <span>Subject</span>

                            <strong>
                                @item.SubjectName
                            </strong>
                        </div>

                    </div>


                    <div class="tutor-class-detail">

                        <i class="bi bi-calendar3"></i>

                        <div>
                            <span>Class Day</span>

                            <strong>
                                @item.Day
                            </strong>
                        </div>

                    </div>


                    <div class="tutor-class-detail">

                        <i class="bi bi-clock-fill"></i>

                        <div>
                            <span>Class Time</span>

                            <strong>
                                @item.StartTime –
                                @item.EndTime
                            </strong>
                        </div>

                    </div>


                    <div class="tutor-class-detail">

                        <i class="bi bi-people-fill"></i>

                        <div>
                            <span>Students</span>

                            <strong>
                                @item.StudentCount /
                                @item.Capacity
                            </strong>
                        </div>

                    </div>

                </div>


                <footer class="tutor-class-card-footer">

                    <a asp-controller="Tutor"
                       asp-action="ClassDetails"
                       asp-route-id="@item.ClassSessionId"
                       class="outline-button">

                        <i class="bi bi-eye"></i>
                        Details
                    </a>


                    @if (item.Status ==
                                ClassSessionStatus.Active)
                    {
                        <a href="@item.GoogleMeetLink"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="primary-button">

                            <i class="bi bi-camera-video-fill"></i>
                            Join Google Meet
                        </a>
                    }

                </footer>

            </article>
        }

    </section>
}


@section Scripts {
    <script nonce="@Context.Items["CspNonce"]">
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const filterForm =
                    document.getElementById(
                        "tutorClassFilterForm"
                    );

                if (!filterForm) {
                    return;
                }

                document
                    .querySelectorAll(
                        ".tutor-auto-filter"
                    )
                    .forEach(function (filter) {

                        filter.addEventListener(
                            "change",
                            function () {
                                filterForm.requestSubmit();
                            }
                        );
                    });
            }
        );
    </script>
}